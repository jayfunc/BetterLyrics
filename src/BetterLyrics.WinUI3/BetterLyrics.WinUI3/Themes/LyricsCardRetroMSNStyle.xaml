<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="using:BetterLyrics.WinUI3.Controls">

    <Style x:Key="LyricsCardRetroMSNStyle" TargetType="uc:LyricsCard">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="uc:LyricsCard">
                    <Grid
                        x:Name="MSNCardRoot"
                        Width="450"
                        Height="{TemplateBinding LyricsAreaSize}"
                        MinHeight="600"
                        Background="WhiteSmoke"
                        CornerRadius="8,8,0,0"
                        Tag="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}">

                        <Grid Background="#EBF3FA">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#0058EE" />
                                        <GradientStop Offset="0.1" Color="#3B8BF6" />
                                        <GradientStop Offset="1" Color="#0050DC" />
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Border
                                    BorderBrush="#00309C"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="6,6,0,0" />

                                <StackPanel
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <FontIcon
                                        Margin="0,0,6,0"
                                        FontSize="14"
                                        Foreground="White"
                                        Glyph="&#xE77B;" />
                                    <TextBlock
                                        MaxWidth="200"
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{Binding Artist, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        TextTrimming="CharacterEllipsis">
                                        <TextBlock.Shadow>
                                            <ThemeShadow />
                                        </TextBlock.Shadow>
                                    </TextBlock>
                                    <TextBlock
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="12"
                                        Foreground="#AACCFF"
                                        Text=" - Conversation" />
                                </StackPanel>

                                <StackPanel
                                    Margin="0,0,6,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Border
                                        Width="20"
                                        Height="20"
                                        Background="#3875D7"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBlock
                                            Margin="0,-2,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="-" />
                                    </Border>
                                    <Border
                                        Width="20"
                                        Height="20"
                                        Background="#3875D7"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <Border
                                            Width="12"
                                            Height="12"
                                            Margin="3"
                                            BorderBrush="White"
                                            BorderThickness="1" />
                                    </Border>
                                    <Border
                                        Width="20"
                                        Height="20"
                                        Background="#E64028"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBlock
                                            Margin="0,-2,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="×" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border
                                Grid.Row="1"
                                Background="#EBEADB"
                                BorderBrush="#ACA899"
                                BorderThickness="1,0,1,1">
                                <StackPanel
                                    Margin="10,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <TextBlock
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="11"
                                        Foreground="Black"
                                        Text="File" />
                                    <TextBlock
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="11"
                                        Foreground="Black"
                                        Text="Edit" />
                                    <TextBlock
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="11"
                                        Foreground="Black"
                                        Text="Actions" />
                                    <TextBlock
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="11"
                                        Foreground="Black"
                                        Text="Tools" />
                                    <TextBlock
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="11"
                                        Foreground="Black"
                                        Text="Help" />
                                </StackPanel>
                            </Border>

                            <Grid
                                Grid.Row="2"
                                Background="#EBF3FA"
                                BorderBrush="#ACA899"
                                BorderThickness="1,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="32"
                                    Height="32"
                                    Margin="10,4"
                                    BorderBrush="#8CA0B4"
                                    BorderThickness="1">
                                    <Image Source="{Binding CoverImage, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="11"
                                        Foreground="#444"
                                        Text="To: BetterLyrics User" />
                                    <TextBlock
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="11"
                                        FontStyle="Italic"
                                        Foreground="#888"
                                        Text="&lt;Type a personal message&gt;" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="#444"
                                        Glyph="&#xE714;" />
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="#444"
                                        Glyph="&#xE717;" />
                                </StackPanel>
                            </Grid>

                            <Border
                                Grid.Row="3"
                                Background="#EBF3FA"
                                BorderBrush="#ACA899"
                                BorderThickness="1,0">
                                <Grid Margin="4,0,4,4" Background="White">
                                    <Border BorderBrush="#ACA899" BorderThickness="1">
                                        <Grid>
                                            <Image
                                                Opacity="0.15"
                                                Source="{Binding CoverImage, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                Stretch="UniformToFill" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>

                                                <ScrollViewer Grid.Column="0" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                                    <ItemsControl
                                                        x:Name="PART_LyricsItemsControl"
                                                        Margin="10"
                                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                        ItemsSource="{Binding LyricsLines, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,12">

                                                                    <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                                                                        <TextBlock
                                                                            MaxWidth="260"
                                                                            FontSize="11"
                                                                            FontWeight="Bold"
                                                                            Foreground="#808080"
                                                                            Text="{Binding Tag.Artist, ElementName=MSNCardRoot}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock
                                                                            FontSize="11"
                                                                            Foreground="#808080"
                                                                            Text=" says:" />
                                                                    </StackPanel>

                                                                    <StackPanel Margin="10,0,0,0">

                                                                        <TextBlock
                                                                            FontSize="14"
                                                                            Foreground="#000080"
                                                                            Text="{Binding Text}"
                                                                            TextWrapping="Wrap" />

                                                                        <TextBlock
                                                                            Margin="0,2,0,0"
                                                                            FontSize="12"
                                                                            Foreground="#666666"
                                                                            Text="{Binding SecondaryText}"
                                                                            TextWrapping="Wrap"
                                                                            Visibility="{Binding SecondaryText, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Visible}" />
                                                                    </StackPanel>

                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>

                                                <StackPanel Grid.Column="1" Margin="5">
                                                    <Border
                                                        Width="80"
                                                        Height="80"
                                                        Background="White"
                                                        BorderBrush="#8CA0B4"
                                                        BorderThickness="1">
                                                        <Image Source="{Binding CoverImage, RelativeSource={RelativeSource Mode=TemplatedParent}}" Stretch="UniformToFill" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Row="4"
                                Background="#EBF3FA"
                                BorderBrush="#ACA899"
                                BorderThickness="1,0">
                                <Grid Margin="4,0,4,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Padding="4,2"
                                        Background="#EBF3FA"
                                        BorderBrush="#ACA899"
                                        BorderThickness="1,1,1,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                FontWeight="Bold"
                                                Foreground="Black"
                                                Text="A" />
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="Black"
                                                Glyph="&#xE76E;" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                FontSize="10"
                                                Foreground="Black"
                                                Text="Backgrounds" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                FontSize="10"
                                                Foreground="Black"
                                                Text="Winks" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Grid.Row="1"
                                        Height="60"
                                        Background="White"
                                        BorderBrush="#ACA899"
                                        BorderThickness="1">
                                        <Grid>
                                            <TextBlock
                                                Margin="5"
                                                FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                FontSize="12"
                                                Foreground="#CCC"
                                                Text="BetterLyrics..." />

                                            <Border
                                                Margin="4"
                                                Padding="15,4,15,4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Background="#F0F0F0"
                                                BorderBrush="#888"
                                                BorderThickness="1">
                                                <TextBlock
                                                    FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                    FontSize="11"
                                                    Foreground="Black"
                                                    Text="Send" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Row="5"
                                Padding="6,0"
                                Background="#EBF3FA"
                                BorderBrush="#ACA899"
                                BorderThickness="1">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="10"
                                        Foreground="#666"
                                        Text="Last message received at 12:00 PM." />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>