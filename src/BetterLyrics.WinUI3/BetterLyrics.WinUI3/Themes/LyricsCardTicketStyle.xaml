<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="using:BetterLyrics.WinUI3.Controls">

    <Style x:Key="LyricsCardTicketStyle" TargetType="uc:LyricsCard">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="uc:LyricsCard">
                    <Grid
                        Width="450"
                        Height="{TemplateBinding LyricsAreaSize}"
                        MinHeight="600"
                        Background="WhiteSmoke"
                        CornerRadius="8">
                        <Grid
                            Margin="20"
                            Background="#FFF8F0"
                            CornerRadius="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                BorderBrush="#e6dfd8"
                                BorderThickness="1,1,1,0"
                                CornerRadius="12,12,0,0">
                                <Grid Margin="24,24,24,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4">
                                        <Image
                                            Width="80"
                                            Height="80"
                                            Source="{Binding CoverImage, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                    </Border>
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            CharacterSpacing="2"
                                            FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="#FF5555"
                                            Text="ADMIT ONE" />

                                        <TextBlock
                                            FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                            FontSize="20"
                                            FontWeight="Black"
                                            Foreground="#333"
                                            MaxLines="2"
                                            Text="{Binding Title, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                            FontSize="14"
                                            Foreground="#777"
                                            MaxLines="1"
                                            Text="{Binding Artist, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Row="1"
                                BorderBrush="#e6dfd8"
                                BorderThickness="1,0">
                                <ScrollViewer Margin="0,20,0,0" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ItemsControl
                                        x:Name="PART_LyricsItemsControl"
                                        Margin="24,10,24,30"
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        ItemsSource="{Binding LyricsLines, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,16">

                                                    <TextBlock
                                                        FontSize="18"
                                                        Foreground="#444"
                                                        LineHeight="28"
                                                        Text="{Binding Text}"
                                                        TextWrapping="Wrap" />

                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="14"
                                                        Foreground="#888"
                                                        LineHeight="20"
                                                        Text="{Binding SecondaryText}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{Binding SecondaryText, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Visible}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <Grid Grid.Row="2" Height="20">
                                <Line
                                    Margin="10,0"
                                    VerticalAlignment="Center"
                                    Stroke="#CCC"
                                    StrokeDashArray="8"
                                    StrokeThickness="1"
                                    X1="0"
                                    X2="410"
                                    Y1="3"
                                    Y2="3" />
                                <Border
                                    Width="20"
                                    Height="20"
                                    Margin="-10,0,0,0"
                                    HorizontalAlignment="Left"
                                    BorderBrush="#e6dfd8"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <Ellipse Fill="WhiteSmoke" />
                                </Border>
                                <Border
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,-10,0"
                                    HorizontalAlignment="Right"
                                    BorderBrush="#e6dfd8"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <Ellipse Fill="WhiteSmoke" />
                                </Border>
                            </Grid>

                            <Border
                                Grid.Row="3"
                                BorderBrush="#e6dfd8"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,12,12">
                                <Grid Padding="24,10,24,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                            FontSize="10"
                                            Foreground="#999"
                                            Text="DATE" />
                                        <TextBlock
                                            FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                            FontSize="14"
                                            Foreground="#333"
                                            Text="{Binding DateShort, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                        <TextBlock
                                            Margin="0,8,0,0"
                                            FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                            FontSize="10"
                                            Foreground="#999"
                                            Text="LOCATION" />
                                        <TextBlock
                                            FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                            FontSize="14"
                                            Foreground="#333"
                                            Text="BetterLyrics" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        Opacity="0.8">
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="16"
                                            Foreground="#333"
                                            Text="||| |||| | ||||" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>