<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="using:BetterLyrics.WinUI3.Controls">

    <Style x:Key="LyricsCardWindowsPhoneStyle" TargetType="uc:LyricsCard">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="uc:LyricsCard">
                    <Grid
                        Width="450"
                        Height="{TemplateBinding LyricsAreaSize}"
                        MinHeight="800"
                        Background="Black">
                        <Image
                            Opacity="0.6"
                            Source="{Binding CoverImage, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                            Stretch="UniformToFill" />

                        <Rectangle Height="400" VerticalAlignment="Bottom">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="Transparent" />
                                    <GradientStop Offset="1" Color="#CC000000" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Grid
                            Height="32"
                            Padding="12,6"
                            VerticalAlignment="Top"
                            Background="#33000000">
                            <StackPanel
                                HorizontalAlignment="Left"
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="White"
                                    Glyph="&#xE870;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="5G" />
                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="12">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="White"
                                    Glyph="&#xE701;" />
                                <FontIcon
                                    FontSize="14"
                                    Foreground="White"
                                    Glyph="&#xE83F;" />
                            </StackPanel>
                        </Grid>

                        <Grid
                            Height="100"
                            Margin="0,32,0,0"
                            VerticalAlignment="Top"
                            Background="#1F1F1F">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Image
                                Grid.Column="0"
                                Width="100"
                                Height="100"
                                Source="{Binding CoverImage, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                Stretch="UniformToFill" />

                            <Grid Grid.Column="1" Padding="15,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                    <TextBlock
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="15"
                                        Foreground="White"
                                        Text="{Binding Artist, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="13"
                                        Foreground="#999"
                                        Text="{Binding Title, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="1"
                                    Margin="0,0,0,4"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal"
                                    Spacing="25">
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="#CCC"
                                        Glyph="&#xE892;" />
                                    <FontIcon
                                        FontSize="22"
                                        Foreground="White"
                                        Glyph="&#xE768;" />
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="#CCC"
                                        Glyph="&#xE893;" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid Margin="30,160,30,240" VerticalAlignment="Center">
                            <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                <ItemsControl
                                    x:Name="PART_LyricsItemsControl"
                                    FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                    ItemsSource="{Binding LyricsLines, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,24">

                                                <TextBlock
                                                    FontSize="26"
                                                    Foreground="White"
                                                    LineHeight="34"
                                                    Opacity="1.0"
                                                    Text="{Binding Text}"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap">
                                                    <TextBlock.Shadow>
                                                        <ThemeShadow />
                                                    </TextBlock.Shadow>
                                                </TextBlock>

                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    FontSize="18"
                                                    Foreground="#A6A6A6"
                                                    LineHeight="24"
                                                    Text="{Binding SecondaryText}"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap"
                                                    Visibility="{Binding SecondaryText, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Visible}">
                                                    <TextBlock.Shadow>
                                                        <ThemeShadow />
                                                    </TextBlock.Shadow>
                                                </TextBlock>

                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <StackPanel Margin="24,0,0,40" VerticalAlignment="Bottom">
                            <TextBlock
                                Margin="-4,0,0,-12"
                                FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                FontSize="90"
                                Foreground="White"
                                Text="{Binding TimeShort, RelativeSource={RelativeSource Mode=TemplatedParent}}" />

                            <TextBlock
                                Margin="2,0,0,4"
                                FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                FontSize="22"
                                Foreground="White"
                                Text="{Binding DateLong, RelativeSource={RelativeSource Mode=TemplatedParent}}" />

                            <TextBlock
                                Margin="2,0,0,24"
                                FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                FontSize="16"
                                Foreground="#CCC"
                                Text="BetterLyrics" />

                            <StackPanel
                                Opacity="0.9"
                                Orientation="Horizontal"
                                Spacing="12">
                                <Grid>
                                    <FontIcon
                                        FontSize="20"
                                        Foreground="White"
                                        Glyph="&#xE717;" />
                                    <TextBlock
                                        Margin="30,-2,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="1" />
                                </Grid>
                                <Grid>
                                    <FontIcon
                                        FontSize="20"
                                        Foreground="White"
                                        Glyph="&#xE715;" />
                                    <TextBlock
                                        Margin="30,-2,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="5" />
                                </Grid>
                                <Grid>
                                    <FontIcon
                                        FontSize="20"
                                        Foreground="White"
                                        Glyph="&#xE8BD;" />
                                    <TextBlock
                                        Margin="30,-2,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="2" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <FontIcon
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            FontSize="12"
                            Foreground="White"
                            Glyph="&#xE70E;"
                            Opacity="0.5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>