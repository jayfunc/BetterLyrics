<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.CanvasItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="SizingWrapper"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

        <Rectangle
            x:Name="SpanHighlightBorder"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            RadiusX="4"
            RadiusY="4"
            StrokeDashArray="4 4"
            StrokeThickness="2"
            Visibility="Collapsed" />
        <Border
            x:Name="MainBorder"
            MinWidth="4"
            MinHeight="4"
            x:FieldModifier="public"
            Background="#10FFFFFF"
            BorderThickness="1"
            CanDrag="True"
            CornerRadius="4">
            <Grid x:Name="ContentHost" />
        </Border>

        <Border
            x:Name="RightHandle"
            Width="12"
            Height="12"
            Margin="0,0,-6,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            x:FieldModifier="public"
            Background="White"
            BorderThickness="2"
            CornerRadius="6" />

        <Border
            x:Name="BottomHandle"
            Width="12"
            Height="12"
            Margin="0,0,0,-6"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            x:FieldModifier="public"
            Background="White"
            BorderThickness="2"
            CornerRadius="6" />

        <Border
            x:Name="CornerHandle"
            Width="12"
            Height="12"
            Margin="0,0,-6,-6"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            x:FieldModifier="public"
            Background="White"
            BorderThickness="2"
            CornerRadius="6" />
    </Grid>
</UserControl>