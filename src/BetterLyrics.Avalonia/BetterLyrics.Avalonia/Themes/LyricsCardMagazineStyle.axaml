<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BetterLyrics.Avalonia.Controls"
    xmlns:lyrics="using:BetterLyrics.Core.Models.Lyrics"
    xmlns:ui="using:FluentAvalonia.UI.Controls">

    <ControlTheme x:Key="LyricsCardMagazineStyle" TargetType="controls:LyricsCard">
        
                <Setter Property="Template">
                <ControlTemplate TargetType="controls:LyricsCard">
                    <Grid
                        Width="450"
                        Height="{TemplateBinding LyricsAreaSize}"
                        MinHeight="600"
                        Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="300" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Image
                            VerticalAlignment="Center"
                            Source="{Binding CoverImage, RelativeSource={RelativeSource TemplatedParent}}"
                            Stretch="UniformToFill" />

                        <TextBlock
                            Margin="0,0,0,-15"
                            VerticalAlignment="Bottom"
                            FontSize="80"
                            FontWeight="Bold"
                            Foreground="White"
                            Opacity="0.2"
                            Text="LYRICS" />

                        <Grid Grid.Row="1" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="0,30,0,0">
                                        <TextBlock
                                            FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                            FontSize="32"
                                            FontWeight="Black"
                                            Foreground="Black"
                                            LineHeight="36"
                                            Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Margin="0,8,0,0"
                                            FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                            FontSize="16"
                                            FontStyle="Italic"
                                            Foreground="#666"
                                            Text="{Binding Artist, RelativeSource={RelativeSource TemplatedParent}}"
                                            TextWrapping="Wrap" />

                                        <Border
                                            Width="40"
                                            Height="4"
                                            Margin="0,15,0,25"
                                            HorizontalAlignment="Left"
                                            Background="Black" />
                                    </StackPanel>
                                    <ItemsControl
                                        x:Name="PART_LyricsItemsControl"
                                        Grid.Row="1"
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                        ItemsSource="{Binding LyricsLines, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="lyrics:LyricsLine">
                                                <StackPanel Margin="0,0,0,20">

                                                    <TextBlock
                                                        FontSize="18"
                                                        Foreground="#333"
                                                        LineHeight="28"
                                                        Text="{Binding Text}"
                                                        TextWrapping="Wrap" />

                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        FontSize="14"
                                                        Foreground="#888"
                                                        LineHeight="20"
                                                        Text="{Binding SecondaryText}"
                                                        TextWrapping="Wrap"
                                                        IsVisible="{Binding SecondaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>

                            <StackPanel
                                Grid.Row="1"
                                Margin="0,20,0,0"
                                Opacity="0.5"
                                Orientation="Horizontal">
                                <TextBlock
                                    FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="Black"
                                    Text="BetterLyrics" />
                                <TextBlock
                                    FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                    FontSize="12"
                                    Foreground="Black"
                                    Text=" • ISSUE 01" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter>
    </ControlTheme>

</ResourceDictionary>