<Application xmlns="https://github.com/avaloniaui"
             xmlns:converters="using:BetterLyrics.Avalonia.Converters"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:BetterLyrics.Avalonia"
             xmlns:styling="using:FluentAvalonia.Styling"
             x:Class="BetterLyrics.Avalonia.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/Logo.ico"
                      ToolTipText="BetterLyrics">
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Controls/AutoScrollView.axaml"/>
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/DefaultStyles.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/GhostSliderStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/Converters.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Styles/SegmentedStyle.axaml" />

                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardAncientBookStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardBambooSlipsStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardCDStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardCinematicStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardCyberpunkStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardDunhuangStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardInkWashStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardJournalStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardLINEStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardMagazineStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardMinimalStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardPodStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardPolaroidStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardQQStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardReceiptStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardRetroMSNStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardRetroQQStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardStickyNoteStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardSwissStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardTelegramStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardTicketStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardVinylStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardWeChatStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardWhatsAppStyle.axaml" />
                <ResourceInclude Source="avares://BetterLyrics.Avalonia/Themes/LyricsCardWindowsPhoneStyle.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="SegoeFluentIcons">avares://BetterLyrics.Avalonia/Assets/Fonts/SegoeFluentIcons.ttf#Segoe Fluent Icons</FontFamily>
            <FontFamily x:Key="SloganCNFont">avares:///BetterLyrics.Avalonia/Assets/Fonts/SloganCNFont.ttf#LXGW WenKai Lite</FontFamily>
            <FontFamily x:Key="SloganENFont">avares:///BetterLyrics.Avalonia/Assets/Fonts/SloganENFont.ttf#Lora</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <styling:FluentAvaloniaTheme />
        <Style Selector="Border.CardBorderStyle">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        </Style>
        <Style Selector="Border.SettingsBorderStyle">
            <Setter Property="Padding" Value="0,0,0,36" />
        </Style>
        <Style Selector="ScrollViewer.SettingsScrollViewerStyle">
            <Setter Property="Padding" Value="36,0" />
        </Style>
        <Style Selector="TextBlock.SettingsSectionHeaderTextBlockStyle">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
        <Style Selector="Button.TitleBarButtonStyle">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,9,16,9" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.GhostButtonStyle">
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Styles>
</Application>