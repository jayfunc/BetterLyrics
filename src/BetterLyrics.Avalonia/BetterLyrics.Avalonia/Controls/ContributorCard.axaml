<UserControl
    x:Class="BetterLyrics.Avalonia.Controls.ContributorCard"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BetterLyrics.Avalonia.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="RootControl">

    <Border Classes="CardBorderStyle">

        <Grid Margin="12" ColumnDefinitions="Auto,*">
            <Border
                Grid.Column="0" Margin="0,0,12,0"
                Width="40"
                Height="40"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="20">
                <Border.Background>
                    <ImageBrush Source="{Binding #RootControl.AvatarSource}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock
                        Classes="BodyStrongTextBlockStyle"
                        Text="{Binding #RootControl.Header}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{Binding #RootControl.Badges}" />
                </StackPanel>

                <local:ExternalLinkButton
                    Padding="0"
                    Content="{Binding #RootControl.Description}"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    NavigateUri="{Binding #RootControl.Description}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>