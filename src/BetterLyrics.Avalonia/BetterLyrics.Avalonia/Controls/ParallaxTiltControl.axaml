<UserControl
    x:Class="BetterLyrics.Avalonia.Controls.ParallaxTiltControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BetterLyrics.Avalonia.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    x:DataType="local:ParallaxTiltControl"
    x:Name="RootControl"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        RenderTransformOrigin="50%,50%">

        <Grid.RenderTransform>
            <Rotate3DTransform />
        </Grid.RenderTransform>

        <ContentPresenter x:Name="ContentPresenter" Content="{Binding #RootControl.Content}">
            <ContentPresenter.RenderTransform>
                <TranslateTransform />
            </ContentPresenter.RenderTransform>
        </ContentPresenter>

    </Grid>
</UserControl>