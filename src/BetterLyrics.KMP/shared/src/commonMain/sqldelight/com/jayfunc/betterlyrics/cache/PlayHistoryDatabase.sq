CREATE TABLE PlayHistoryEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    playerId TEXT NOT NULL,
    title TEXT NOT NULL,
    artist TEXT NOT NULL,
    album TEXT NOT NULL,
    startedAt INTEGER NOT NULL, -- Unix timestamp in milliseconds
    totalDurationMs REAL NOT NULL,
    durationPlayedMs REAL NOT NULL
);

insertLog:
INSERT INTO PlayHistoryEntity(playerId, title, artist, album, startedAt, totalDurationMs, durationPlayedMs)
VALUES (?, ?, ?, ?, ?, ?, ?);

getRecentLogs:
SELECT * FROM PlayHistoryEntity
ORDER BY startedAt DESC
LIMIT :limit;

getLogsByDateRange:
SELECT * FROM PlayHistoryEntity
WHERE startedAt >= :start AND startedAt <= :end;

getTopSongs:
SELECT title, artist, count(*) AS playCount
FROM PlayHistoryEntity
WHERE startedAt >= :start AND startedAt <= :end
GROUP BY title, artist
ORDER BY playCount DESC
LIMIT :limit;

getTopArtists:
SELECT artist, count(*) AS playCount, sum(durationPlayedMs) / 1000.0 AS totalDurationSeconds
FROM PlayHistoryEntity
WHERE startedAt >= :start AND startedAt <= :end
GROUP BY artist
ORDER BY playCount DESC
LIMIT :limit;

getTotalListeningDuration:
SELECT sum(min(durationPlayedMs, totalDurationMs)) AS totalMs
FROM PlayHistoryEntity
WHERE startedAt >= :start AND startedAt <= :end;

getPlayerDistribution:
SELECT playerId, count(*) AS count
FROM PlayHistoryEntity
WHERE startedAt >= :start AND startedAt <= :end
GROUP BY playerId
ORDER BY count DESC;

deleteLog:
DELETE FROM PlayHistoryEntity WHERE id = ?;

clearHistory:
DELETE FROM PlayHistoryEntity;
