<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.InfoTag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        x:Name="BadgeBorder"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited"
        Tapped="OnTapped">

        <Grid>
            <StackPanel
                Margin="8,2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">

                <FontIcon
                    x:Name="TagIcon"
                    Margin="0,2"
                    FontFamily="{StaticResource SegoeFluentIcons}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind Glyph, Mode=OneWay}"
                    Visibility="{x:Bind HasIcon, Mode=OneWay}" />

                <TextBlock
                    x:Name="TagText"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Text, Mode=OneWay}"
                    Visibility="{x:Bind HasText, Mode=OneWay}" />
            </StackPanel>
            <Line
                x:Name="DisabledStrikethrough"
                Margin="6,2"
                Stretch="Fill"
                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                StrokeThickness="1.5"
                Visibility="Collapsed"
                X1="0"
                X2="1"
                Y1="0"
                Y2="1" />
        </Grid>
    </Border>
</UserControl>