<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.Charts.SourceBarChartControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:stats="using:BetterLyrics.Core.Models.Stats"
    mc:Ignorable="d">

    <Grid>
        <ItemsControl x:Name="ChartItemsControl">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="stats:PlayerSourceItem">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Name}" />

                        <!--  Track background  -->
                        <Grid
                            Grid.Column="1"
                            Height="8"
                            VerticalAlignment="Center"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            CornerRadius="4"
                            Loaded="TrackBg_Loaded"
                            SizeChanged="TrackBg_SizeChanged"
                            Tag="{x:Bind Count}">
                            <Border
                                Width="0"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4" />
                        </Grid>

                        <TextBlock
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold">
                            <Run Text="{x:Bind Count}" />
                            <Run
                                x:Uid="StatsDashboardControlTrackCountText"
                                FontSize="10"
                                FontWeight="Normal"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
