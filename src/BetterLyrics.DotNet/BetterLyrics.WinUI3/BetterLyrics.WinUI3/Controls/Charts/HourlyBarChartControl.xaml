<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.Charts.HourlyBarChartControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:stats="using:BetterLyrics.Core.Models.Stats"
    SizeChanged="UserControl_SizeChanged"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="TooltipTemplate" x:DataType="stats:HourlyActivityItem">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind TimeLabel}" />
                <Grid Width="4" />
                <TextBlock FontWeight="SemiBold" Text="{x:Bind Count}" />
                <Grid Width="2" />
                <TextBlock x:Uid="StatsDashboardControlTrackCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="ChartRoot" />
</UserControl>
