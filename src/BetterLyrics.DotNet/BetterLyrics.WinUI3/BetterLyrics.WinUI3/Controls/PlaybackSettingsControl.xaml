<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.PlaybackSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:constants1="using:BetterLyrics.Core.Constants"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:BetterLyrics.Core.Helpers"
    xmlns:helpers1="using:BetterLyrics.WinUI3.Helpers"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:BetterLyrics.WinUI3.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models1="using:BetterLyrics.Core.Models"
    xmlns:settings="using:BetterLyrics.Core.Models.Settings"
    xmlns:ui="using:CommunityToolkit.WinUI"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  PlaybackListGrid  -->
        <Grid Grid.Column="0">
            <Grid.OpacityTransition>
                <ScalarTransition />
            </Grid.OpacityTransition>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <InfoBar
                    x:Uid="SettingsPageMusicGalleryOpened"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.AppSettings.MusicGallerySettings.LyricsWindowStatus.WindowStatus, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=0}"
                    Severity="Informational" />
                <InfoBar
                    x:Uid="PlaybackSettingsControlBetterLyricsRunningInBackground"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.GsmtcService.CurrentMediaSourceProviderInfo.IsBetterLyrics, Mode=OneWay}"
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <HyperlinkButton x:Uid="PlaybackSettingsControlStopBetterLyricsPlayer" Command="{x:Bind ViewModel.StopTrackCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <!--  播放源列表  -->
            <Grid Grid.Row="1">
                <interactivity:Interaction.Behaviors>
                    <interactivity:DataTriggerBehavior
                        Binding="{x:Bind ViewModel.AppSettings.MediaSourceProvidersInfo.Count, Mode=OneWay}"
                        ComparisonCondition="NotEqual"
                        Value="0">
                        <interactivity:ChangePropertyAction PropertyName="Visibility" Value="Visible" />
                    </interactivity:DataTriggerBehavior>
                    <interactivity:DataTriggerBehavior
                        Binding="{x:Bind ViewModel.AppSettings.MediaSourceProvidersInfo.Count, Mode=OneWay}"
                        ComparisonCondition="Equal"
                        Value="0">
                        <interactivity:ChangePropertyAction PropertyName="Visibility" Value="Collapsed" />
                    </interactivity:DataTriggerBehavior>
                </interactivity:Interaction.Behaviors>
                <ScrollViewer>
                    <StackPanel Margin="36,0,36,36" Spacing="{StaticResource SettingsCardSpacing}">
                        <TextBlock x:Uid="SettingsPageConfigPlaybackSource" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                        <ListView
                            x:Name="MediaSourceProvidersListView"
                            HorizontalAlignment="Stretch"
                            AllowDrop="True"
                            CanDragItems="True"
                            CanReorderItems="True"
                            DragItemsCompleted="MediaSourceProvidersListView_DragItemsCompleted"
                            ItemContainerStyle="{ThemeResource ListViewCardStyle}"
                            ItemsSource="{x:Bind ViewModel.AppSettings.MediaSourceProvidersInfo, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="settings:MediaSourceProviderInfo">
                                    <Grid>
                                        <Grid
                                            Padding="12"
                                            ColumnSpacing="12"
                                            Opacity="{Binding IsEnabled, Converter={StaticResource BoolToPartialOpacityConverter}, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ToolTipService.ToolTip>
                                                <ToolTip Content="{Binding Provider, Mode=OneWay}" />
                                            </ToolTipService.ToolTip>
                                            <Grid Grid.Column="0">
                                                <FontIcon
                                                    FontFamily="Segoe UI Symbol"
                                                    FontSize="16"
                                                    Glyph="&#x283F;" />
                                            </Grid>
                                            <Grid Grid.Column="1">
                                                <Image Height="24" helpers1:AppExtensions.Aumid="{Binding Provider, Mode=OneWay}" />
                                            </Grid>
                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        helpers1:AppExtensions.Aumid="{Binding Provider}"
                                                        TextWrapping="Wrap" />
                                                    <Image
                                                        Height="16"
                                                        helpers1:GifHelper.IsPlaying="{Binding ElementName=MediaSourceProvidersListView, Path=ViewModel.GsmtcService.CurrentIsPlaying, Mode=OneWay}"
                                                        Source="{ThemeResource MusicWave}"
                                                        Visibility="{Binding IsFocused, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxLines="1"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{Binding Provider}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="3"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <Button
                                                    Padding="6"
                                                    Click="ConfigButton_Click"
                                                    Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                                          FontSize=16,
                                                                          Glyph=&#xE90F;}" />
                                                <Button
                                                    Padding="6"
                                                    Click="DeleteButton_Click"
                                                    Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                                          FontSize=16,
                                                                          Glyph=&#xE74D;}" />
                                            </StackPanel>
                                        </Grid>
                                        <local:DragIndicator Width="32" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!--  播放源空白占位  -->
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <interactivity:Interaction.Behaviors>
                    <interactivity:DataTriggerBehavior
                        Binding="{x:Bind ViewModel.AppSettings.MediaSourceProvidersInfo.Count, Mode=OneWay}"
                        ComparisonCondition="Equal"
                        Value="0">
                        <interactivity:ChangePropertyAction PropertyName="Visibility" Value="Visible" />
                    </interactivity:DataTriggerBehavior>
                    <interactivity:DataTriggerBehavior
                        Binding="{x:Bind ViewModel.AppSettings.MediaSourceProvidersInfo.Count, Mode=OneWay}"
                        ComparisonCondition="NotEqual"
                        Value="0">
                        <interactivity:ChangePropertyAction PropertyName="Visibility" Value="Collapsed" />
                    </interactivity:DataTriggerBehavior>
                </interactivity:Interaction.Behaviors>
                <Image MaxWidth="200" Source="/Assets/Leaf.png" />
                <TextBlock
                    x:Uid="SettingsPagePlaybackNotFound"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

        </Grid>

        <!--  播放源配置  -->
        <local:FloatSidePanel x:Name="PlaybackConfigPanel" Grid.Column="0">
            <ScrollViewer Style="{StaticResource SettingsScrollViewerStyle}">
                <Grid Style="{StaticResource SettingsGridStyle}">
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Grid.Column="0"
                                Height="16"
                                Margin="0,26,0,0"
                                helpers1:AppExtensions.Aumid="{x:Bind ViewModel.SelectedMediaSourceProvider.Provider, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                helpers1:AppExtensions.Aumid="{x:Bind ViewModel.SelectedMediaSourceProvider.Provider, Mode=OneWay}"
                                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                            <Image
                                Grid.Column="2"
                                Height="16"
                                Margin="0,26,0,0"
                                helpers1:GifHelper.IsPlaying="{x:Bind ViewModel.GsmtcService.CurrentIsPlaying, Mode=OneWay}"
                                Source="{ThemeResource MusicWave}"
                                Visibility="{x:Bind ViewModel.SelectedMediaSourceProvider.IsFocused, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button
                                Grid.Column="4"
                                Margin="0,24,0,0"
                                Click="CloseConfigPanelButton_Click"
                                Content="{ui:FontIcon FontSize=16,
                                                      FontFamily={StaticResource SegoeFluentIcons},
                                                      Glyph=&#xE70D;}"
                                Style="{ThemeResource AccentButtonStyle}" />
                        </Grid>

                        <!--  总开关  -->
                        <controls:SettingsExpander x:Uid="SettingsPageMediaSourceProvidersConfig">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.SelectedMediaSourceProvider.IsEnabled, Mode=TwoWay}" />
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard x:Uid="PlaybackSettingsControlMemoryReader">
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.SelectedMediaSourceProvider.IsMemoryReaderEnabled, Mode=TwoWay}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <local:ExternalLinkButton x:Uid="Help" NavigateUri="https://gist.github.com/jayfunc/ad09a3df951b95c8cf6228695fecc067" />
                                        <Button x:Uid="SettingsPageImport" Command="{x:Bind ViewModel.ImportMemoryReaderConfigCommand}" />
                                    </StackPanel>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>

                        <!--  Last.fm  -->
                        <controls:SettingsCard x:Uid="SettingsPageLastFMTrack" IsEnabled="{x:Bind ViewModel.IsLastFmAuthenticated, Mode=OneWay}">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.SelectedMediaSourceProvider.IsLastFMTrackEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <!--  Discord  -->
                        <controls:SettingsCard x:Uid="SettingsPageDiscordPresence">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.SelectedMediaSourceProvider.IsDiscordPresenceEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <!--  LX music server  -->
                        <controls:SettingsCard x:Uid="SettingsPageLXMusicServer" Visibility="{x:Bind ViewModel.SelectedMediaSourceProvider.IsLXMusic, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Uid="SettingsPageLXMusicServerInput"
                                    Grid.Column="0"
                                    IsEnabled="{x:Bind ViewModel.IsLxMusicServerTesting, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.AppSettings.GeneralSettings.LXMusicServer, Mode=TwoWay}"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Uid="SettingsPageServerTestButton"
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.LxMusicServerTestCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsLxMusicServerTesting, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" />
                            </Grid>
                        </controls:SettingsCard>

                        <!--  时间轴相关配置  -->
                        <controls:SettingsExpander x:Uid="SettingsPageLyricsTimeline">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.SelectedMediaSourceProvider.IsTimelineSyncEnabled, Mode=TwoWay}" />
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard x:Uid="SettingsPageLyricsTimelineThreshold" IsEnabled="{x:Bind ViewModel.SelectedMediaSourceProvider.IsTimelineSyncEnabled, Mode=OneWay}">
                                    <local:ExtendedSlider
                                        Frequency="100"
                                        Maximum="1000"
                                        Minimum="0"
                                        ResetButtonVisibility="Collapsed"
                                        Unit="ms"
                                        Value="{x:Bind ViewModel.SelectedMediaSourceProvider.TimelineSyncThreshold, Mode=TwoWay}" />
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>
                        <controls:SettingsExpander x:Uid="MainPagePositionOffsetSlider">
                            <local:ExtendedSlider
                                x:Uid="SettingsPagePositionOffsetReset"
                                Default="0"
                                Frequency="100"
                                Maximum="5000"
                                Minimum="-5000"
                                Unit="ms"
                                Value="{x:Bind ViewModel.SelectedMediaSourceProvider.PositionOffset, Mode=TwoWay}" />
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard x:Uid="LyricsPagePositionOffsetHint">
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.SelectedMediaSourceProvider.ResetPositionOffsetOnSongChanged, Mode=TwoWay}" />
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>

                        <!--  专辑封面源配置  -->
                        <Expander
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="Transparent">
                            <Expander.Header>
                                <TextBlock x:Uid="SettingsPageAlbumArtSearchProvidersConfig" />
                            </Expander.Header>
                            <StackPanel>
                                <controls:SettingsCard x:Uid="AlbumArtSearchProvidersTargetSize">
                                    <local:ExtendedSlider
                                        Default="512"
                                        Frequency="128"
                                        Maximum="2048"
                                        Minimum="64"
                                        Unit="px"
                                        Value="{x:Bind ViewModel.SelectedMediaSourceProvider.TargetAlbumArtSize, Mode=TwoWay}" />
                                </controls:SettingsCard>
                                <ListView
                                    AllowDrop="True"
                                    CanDragItems="True"
                                    CanReorderItems="True"
                                    DragItemsCompleted="AlbumArtSearchProvidersListView_DragItemsCompleted"
                                    ItemContainerStyle="{ThemeResource ListViewStretchedItemContainerStyle}"
                                    ItemsSource="{x:Bind ViewModel.SelectedMediaSourceProvider.AlbumArtSearchProvidersInfo, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.OpacityTransition>
                                        <ScalarTransition />
                                    </ListView.OpacityTransition>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="settings:AlbumArtSearchProviderInfo">
                                            <Grid>
                                                <controls:SettingsCard Header="{Binding Provider, Converter={StaticResource AlbumArtSearchProviderToDisplayNameConverter}, Mode=OneWay}">
                                                    <controls:SettingsCard.HeaderIcon>
                                                        <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#x283F;" />
                                                    </controls:SettingsCard.HeaderIcon>
                                                    <ToggleSwitch IsOn="{Binding IsEnabled, Mode=TwoWay}" />
                                                </controls:SettingsCard>
                                                <local:DragIndicator />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Expander>

                        <!--  歌词源配置  -->
                        <Expander
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="Transparent">
                            <Expander.Header>
                                <TextBlock x:Uid="SettingsPageLyricsSearchProvidersConfig" />
                            </Expander.Header>
                            <StackPanel>
                                <controls:SettingsCard x:Uid="SettingsPageLyricsSearchType">
                                    <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedMediaSourceProvider.LyricsSearchType, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                                        <ComboBoxItem x:Uid="SettingsPageLyricsSearchSequential" />
                                        <ComboBoxItem x:Uid="SettingsPageLyricsSearchBestMatch" />
                                    </ComboBox>
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Uid="SettingsPageMatchingThreshold">
                                    <local:ExtendedSlider
                                        Default="60"
                                        Maximum="100"
                                        Minimum="0"
                                        Unit="%"
                                        Value="{x:Bind ViewModel.SelectedMediaSourceProvider.MatchingThreshold, Mode=TwoWay}" />
                                </controls:SettingsCard>
                                <ListView
                                    AllowDrop="True"
                                    CanDragItems="True"
                                    CanReorderItems="True"
                                    DragItemsCompleted="LyricsSearchProvidersListView_DragItemsCompleted"
                                    ItemContainerStyle="{ThemeResource ListViewStretchedItemContainerStyle}"
                                    ItemsSource="{x:Bind ViewModel.SelectedMediaSourceProvider.LyricsSearchProvidersInfo, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.OpacityTransition>
                                        <ScalarTransition />
                                    </ListView.OpacityTransition>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="settings:LyricsSearchProviderInfo">
                                            <Grid>
                                                <controls:SettingsExpander IsExpanded="{Binding IsMatchingThresholdOverwritten, Mode=OneWay}">
                                                    <controls:SettingsExpander.Header>
                                                        <Grid ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Provider, Converter={StaticResource LyricsProviderToDisplayNameConverter}, Mode=OneWay}" />
                                                            <FontIcon
                                                                Grid.Column="1"
                                                                Margin="0,2,0,0"
                                                                FontFamily="{StaticResource SegoeFluentIcons}"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Glyph="&#xE74C;"
                                                                Visibility="{Binding IsPlugin, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </Grid>
                                                    </controls:SettingsExpander.Header>
                                                    <controls:SettingsExpander.HeaderIcon>
                                                        <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#x283F;" />
                                                    </controls:SettingsExpander.HeaderIcon>
                                                    <ToggleSwitch IsOn="{Binding IsEnabled, Mode=TwoWay}" />
                                                    <controls:SettingsExpander.Items>
                                                        <controls:SettingsCard x:Uid="LyricsSearchControlIgnoreCache">
                                                            <CheckBox MinWidth="20" IsChecked="{Binding IgnoreCacheWhenSearching, Mode=TwoWay}" />
                                                        </controls:SettingsCard>
                                                        <controls:SettingsCard x:Uid="SettingsPageOverwriteMatchingThreshold">
                                                            <ToggleSwitch IsOn="{Binding IsMatchingThresholdOverwritten, Mode=TwoWay}" />
                                                        </controls:SettingsCard>
                                                        <controls:SettingsCard x:Uid="SettingsPageMatchingThreshold" IsEnabled="{Binding IsMatchingThresholdOverwritten, Mode=OneWay}">
                                                            <local:ExtendedSlider
                                                                Default="60"
                                                                Maximum="100"
                                                                Minimum="0"
                                                                Unit="%"
                                                                Value="{Binding MatchingThreshold, Mode=TwoWay}" />
                                                        </controls:SettingsCard>
                                                    </controls:SettingsExpander.Items>
                                                </controls:SettingsExpander>
                                                <local:DragIndicator />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </local:FloatSidePanel>

        <!--  右侧杂项设置  -->
        <Grid Grid.Column="1">
            <ScrollViewer Style="{StaticResource SettingsScrollViewerStyle}">
                <Grid Style="{StaticResource SettingsGridStyle}">
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

                        <!--  Realtime info  -->
                        <TextBlock x:Uid="SettingsPageRealtimeStatus" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                        <!--  Playback source info  -->
                        <Expander
                            x:Uid="SettingsPagePlaybackStatus"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                            <StackPanel Spacing="6">
                                <local:PropertyRow x:Uid="SettingsPagePlaybackSource" helpers1:AppExtensions.Aumid="{x:Bind ViewModel.GsmtcService.CurrentMediaSourceProviderInfo.Provider, FallbackValue=N/A, TargetNullValue=N/A, Mode=OneWay}" />
                                <local:PropertyRow x:Uid="SettingsPagePlaybackSourceID" Value="{x:Bind ViewModel.GsmtcService.CurrentMediaSourceProviderInfo.Provider, FallbackValue=N/A, TargetNullValue=N/A, Mode=OneWay}" />
                            </StackPanel>
                        </Expander>

                        <!--  Song info  -->
                        <Expander
                            x:Uid="SettingsPageSongStatus"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                            <StackPanel Spacing="6">
                                <local:PropertyRow x:Uid="SettingsPageSongTitle" Value="{x:Bind ViewModel.GsmtcService.CurrentSongInfo.Title, TargetNullValue=N/A, Mode=OneWay}" />
                                <local:PropertyRow x:Uid="SettingsPageArtist" Value="{x:Bind ViewModel.GsmtcService.CurrentSongInfo.Artist, TargetNullValue=N/A, Mode=OneWay}" />
                                <local:PropertyRow x:Uid="SettingsPageAlbum" Value="{x:Bind ViewModel.GsmtcService.CurrentSongInfo.Album, TargetNullValue=N/A, Mode=OneWay}" />
                                <local:PropertyRow x:Uid="LyricsSearchControlDurauion" Value="{x:Bind ViewModel.GsmtcService.CurrentSongInfo.DurationMs, TargetNullValue=N/A, Converter={StaticResource MillisecondsToFormattedTimeConverter}, Mode=OneWay}" />
                            </StackPanel>
                        </Expander>

                        <!--  Search result info  -->
                        <Expander
                            x:Uid="SettingsPageSearchResultStatus"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <local:PropertyRow x:Uid="SettingsPageSongTitle" Value="{x:Bind ViewModel.GsmtcService.CurrentLyricsSearchResult.Title, TargetNullValue=N/A, Mode=OneWay}" />
                                <local:PropertyRow x:Uid="SettingsPageArtist" Value="{x:Bind ViewModel.GsmtcService.CurrentLyricsSearchResult.Artist, TargetNullValue=N/A, Mode=OneWay}" />
                                <local:PropertyRow x:Uid="SettingsPageAlbum" Value="{x:Bind ViewModel.GsmtcService.CurrentLyricsSearchResult.Album, TargetNullValue=N/A, Mode=OneWay}" />
                                <local:PropertyRow x:Uid="LyricsSearchControlDurauion" Value="{x:Bind ViewModel.GsmtcService.CurrentLyricsSearchResult.Duration, Converter={StaticResource SecondsToFormattedTimeConverter}, TargetNullValue=N/A, Mode=OneWay}" />
                                <local:PropertyRow x:Uid="LyricsPageLanguageCode" Value="{x:Bind ViewModel.GsmtcService.CurrentLyricsData.LanguageTag, TargetNullValue=N/A, Mode=OneWay, Converter={StaticResource LanguageTagToDisplayedNameConverter}}" />
                                <local:PropertyRow
                                    x:Uid="LyricsPageLyricsProviderPrefix"
                                    Link="{x:Bind ViewModel.GsmtcService.CurrentLyricsSearchResult.Reference, Mode=OneWay, Converter={StaticResource UriStringToDecodedAbsoluteUri}}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.GsmtcService.CurrentLyricsSearchResult.Reference, TargetNullValue=N/A, Mode=OneWay, Converter={StaticResource UriStringToDecodedAbsoluteUri}}"
                                    Value="{x:Bind ViewModel.GsmtcService.CurrentLyricsSearchResult.ProviderIfFound, Mode=OneWay, Converter={StaticResource LyricsProviderToDisplayNameConverter}}" />
                                <local:PropertyRow x:Uid="LyricsPageTransliterationProviderPrefix" Value="{x:Bind ViewModel.GsmtcService.CurrentLyricsSearchResult.TransliterationProvider, Mode=OneWay, Converter={StaticResource LyricsProviderToDisplayNameConverter}}" />
                                <local:PropertyRow x:Uid="LyricsPageTranslationProviderPrefix" Value="{x:Bind ViewModel.GsmtcService.CurrentLyricsSearchResult.TranslationProvider, Mode=OneWay, Converter={StaticResource LyricsProviderToDisplayNameConverter}}" />
                                <local:PropertyRow
                                    x:Uid="LyricsPageMatchPercentage"
                                    Unit="%"
                                    Value="{x:Bind ViewModel.GsmtcService.CurrentLyricsSearchResult.MatchPercentage, Mode=OneWay}" />
                                <Grid Margin="-16,0,-16,-16" ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, FontSize=16, Glyph=&#xE713;}">
                                        <Button.Flyout>
                                            <Flyout ShouldConstrainToRootBounds="False">
                                                <Flyout.FlyoutPresenterStyle>
                                                    <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                                        <Setter Property="MaxWidth" Value="500" />
                                                    </Style>
                                                </Flyout.FlyoutPresenterStyle>
                                                <StackPanel MaxWidth="500">
                                                    <controls:SettingsCard x:Uid="LyricsSaveConfigInSyllablesFormat">
                                                        <ToggleSwitch IsOn="{x:Bind ViewModel.AppSettings.LyricsSaveConfig.InSyllablesFormat, Mode=TwoWay}" />
                                                    </controls:SettingsCard>
                                                    <controls:SettingsCard x:Uid="LyricsSaveConfigIncludeTranslation">
                                                        <ToggleSwitch IsOn="{x:Bind ViewModel.AppSettings.LyricsSaveConfig.IncludeTranslation, Mode=TwoWay}" />
                                                    </controls:SettingsCard>
                                                    <controls:SettingsCard x:Uid="LyricsSaveConfigIncludeTransliteration">
                                                        <ToggleSwitch IsOn="{x:Bind ViewModel.AppSettings.LyricsSaveConfig.IncludeTransliteration, Mode=TwoWay}" />
                                                    </controls:SettingsCard>
                                                    <controls:SettingsCard x:Uid="LyricsSaveConfigInOneLine">
                                                        <ToggleSwitch IsOn="{x:Bind ViewModel.AppSettings.LyricsSaveConfig.InOneLine, Mode=TwoWay}" />
                                                    </controls:SettingsCard>
                                                    <controls:SettingsCard x:Uid="LyricsSaveConfigFolder">
                                                        <Grid ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox
                                                                Grid.Column="0"
                                                                IsReadOnly="True"
                                                                Text="{x:Bind ViewModel.AppSettings.LyricsSaveConfig.SaveLocation, Mode=OneWay}"
                                                                TextWrapping="Wrap" />
                                                            <Button
                                                                x:Uid="RemoteServerConfigControlBrowse"
                                                                Grid.Column="1"
                                                                Click="BrowseLyricsSaveLocationButton_Click" />
                                                        </Grid>
                                                    </controls:SettingsCard>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <!--  SaveLyricsButton  -->
                                    <DropDownButton
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                              FontSize=16,
                                                              Glyph=&#xE74E;}">
                                        <DropDownButton.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem x:Uid="PlaybackSettingsControlSaveLyricsAsLrc" Click="SaveLyricsAsLrcMenuFlyoutItem_Click" />
                                                <MenuFlyoutItem x:Uid="PlaybackSettingsControlSaveLyricsAsTtml" Click="SaveLyricsAsTtmlMenuFlyoutItem_Click" />
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <controls:SettingsCard x:Uid="SettingsPageListenNewSession">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AppSettings.GeneralSettings.ListenOnNewPlaybackSource, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <TextBlock x:Uid="SettingsPageLyricsProcessing" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                        <!--  Lyrics translation  -->
                        <controls:SettingsExpander x:Uid="LyricsPageTranslationEnabled" IsExpanded="True">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AppSettings.TranslationSettings.IsTranslationEnabled, Mode=TwoWay}" />
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard x:Uid="SettingsPageTargetLanguage" IsEnabled="{x:Bind ViewModel.AppSettings.TranslationSettings.IsTranslationEnabled, Mode=OneWay}">
                                    <ComboBox ItemsSource="{x:Bind helpers:LanguageHelper.SupportedTranslationTargetLanguages}" SelectedIndex="{x:Bind ViewModel.SelectedTargetLanguageIndex, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models1:ExtendedLanguage">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind NativeName}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind DisplayName}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Uid="SettingsPageTranslationConfig" IsEnabled="{x:Bind ViewModel.AppSettings.TranslationSettings.IsTranslationEnabled, Mode=OneWay}">
                                    <controls:SettingsCard.Description>
                                        <local:ExternalLinkButton
                                            Padding="0"
                                            Content="https://github.com/LibreTranslate/LibreTranslate"
                                            NavigateUri="https://github.com/LibreTranslate/LibreTranslate" />
                                    </controls:SettingsCard.Description>
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.AppSettings.TranslationSettings.IsLibreTranslateEnabled, Mode=TwoWay}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Uid="SettingsPageLibreTranslateServer" IsEnabled="{x:Bind ViewModel.AppSettings.TranslationSettings.IsLibreTranslateEnabled, Mode=OneWay}">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Uid="LibreTranslateServerTextBox"
                                            Grid.Column="0"
                                            IsEnabled="{x:Bind ViewModel.IsLibreTranslateServerTesting, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                                            Text="{x:Bind ViewModel.AppSettings.TranslationSettings.LibreTranslateServer, Mode=TwoWay}"
                                            TextWrapping="Wrap" />
                                        <Button
                                            x:Uid="SettingsPageServerTestButton"
                                            Grid.Column="1"
                                            Command="{x:Bind ViewModel.LibreTranslateServerTestCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsLibreTranslateServerTesting, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" />
                                    </Grid>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>

                        <!--  Lyrics phonetic  -->
                        <controls:SettingsExpander x:Uid="SettingsPagePhonetics" IsExpanded="True">
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard x:Uid="SettingsPagePinyin">
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.AppSettings.TranslationSettings.IsMandarinRomanizationEnabled, Mode=TwoWay}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Uid="SettingsPageJyutping">
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.AppSettings.TranslationSettings.IsCantoneseRomanizationEnabled, Mode=TwoWay}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Uid="SettingsPageJapanese">
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.AppSettings.TranslationSettings.IsJapaneseRomanizationEnabled, Mode=TwoWay}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Uid="SettingsPageKorean">
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.AppSettings.TranslationSettings.IsKoreanRomanizationEnabled, Mode=TwoWay}" />
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>

                        <!--  中文简体繁体偏好  -->
                        <controls:SettingsCard x:Uid="SettingsPageChinesePreference">
                            <ComboBox SelectedIndex="{x:Bind ViewModel.AppSettings.TranslationSettings.ChineseConversion, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                                <ComboBoxItem x:Uid="SettingsPageChinesePreferenceUnspecified" />
                                <ComboBoxItem x:Uid="SettingsPageChinesePreferenceSToT" />
                                <ComboBoxItem x:Uid="SettingsPageChinesePreferenceTToS" />
                            </ComboBox>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Uid="SettingsPageLyricsFilter">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AppSettings.TranslationSettings.IsFilterEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Uid="SettingsPageLyricsAutoRetryCount">
                            <NumberBox
                                Maximum="10"
                                Minimum="1"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.AppSettings.GeneralSettings.MaxAutoRetryCount, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <!--  Last.fm  -->
                        <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Last.fm" />
                        <controls:SettingsExpander
                            Header="Last.fm"
                            HeaderIcon="{ui:BitmapIcon Source=ms-appx:///Assets/LastFM.png}"
                            IsExpanded="{x:Bind ViewModel.IsLastFmAuthenticated, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button
                                    x:Uid="SettingsPageLastFMAuth"
                                    Command="{x:Bind ViewModel.LastFmAuthCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsLastFmAuthenticated, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
                                <Button
                                    x:Uid="SettingsPageLastFMUnAuth"
                                    Command="{x:Bind ViewModel.LastFmUnAuthCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsLastFmAuthenticated, Mode=OneWay}" />
                            </StackPanel>
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard x:Uid="SettingsPageLastFMUsername" IsEnabled="{x:Bind ViewModel.IsLastFmAuthenticated, Mode=OneWay}">
                                    <local:ExternalLinkButton
                                        Padding="0"
                                        Content="{x:Bind ViewModel.LastFmUser.Name, Mode=OneWay}"
                                        NavigateUri="{x:Bind ViewModel.LastFmUser.Url, Mode=OneWay}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Uid="SettingsPageLastFMPlaycount" IsEnabled="{x:Bind ViewModel.IsLastFmAuthenticated, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.LastFmUser.PlayCount, Mode=OneWay}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Uid="SettingsPageLastFMRegistered" IsEnabled="{x:Bind ViewModel.IsLastFmAuthenticated, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.LastFmUser.UserRegisterTime.DateTime.ToLongDateString(), Mode=OneWay}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard IsEnabled="{x:Bind ViewModel.IsLastFmAuthenticated, Mode=OneWay}">
                                    <Button x:Uid="SettingsPageLastFMRefresh" Command="{x:Bind ViewModel.LastFmRefreshCommand}" />
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>

                        <!--  Discord  -->
                        <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Discord" />
                        <controls:SettingsExpander
                            Header="Discord"
                            HeaderIcon="{ui:BitmapIcon Source=ms-appx:///Assets/Discord.png}"
                            IsExpanded="{x:Bind ViewModel.IsDiscordConnected, Mode=OneWay}">
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard x:Uid="SettingsPageDiscordUsername" IsEnabled="{x:Bind ViewModel.IsDiscordConnected, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.DiscordUsername, Mode=OneWay}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Uid="SettingsPageDiscordAlbumArtSource" IsEnabled="{x:Bind ViewModel.IsDiscordConnected, Mode=OneWay}">
                                    <ComboBox SelectedIndex="{x:Bind ViewModel.AppSettings.DiscordSettings.AlbumArtSource, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                                        <ComboBoxItem x:Uid="DiscordAlbumArtSourceNone" />
                                        <ComboBoxItem Content="iTunes" />
                                        <ComboBoxItem Content="酷狗音乐" />
                                    </ComboBox>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>

                        <!--  amll-ttml-db  -->
                        <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="amll-ttml-db" />
                        <controls:SettingsCard x:Uid="SettingsPageAmllTtmlDbBaseUrl">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    Text="{x:Bind ViewModel.AppSettings.GeneralSettings.AmllTtmlDbBaseUrl, Mode=TwoWay}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.SaveAmllTtmlDbBaseUrlCommand}"
                                    Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                          FontSize=12,
                                                          Glyph=&#xE8FB;}"
                                    Style="{ThemeResource GhostButtonStyle}" />
                            </Grid>
                        </controls:SettingsCard>

                        <!--  Apple Music token  -->
                        <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Apple Music media-user-token" />
                        <Grid
                            Padding="16"
                            ColumnSpacing="6"
                            Style="{StaticResource CardGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                PlaceholderText="media-user-token"
                                Text="{x:Bind ViewModel.AppleMusicMediaUserToken, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                            <local:ExternalLinkButton
                                x:Uid="Help"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                NavigateUri="{x:Bind constants1:Link.AppleMusicCfg}" />
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.SaveAppleMusicMediaUserTokenCommand}"
                                Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                      FontSize=12,
                                                      Glyph=&#xE8FB;}"
                                Style="{ThemeResource GhostButtonStyle}" />
                        </Grid>
                        <InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="USE AT YOUR OWN RISK"
                            Severity="Warning" />

                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

    </Grid>

</UserControl>