<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.ForegroundOverlaySettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="using:BetterLyrics.WinUI3.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer Style="{StaticResource SettingsScrollViewerStyle}">
            <Grid Style="{StaticResource SettingsGridStyle}">
                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

                    <!--  雪花  -->
                    <controls:SettingsExpander x:Uid="SettingsPageSnowFlakeLayer" HeaderIcon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xEDAD;}">
                        <ToggleSwitch IsOn="{x:Bind LyricsBackgroundSettings.IsSnowFlakeOverlayEnabled, Mode=TwoWay}" />
                        <controls:SettingsExpander.Items>

                            <controls:SettingsCard x:Uid="SettingsPageAmount" IsEnabled="{x:Bind LyricsBackgroundSettings.IsSnowFlakeOverlayEnabled, Mode=OneWay}">
                                <uc:ExtendedSlider
                                    Maximum="10"
                                    Minimum="0"
                                    ResetButtonVisibility="Collapsed"
                                    Value="{x:Bind LyricsBackgroundSettings.SnowFlakeOverlayAmount, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard x:Uid="SettingsPageSpeed" IsEnabled="{x:Bind LyricsBackgroundSettings.IsSnowFlakeOverlayEnabled, Mode=OneWay}">
                                <uc:ExtendedSlider
                                    Maximum="10"
                                    Minimum="1"
                                    ResetButtonVisibility="Collapsed"
                                    Value="{x:Bind LyricsBackgroundSettings.SnowFlakeOverlaySpeed, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard x:Uid="SettingsPageSpectrumBrethingEffect" IsEnabled="{x:Bind LyricsBackgroundSettings.IsSnowFlakeOverlayEnabled, Mode=OneWay}">
                                <ToggleSwitch IsOn="{x:Bind LyricsBackgroundSettings.IsSnowFlakeOverlayBrethingEffectEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard x:Uid="SettingsPageSpectrumBreathingIntensity" IsEnabled="{x:Bind LyricsBackgroundSettings.IsSnowFlakeOverlayEnabled, Mode=OneWay}">
                                <uc:ExtendedSlider
                                    Default="80"
                                    Maximum="200"
                                    Minimum="0"
                                    Unit="%"
                                    Value="{x:Bind LyricsBackgroundSettings.SnowFlakeOverlayBreathingIntensity, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard x:Uid="SettingsPageParallaxTilt" IsEnabled="{x:Bind LyricsBackgroundSettings.IsSnowFlakeOverlayEnabled, Mode=OneWay}">
                                <ToggleSwitch IsOn="{x:Bind LyricsBackgroundSettings.IsSnowFlakeOverlayParallaxEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard>

                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!--  Fog  -->
                    <controls:SettingsExpander x:Uid="SettingsPageFogLayer" HeaderIcon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xEA91;}">
                        <ToggleSwitch IsOn="{x:Bind LyricsBackgroundSettings.IsFogOverlayEnabled, Mode=TwoWay}" />
                        <controls:SettingsExpander.Items>

                            <controls:SettingsCard x:Uid="SettingsPageSpectrumBrethingEffect" IsEnabled="{x:Bind LyricsBackgroundSettings.IsFogOverlayEnabled, Mode=OneWay}">
                                <ToggleSwitch IsOn="{x:Bind LyricsBackgroundSettings.IsFogOverlayBrethingEffectEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard x:Uid="SettingsPageSpectrumBreathingIntensity" IsEnabled="{x:Bind LyricsBackgroundSettings.IsFogOverlayEnabled, Mode=OneWay}">
                                <uc:ExtendedSlider
                                    Default="80"
                                    Maximum="200"
                                    Minimum="0"
                                    Unit="%"
                                    Value="{x:Bind LyricsBackgroundSettings.FogOverlayBreathingIntensity, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard x:Uid="SettingsPageParallaxTilt" IsEnabled="{x:Bind LyricsBackgroundSettings.IsFogOverlayEnabled, Mode=OneWay}">
                                <ToggleSwitch IsOn="{x:Bind LyricsBackgroundSettings.IsFogOverlayParallaxEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard>

                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!--  雨滴  -->
                    <controls:SettingsExpander x:Uid="SettingsPageRaindropLayer" HeaderIcon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xEB42;}">
                        <ToggleSwitch IsOn="{x:Bind LyricsBackgroundSettings.IsRaindropOverlayEnabled, Mode=TwoWay}" />
                        <controls:SettingsExpander.Items>

                            <controls:SettingsCard x:Uid="SettingsPageSpeed" IsEnabled="{x:Bind LyricsBackgroundSettings.IsRaindropOverlayEnabled, Mode=OneWay}">
                                <uc:ExtendedSlider
                                    Default="100"
                                    Maximum="100"
                                    Minimum="0"
                                    Unit="%"
                                    Value="{x:Bind LyricsBackgroundSettings.RaindropSpeed, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard x:Uid="SettingsPageSize" IsEnabled="{x:Bind LyricsBackgroundSettings.IsRaindropOverlayEnabled, Mode=OneWay}">
                                <uc:ExtendedSlider
                                    Default="100"
                                    Maximum="100"
                                    Minimum="1"
                                    Unit="%"
                                    Value="{x:Bind LyricsBackgroundSettings.RaindropSize, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard x:Uid="SettingsPageDensity" IsEnabled="{x:Bind LyricsBackgroundSettings.IsRaindropOverlayEnabled, Mode=OneWay}">
                                <uc:ExtendedSlider
                                    Default="40"
                                    Maximum="100"
                                    Minimum="1"
                                    Unit="%"
                                    Value="{x:Bind LyricsBackgroundSettings.RaindropDensity, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard x:Uid="SettingsPageLightAngle" IsEnabled="{x:Bind LyricsBackgroundSettings.IsRaindropOverlayEnabled, Mode=OneWay}">
                                <uc:ExtendedSlider
                                    Default="135"
                                    Maximum="180"
                                    Minimum="0"
                                    Unit="°"
                                    Value="{x:Bind LyricsBackgroundSettings.RaindropLightAngle, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard x:Uid="SettingsPageShadowIntensity" IsEnabled="{x:Bind LyricsBackgroundSettings.IsRaindropOverlayEnabled, Mode=OneWay}">
                                <uc:ExtendedSlider
                                    Default="0"
                                    Maximum="100"
                                    Minimum="0"
                                    Unit="°"
                                    Value="{x:Bind LyricsBackgroundSettings.RaindropShadowIntensity, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard x:Uid="SettingsPageSpectrumBrethingEffect" IsEnabled="{x:Bind LyricsBackgroundSettings.IsRaindropOverlayEnabled, Mode=OneWay}">
                                <ToggleSwitch IsOn="{x:Bind LyricsBackgroundSettings.IsRaindropOverlayBrethingEffectEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard x:Uid="SettingsPageSpectrumBreathingIntensity" IsEnabled="{x:Bind LyricsBackgroundSettings.IsRaindropOverlayEnabled, Mode=OneWay}">
                                <uc:ExtendedSlider
                                    Default="80"
                                    Maximum="200"
                                    Minimum="0"
                                    Unit="%"
                                    Value="{x:Bind LyricsBackgroundSettings.RaindropOverlayBreathingIntensity, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard x:Uid="SettingsPageParallaxTilt" IsEnabled="{x:Bind LyricsBackgroundSettings.IsRaindropOverlayEnabled, Mode=OneWay}">
                                <ToggleSwitch IsOn="{x:Bind LyricsBackgroundSettings.IsRaindropOverlayParallaxEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard>

                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!--  语义特效  -->
                    <controls:SettingsCard x:Uid="SettingsPageSemanticEffects" HeaderIcon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xE8C0;}">
                        <ToggleSwitch IsOn="{x:Bind LyricsBackgroundSettings.IsSemanticEffectEnabled, Mode=TwoWay}" />
                    </controls:SettingsCard>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>