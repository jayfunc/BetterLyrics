<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.AmbientBackgroundControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <canvas:CanvasAnimatedControl
        x:Name="AnimatedCanvas"
        ClearColor="Black"
        CreateResources="AnimatedCanvas_CreateResources"
        Draw="AnimatedCanvas_Draw"
        Unloaded="AnimatedCanvas_Unloaded"
        Update="AnimatedCanvas_Update" />
</UserControl>
