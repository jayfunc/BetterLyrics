<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.LyricsSearchControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:BetterLyrics.WinUI3.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="using:BetterLyrics.Core.Models.Entities"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:BetterLyrics.WinUI3.Controls"
    xmlns:lyrics="using:BetterLyrics.Core.Models.Lyrics"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:LyricsTrackTypeToNameConverter x:Key="LyricsTrackTypeToNameConverter" />
    </UserControl.Resources>

    <Grid Padding="16" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  映射  -->
            <Grid Grid.Column="0">
                <ScrollViewer Padding="0,0,10,0">
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Uid="LyricsSearchControlSongInfoMapping" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                            <Button
                                Margin="6,26,0,0"
                                Command="{x:Bind ViewModel.CopySearchLinkCommand}"
                                Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                      FontSize=16,
                                                      Glyph=&#xE71B;}"
                                Style="{ThemeResource GhostButtonStyle}">
                                <ToolTipService.ToolTip>
                                    <ToolTip x:Uid="LyricsSearchControlCopySearchLink" />
                                </ToolTipService.ToolTip>
                            </Button>
                        </StackPanel>

                        <Grid Padding="16" Style="{StaticResource CardGridStyle}">
                            <StackPanel Spacing="6">

                                <local:PropertyRow x:Uid="LyricsSearchControlTitle" Value="{x:Bind ViewModel.MappedSongSearchQuery.OriginalTitle, Mode=OneWay}" />

                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Uid="LyricsSearchControlMappedAs"
                                        Grid.Column="0"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        x:Name="MappedTitleTextBox"
                                        Grid.Column="1"
                                        Text="{x:Bind ViewModel.MappedSongSearchQuery.MappedTitle, Mode=TwoWay}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Click="ConvertMappedTitleToKanjiButton_Click"
                                        Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                              FontSize=12,
                                                              Glyph=&#xE8AB;}"
                                        Style="{ThemeResource GhostButtonStyle}">
                                        <ToolTipService.ToolTip>
                                            <ToolTip>
                                                <TextBlock x:Uid="LyricsSearchControlConvertToKanji" />
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </Button>
                                    <Button
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.ResetMappedTitleCommand}"
                                        Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                              FontSize=12,
                                                              Glyph=&#xE777;}"
                                        Style="{ThemeResource GhostButtonStyle}" />
                                </Grid>

                            </StackPanel>
                        </Grid>

                        <Grid Padding="16" Style="{StaticResource CardGridStyle}">
                            <StackPanel Spacing="6">

                                <local:PropertyRow x:Uid="LyricsSearchControlArtist" Value="{x:Bind ViewModel.MappedSongSearchQuery.OriginalArtist, Mode=OneWay}" />

                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Uid="LyricsSearchControlMappedAs"
                                        Grid.Column="0"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        x:Name="MappedArtistTextBox"
                                        Grid.Column="1"
                                        Text="{x:Bind ViewModel.MappedSongSearchQuery.MappedArtist, Mode=TwoWay}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Click="ConvertMappedArtistToKanjiButton_Click"
                                        Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                              FontSize=12,
                                                              Glyph=&#xE8AB;}"
                                        Style="{ThemeResource GhostButtonStyle}">
                                        <ToolTipService.ToolTip>
                                            <ToolTip>
                                                <TextBlock x:Uid="LyricsSearchControlConvertToKanji" />
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </Button>
                                    <Button
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.ResetMappedArtistCommand}"
                                        Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                              FontSize=12,
                                                              Glyph=&#xE777;}"
                                        Style="{ThemeResource GhostButtonStyle}" />
                                </Grid>

                            </StackPanel>
                        </Grid>

                        <Grid Padding="16" Style="{StaticResource CardGridStyle}">
                            <StackPanel Spacing="6">

                                <local:PropertyRow x:Uid="LyricsSearchControlAlbum" Value="{x:Bind ViewModel.MappedSongSearchQuery.OriginalAlbum, Mode=OneWay}" />

                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Uid="LyricsSearchControlMappedAs"
                                        Grid.Column="0"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        x:Name="MappedAlbumTextBox"
                                        Grid.Column="1"
                                        Text="{x:Bind ViewModel.MappedSongSearchQuery.MappedAlbum, Mode=TwoWay}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Click="ConvertMappedAlbumToKanjiButton_Click"
                                        Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                              FontSize=12,
                                                              Glyph=&#xE8AB;}"
                                        Style="{ThemeResource GhostButtonStyle}">
                                        <ToolTipService.ToolTip>
                                            <ToolTip>
                                                <TextBlock x:Uid="LyricsSearchControlConvertToKanji" />
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </Button>
                                    <Button
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.ResetMappedAlbumCommand}"
                                        Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                              FontSize=12,
                                                              Glyph=&#xE777;}"
                                        Style="{ThemeResource GhostButtonStyle}" />
                                </Grid>

                            </StackPanel>
                        </Grid>

                        <Grid Padding="16" Style="{StaticResource CardGridStyle}">
                            <local:PropertyRow x:Uid="LyricsSearchControlDurauion" Value="{x:Bind ViewModel.GsmtcService.CurrentSongInfo.Duration, Converter={StaticResource SecondsToFormattedTimeConverter}, TargetNullValue=N/A, Mode=OneWay}" />
                        </Grid>

                        <Button
                            x:Uid="LyricsSearchControlSearch"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.SearchCommand}"
                            IsEnabled="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                            Style="{ThemeResource AccentButtonStyle}" />

                        <controls:SettingsCard x:Uid="LyricsSearchControlMarkAsPureMusic">
                            <CheckBox MinWidth="20" IsChecked="{x:Bind ViewModel.MappedSongSearchQuery.IsMarkedAsPureMusic, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Uid="LyricsSearchControlIgnoreCache">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AppSettings.GeneralSettings.IgnoreCacheWhenSearching, Mode=TwoWay}" />
                        </controls:SettingsCard>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <!--  词源一览  -->
            <Grid Grid.Column="1">
                <ListView
                    Padding="0,0,10,0"
                    ItemContainerStyle="{ThemeResource ListViewCardStyle}"
                    ItemsSource="{x:Bind ViewModel.LyricsSearchResults, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedLyricsSearchResult, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="entities:LyricsCacheItem">
                            <ListViewItem>
                                <Grid Padding="12,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <!--  Lyrics source provider  -->
                                    <Grid
                                        Grid.Row="0"
                                        Margin="-8,0,0,0"
                                        ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <local:PropertyRow
                                            IsEnabled="{x:Bind IsFound, Mode=OneWay}"
                                            Link="{x:Bind Reference, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind Reference, TargetNullValue=N/A, Mode=OneWay}"
                                            Value="{x:Bind Provider, Mode=OneWay, Converter={StaticResource LyricsProviderToDisplayNameConverter}}" />
                                        <FontIcon
                                            Grid.Column="1"
                                            Margin="0,2,0,0"
                                            FontFamily="{StaticResource SegoeFluentIcons}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE74C;"
                                            Visibility="{x:Bind IsPlugin, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <controls:WrapPanel
                                            Grid.Column="2"
                                            HorizontalSpacing="4"
                                            VerticalSpacing="4"
                                            Visibility="{x:Bind IsFound, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                                            <!--  Word-By-Word Indicator  -->
                                            <local:InfoTag
                                                Glyph="&#xE916;"
                                                IsEnabled="{x:Bind IsWordByWord, Mode=OneWay}"
                                                Theme="{x:Bind local:LyricsSearchControl.GetInfoTagTheme(IsWordByWord), Mode=OneWay}">
                                                <ToolTipService.ToolTip>
                                                    <TextBlock x:Uid="LyricsSearchControlWordByWord" />
                                                </ToolTipService.ToolTip>
                                            </local:InfoTag>

                                            <!--  Translation Indicator  -->
                                            <local:InfoTag
                                                Glyph="&#xE8C1;"
                                                IsEnabled="{x:Bind IsTranslationNotAvailable, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                                Theme="{x:Bind local:LyricsSearchControl.GetInfoTagTheme(IsTranslationIntrinsic), Mode=OneWay}">
                                                <ToolTipService.ToolTip>
                                                    <TextBlock x:Uid="LyricsSearchControlTranslationAvailable" />
                                                </ToolTipService.ToolTip>
                                            </local:InfoTag>

                                            <!--  Transliteration Indicator  -->
                                            <local:InfoTag
                                                Glyph="&#xE8D2;"
                                                IsEnabled="{x:Bind IsTransliterationNotAvailable, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                                Theme="{x:Bind local:LyricsSearchControl.GetInfoTagTheme(IsTransliterationIntrinsic), Mode=OneWay}">
                                                <ToolTipService.ToolTip>
                                                    <TextBlock x:Uid="LyricsSearchControlTransliterationAvailable" />
                                                </ToolTipService.ToolTip>
                                            </local:InfoTag>

                                        </controls:WrapPanel>

                                    </Grid>
                                    <!--  Lyrics search result  -->
                                    <StackPanel Grid.Row="1" Opacity="{x:Bind IsFound, Converter={StaticResource BoolToOpacityConverter}, Mode=OneWay}">
                                        <local:PropertyRow x:Uid="SettingsPageSongTitle" Value="{x:Bind Title, TargetNullValue=N/A, Mode=OneWay}" />
                                        <local:PropertyRow x:Uid="SettingsPageArtist" Value="{x:Bind Artist, TargetNullValue=N/A, Mode=OneWay}" />
                                        <local:PropertyRow x:Uid="SettingsPageAlbum" Value="{x:Bind Album, TargetNullValue=N/A, Mode=OneWay}" />
                                        <local:PropertyRow x:Uid="LyricsSearchControlDurauion" Value="{x:Bind Duration, Converter={StaticResource SecondsToFormattedTimeConverter}, TargetNullValue=N/A, Mode=OneWay}" />
                                        <local:PropertyRow
                                            x:Uid="LyricsPageMatchPercentage"
                                            Unit="%"
                                            Value="{x:Bind MatchPercentage, Mode=OneWay}" />
                                    </StackPanel>
                                    <!--  NOT FOUND  -->
                                    <StackPanel
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Opacity="{x:Bind IsSearching, Converter={StaticResource BoolNegationToOpacityConverter}, Mode=OneWay}"
                                        Spacing="6"
                                        Visibility="{x:Bind IsFound, Converter={StaticResource BoolNegationToVisibilityConverter}, Mode=OneWay}">
                                        <Image MaxWidth="48" Source="/Assets/Empty.png" />
                                        <TextBlock x:Uid="LyricsSearchControlNotFound" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <!--  Searching  -->
                                    <Grid Grid.Row="1" Visibility="{x:Bind IsSearching, Mode=OneWay}">
                                        <ProgressRing VerticalAlignment="Center" IsActive="{x:Bind IsSearching, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </ListViewItem>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <interactivity:Interaction.Behaviors>
                        <interactivity:DataTriggerBehavior
                            Binding="{x:Bind ViewModel.LyricsSearchResults.Count, Mode=OneWay}"
                            ComparisonCondition="Equal"
                            Value="0">
                            <interactivity:ChangePropertyAction PropertyName="Visibility" Value="Collapsed" />
                        </interactivity:DataTriggerBehavior>
                        <interactivity:DataTriggerBehavior
                            Binding="{x:Bind ViewModel.LyricsSearchResults.Count, Mode=OneWay}"
                            ComparisonCondition="NotEqual"
                            Value="0">
                            <interactivity:ChangePropertyAction PropertyName="Visibility" Value="Visible" />
                        </interactivity:DataTriggerBehavior>
                    </interactivity:Interaction.Behaviors>
                </ListView>
                <StackPanel
                    Padding="0,36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <Image MaxWidth="100" Source="/Assets/Empty.png" />
                    <interactivity:Interaction.Behaviors>
                        <interactivity:DataTriggerBehavior
                            Binding="{x:Bind ViewModel.LyricsSearchResults.Count, Mode=OneWay}"
                            ComparisonCondition="NotEqual"
                            Value="0">
                            <interactivity:ChangePropertyAction PropertyName="Visibility" Value="Collapsed" />
                        </interactivity:DataTriggerBehavior>
                        <interactivity:DataTriggerBehavior
                            Binding="{x:Bind ViewModel.LyricsSearchResults.Count, Mode=OneWay}"
                            ComparisonCondition="Equal"
                            Value="0">
                            <interactivity:ChangePropertyAction PropertyName="Visibility" Value="Visible" />
                        </interactivity:DataTriggerBehavior>
                    </interactivity:Interaction.Behaviors>
                </StackPanel>
                <ProgressBar
                    VerticalAlignment="Top"
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsSearching, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
            </Grid>
            <!--  歌词内容  -->
            <Grid Grid.Column="2">
                <Grid>
                    <interactivity:Interaction.Behaviors>
                        <interactivity:DataTriggerBehavior
                            Binding="{x:Bind ViewModel.LyricsDataArr, Mode=OneWay}"
                            ComparisonCondition="Equal"
                            Value="{x:Null}">
                            <interactivity:ChangePropertyAction PropertyName="Visibility" Value="Collapsed" />
                        </interactivity:DataTriggerBehavior>
                        <interactivity:DataTriggerBehavior
                            Binding="{x:Bind ViewModel.LyricsDataArr, Mode=OneWay}"
                            ComparisonCondition="NotEqual"
                            Value="{x:Null}">
                            <interactivity:ChangePropertyAction PropertyName="Visibility" Value="Visible" />
                        </interactivity:DataTriggerBehavior>
                    </interactivity:Interaction.Behaviors>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ComboBox
                        x:Name="TracksComboBox"
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.LyricsDataArr, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedTrackIndex, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="lyrics:LyricsData">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind TrackType, Mode=OneWay, Converter={StaticResource LyricsTrackTypeToNameConverter}}" />
                                    <local:InfoTag Text="{x:Bind LanguageTag, Mode=OneWay, Converter={StaticResource LanguageTagToDisplayedNameConverter}}" />
                                    <local:InfoTag
                                        x:Uid="LyricsSearchControlWordByWord"
                                        Theme="Accent"
                                        Visibility="{x:Bind IsWordByWord, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                    <Grid Visibility="{x:Bind HasProvider, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                        <local:InfoTag Text="{x:Bind Provider, Mode=OneWay, Converter={StaticResource LyricsProviderToDisplayNameConverter}}" Visibility="{x:Bind IsProviderSameAsOriginal, Mode=OneWay, Converter={StaticResource BoolNegationToVisibilityConverter}}" />
                                        <local:InfoTag
                                            Text="{x:Bind Provider, Mode=OneWay, Converter={StaticResource LyricsProviderToDisplayNameConverter}}"
                                            Theme="Accent"
                                            Visibility="{x:Bind IsProviderSameAsOriginal, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ListView
                        Grid.Row="1"
                        Margin="6,6,6,0"
                        ItemContainerStyle="{ThemeResource ListViewStretchedItemContainerStyle}"
                        ItemsSource="{Binding SelectedItem.LyricsLines, ElementName=TracksComboBox}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="lyrics:LyricsLine">
                                <Grid Margin="0,6" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBlock Foreground="{ThemeResource SystemFillColorNeutralBrush}" Text="{x:Bind StartMs, Mode=OneWay, Converter={StaticResource MillisecondsToFormattedTimeConverter}}" />
                                        <Button
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Click="PlayLyricsLineButton_Click"
                                            Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                                  FontSize=16,
                                                                  Glyph=&#xE768;}"
                                            Opacity="0"
                                            Style="{ThemeResource AccentButtonStyle}">
                                            <Button.OpacityTransition>
                                                <ScalarTransition />
                                            </Button.OpacityTransition>
                                            <interactivity:Interaction.Behaviors>
                                                <interactivity:EventTriggerBehavior EventName="PointerEntered">
                                                    <interactivity:ChangePropertyAction PropertyName="Opacity" Value="1" />
                                                </interactivity:EventTriggerBehavior>
                                                <interactivity:EventTriggerBehavior EventName="PointerExited">
                                                    <interactivity:ChangePropertyAction PropertyName="Opacity" Value="0" />
                                                </interactivity:EventTriggerBehavior>
                                            </interactivity:Interaction.Behaviors>
                                        </Button>
                                    </Grid>
                                    <local:PropertyRow Grid.Column="1" Value="{x:Bind PrimaryText, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <StackPanel
                    Padding="0,36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <Image MaxWidth="100" Source="/Assets/Page.png" />
                    <interactivity:Interaction.Behaviors>
                        <interactivity:DataTriggerBehavior
                            Binding="{x:Bind ViewModel.LyricsDataArr, Mode=OneWay}"
                            ComparisonCondition="NotEqual"
                            Value="{x:Null}">
                            <interactivity:ChangePropertyAction PropertyName="Visibility" Value="Collapsed" />
                        </interactivity:DataTriggerBehavior>
                        <interactivity:DataTriggerBehavior
                            Binding="{x:Bind ViewModel.LyricsDataArr, Mode=OneWay}"
                            ComparisonCondition="Equal"
                            Value="{x:Null}">
                            <interactivity:ChangePropertyAction PropertyName="Visibility" Value="Visible" />
                        </interactivity:DataTriggerBehavior>
                    </interactivity:Interaction.Behaviors>
                </StackPanel>
            </Grid>
        </Grid>
        <!--  操作栏  -->
        <Grid Grid.Row="1" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Uid="LyricsSearchControlHelp"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <Button
                x:Uid="LyricsSearchControlReset"
                Grid.Column="2"
                Command="{x:Bind ViewModel.ResetCommand}" />
            <Button
                x:Uid="LyricsSearchControlSaveChanges"
                Grid.Column="3"
                Command="{x:Bind ViewModel.SaveCommand}"
                Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>