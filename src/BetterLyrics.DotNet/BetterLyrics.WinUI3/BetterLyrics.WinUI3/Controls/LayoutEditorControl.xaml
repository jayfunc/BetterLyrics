<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.LayoutEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BetterLyrics.WinUI3.Models"
    xmlns:models1="using:BetterLyrics.Core.Models"
    xmlns:uc="using:BetterLyrics.WinUI3.Controls"
    IsTabStop="True"
    PreviewKeyDown="UserControl_PreviewKeyDown"
    PreviewKeyUp="UserControl_PreviewKeyUp"
    mc:Ignorable="d">

    <UserControl.Resources>

        <DataTemplate x:Key="RowHeaderTemplate" x:DataType="models:HeaderItemModel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    Height="{x:Bind ItemSize, Mode=OneWay}"
                    Style="{ThemeResource CardGridStyle}"
                    Tapped="Gutter_Tapped">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="Bottom" ShouldConstrainToRootBounds="False">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>

                            <StackPanel Width="250" Spacing="4">

                                <StackPanel Spacing="4">

                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{x:Bind Parent.InsertRowActionCommand}"
                                        CommandParameter="{x:Bind Index}"
                                        Style="{ThemeResource GhostButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon FontSize="16" Glyph="&#xE109;" />
                                            <TextBlock x:Uid="LayoutEditorControlInsertRowBefore" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{x:Bind Parent.InsertRowAfterActionCommand}"
                                        CommandParameter="{x:Bind Index}"
                                        Style="{ThemeResource GhostButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon FontSize="16" Glyph="&#xE109;" />
                                            <TextBlock x:Uid="LayoutEditorControlInsertRowAfter" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{x:Bind Parent.DeleteRowActionCommand}"
                                        CommandParameter="{x:Bind Index}"
                                        IsEnabled="{x:Bind CanDelete}"
                                        Style="{ThemeResource GhostButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon FontSize="16" Glyph="&#xE107;" />
                                            <TextBlock x:Uid="LayoutEditorControlDeleteRow" />
                                        </StackPanel>
                                    </Button>

                                </StackPanel>

                                <Border
                                    Height="1"
                                    Margin="-12,0,-12,0"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <StackPanel Padding="4" Spacing="4">
                                    <TextBlock
                                        x:Uid="LayoutEditorControlAdjustRowHeight"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Grid
                                        x:Name="SizeEditorGrid"
                                        ColumnSpacing="4"
                                        Loaded="SizeEditorGrid_Loaded">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>

                                        <uc:SafeNumberBox
                                            x:Name="SizeInputBox"
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Minimum="0" />
                                        <ComboBox
                                            x:Name="SizeTypeBox"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            SelectionChanged="SizeTypeBox_SelectionChanged">
                                            <ComboBoxItem Content="Auto" Tag="Auto" />
                                            <ComboBoxItem Content="*" Tag="*" />
                                            <ComboBoxItem Content="px" Tag="px" />
                                        </ComboBox>
                                    </Grid>

                                    <Button
                                        x:Uid="LayoutEditorControlApplySizeButton"
                                        HorizontalAlignment="Stretch"
                                        Click="ApplySizeFlyout_Click"
                                        Style="{ThemeResource AccentButtonStyle}" />

                                    <RichTextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap">
                                        <Paragraph>
                                            <Run FontWeight="SemiBold">Auto</Run>
                                            <Run x:Uid="LayoutEditorControlAutoDescription" />
                                            <LineBreak />
                                            <Run FontWeight="SemiBold">*</Run>
                                            <Run x:Uid="LayoutEditorControlStarDescription" />
                                            <LineBreak />
                                            <Run FontWeight="SemiBold">px</Run>
                                            <Run x:Uid="LayoutEditorControlPxDescription" />
                                        </Paragraph>
                                    </RichTextBlock>

                                </StackPanel>

                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{x:Bind Index}" />
                    </ToolTipService.ToolTip>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{x:Bind Index}" />
                </Grid>
                <Grid
                    Grid.Row="1"
                    Height="{x:Bind FollowingSpacing, Mode=OneWay}"
                    Background="Transparent" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ColumnHeaderTemplate" x:DataType="models:HeaderItemModel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid
                    Grid.Column="0"
                    Width="{x:Bind ItemSize, Mode=OneWay}"
                    Style="{ThemeResource CardGridStyle}"
                    Tapped="Gutter_Tapped">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="Right" ShouldConstrainToRootBounds="False">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>

                            <StackPanel Width="250" Spacing="4">

                                <StackPanel Spacing="4">

                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{x:Bind Parent.InsertColActionCommand}"
                                        CommandParameter="{x:Bind Index}"
                                        Style="{ThemeResource GhostButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon FontSize="16" Glyph="&#xE109;" />
                                            <TextBlock x:Uid="LayoutEditorControlInsertColBefore" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{x:Bind Parent.InsertColAfterActionCommand}"
                                        CommandParameter="{x:Bind Index}"
                                        Style="{ThemeResource GhostButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon FontSize="16" Glyph="&#xE109;" />
                                            <TextBlock x:Uid="LayoutEditorControlInsertColAfter" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{x:Bind Parent.DeleteColActionCommand}"
                                        CommandParameter="{x:Bind Index}"
                                        IsEnabled="{x:Bind CanDelete}"
                                        Style="{ThemeResource GhostButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon FontSize="16" Glyph="&#xE107;" />
                                            <TextBlock x:Uid="LayoutEditorControlDeleteCol" />
                                        </StackPanel>
                                    </Button>

                                </StackPanel>

                                <Border
                                    Height="1"
                                    Margin="-12,0,-12,0"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <StackPanel Padding="4" Spacing="4">

                                    <TextBlock
                                        x:Uid="LayoutEditorControlAdjustColumnWidth"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Grid
                                        x:Name="SizeEditorGrid"
                                        ColumnSpacing="4"
                                        Loaded="SizeEditorGrid_Loaded">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>

                                        <uc:SafeNumberBox
                                            x:Name="SizeInputBox"
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Minimum="0" />
                                        <ComboBox
                                            x:Name="SizeTypeBox"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            SelectionChanged="SizeTypeBox_SelectionChanged">
                                            <ComboBoxItem Content="Auto" Tag="Auto" />
                                            <ComboBoxItem Content="*" Tag="*" />
                                            <ComboBoxItem Content="px" Tag="px" />
                                        </ComboBox>
                                    </Grid>

                                    <Button
                                        x:Uid="LayoutEditorControlApplySizeButton"
                                        HorizontalAlignment="Stretch"
                                        Click="ApplySizeFlyout_Click"
                                        Style="{ThemeResource AccentButtonStyle}" />

                                    <RichTextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap">
                                        <Paragraph>
                                            <Run FontWeight="SemiBold">Auto</Run>
                                            <Run x:Uid="LayoutEditorControlAutoDescription" />
                                            <LineBreak />
                                            <Run FontWeight="SemiBold">*</Run>
                                            <Run x:Uid="LayoutEditorControlStarDescription" />
                                            <LineBreak />
                                            <Run FontWeight="SemiBold">px</Run>
                                            <Run x:Uid="LayoutEditorControlPxDescription" />
                                        </Paragraph>
                                    </RichTextBlock>

                                </StackPanel>

                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{x:Bind Index}" />
                    </ToolTipService.ToolTip>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{x:Bind Index}" />
                </Grid>
                <Grid
                    Grid.Column="1"
                    Width="{x:Bind FollowingSpacing, Mode=OneWay}"
                    Background="Transparent" />
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid
        Margin="36,0,36,36"
        ColumnSpacing="4"
        RowSpacing="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition MaxWidth="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:Segmented
                x:Name="PropertyTabSegmented"
                Grid.Row="0"
                HorizontalAlignment="Stretch"
                SelectedIndex="{x:Bind SelectedPropertyTabIndex, Mode=TwoWay}">
                <controls:SegmentedItem Tag="Canvas">
                    <controls:SegmentedItem.Content>
                        <TextBlock x:Uid="LayoutEditorControlCanvasSectionHeader" />
                    </controls:SegmentedItem.Content>
                </controls:SegmentedItem>
                <controls:SegmentedItem Tag="Component">
                    <controls:SegmentedItem.Content>
                        <TextBlock x:Uid="LayoutEditorControlSelectedComponentPropertiesHeader" />
                    </controls:SegmentedItem.Content>
                </controls:SegmentedItem>
            </controls:Segmented>

            <controls:SwitchPresenter Grid.Row="1" Value="{Binding SelectedItem.Tag, ElementName=PropertyTabSegmented}">
                <controls:Case Value="Canvas">
                    <ScrollViewer>
                        <Grid Style="{StaticResource CardGridStyle}">
                            <StackPanel Margin="16" Spacing="{StaticResource SettingsCardSpacing}">

                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <uc:SafeNumberBox
                                        x:Uid="LayoutEditorControlGlobalRowSpacingBox"
                                        Grid.Column="0"
                                        IsIntegerOnly="True"
                                        Minimum="0"
                                        PlaceholderText="0"
                                        Value="{x:Bind LayoutProfile.RowSpacing, Mode=TwoWay}" />
                                    <uc:SafeNumberBox
                                        x:Uid="LayoutEditorControlGlobalColSpacingBox"
                                        Grid.Column="1"
                                        IsIntegerOnly="True"
                                        Minimum="0"
                                        PlaceholderText="0"
                                        Value="{x:Bind LayoutProfile.ColumnSpacing, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock x:Uid="LayoutEditorControlCanvasPaddingTextBlock" Margin="0,8,0,0" />
                                <Grid
                                    HorizontalAlignment="Center"
                                    ColumnSpacing="4"
                                    RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <uc:SafeNumberBox
                                        x:Uid="LayoutEditorControlGlobalPadLeftBox"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        IsIntegerOnly="True"
                                        PlaceholderText="0"
                                        Value="{x:Bind LayoutProfile.PaddingLeft, Mode=TwoWay}" />

                                    <uc:SafeNumberBox
                                        x:Uid="LayoutEditorControlGlobalPadTopBox"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        IsIntegerOnly="True"
                                        PlaceholderText="0"
                                        Value="{x:Bind LayoutProfile.PaddingTop, Mode=TwoWay}" />

                                    <uc:SafeNumberBox
                                        x:Uid="LayoutEditorControlGlobalPadRightBox"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        IsIntegerOnly="True"
                                        PlaceholderText="0"
                                        Value="{x:Bind LayoutProfile.PaddingRight, Mode=TwoWay}" />

                                    <uc:SafeNumberBox
                                        x:Uid="LayoutEditorControlGlobalPadBottomBox"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        IsIntegerOnly="True"
                                        PlaceholderText="0"
                                        Value="{x:Bind LayoutProfile.PaddingBottom, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock
                                    x:Uid="LayoutEditorControlPendingComponentsTextBlock"
                                    Margin="0,8,0,0"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="LayoutEditorControlPendingComponentsDescriptionTextBlock"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <ListView
                                    x:Name="ToolboxList"
                                    ItemContainerStyle="{StaticResource ListViewCardStyle}"
                                    ItemsSource="{x:Bind AvailableToolboxItems, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models1:ToolboxItem">
                                            <Grid
                                                Margin="12,8"
                                                CanDrag="True"
                                                ColumnSpacing="8"
                                                DragStarting="ToolboxItem_DragStarting"
                                                DropCompleted="Common_DropCompleted">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Grid.Column="0"
                                                    FontFamily="{StaticResource SegoeFluentIcons}"
                                                    FontSize="16"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="{Binding ComponentType, Converter={StaticResource ComponentTypeToIconConverter}}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding DisplayName}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </controls:Case>
                <controls:Case Value="Component">
                    <ScrollViewer>
                        <Grid Style="{StaticResource CardGridStyle}">
                            <StackPanel
                                x:Name="PropertiesPanel"
                                Margin="16"
                                Spacing="{StaticResource SettingsCardSpacing}">
                                <TextBlock
                                    x:Name="SelectedComponentLabel"
                                    x:Uid="LayoutEditorControlSelectedComponentLabel"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}" />

                                <ContentControl
                                    x:Name="PropertiesContentContainer"
                                    HorizontalContentAlignment="Stretch"
                                    IsEnabled="{x:Bind HasSelection, Mode=OneWay}">
                                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <uc:SafeNumberBox
                                                x:Name="PropRowBox"
                                                x:Uid="LayoutEditorControlRowBox"
                                                Grid.Column="0"
                                                IsIntegerOnly="True"
                                                Maximum="{x:Bind MaxRowIndex, Mode=OneWay}"
                                                Minimum="0"
                                                PlaceholderText="0"
                                                Value="{x:Bind SelectedPlacement.Row, Mode=TwoWay}" />
                                            <uc:SafeNumberBox
                                                x:Name="PropColBox"
                                                x:Uid="LayoutEditorControlColBox"
                                                Grid.Column="1"
                                                IsIntegerOnly="True"
                                                Maximum="{x:Bind MaxColIndex, Mode=OneWay}"
                                                Minimum="0"
                                                PlaceholderText="0"
                                                Value="{x:Bind SelectedPlacement.Column, Mode=TwoWay}" />
                                        </Grid>

                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <uc:SafeNumberBox
                                                x:Name="PropRowSpanBox"
                                                x:Uid="LayoutEditorControlRowSpanBox"
                                                Grid.Column="0"
                                                DefaultValue="1"
                                                IsIntegerOnly="True"
                                                Maximum="{x:Bind MaxRowSpan, Mode=OneWay}"
                                                Minimum="1"
                                                PlaceholderText="1"
                                                Value="{x:Bind SelectedPlacement.RowSpan, Mode=TwoWay}" />
                                            <uc:SafeNumberBox
                                                x:Name="PropColSpanBox"
                                                x:Uid="LayoutEditorControlColSpanBox"
                                                Grid.Column="1"
                                                DefaultValue="1"
                                                IsIntegerOnly="True"
                                                Maximum="{x:Bind MaxColSpan, Mode=OneWay}"
                                                Minimum="1"
                                                PlaceholderText="1"
                                                Value="{x:Bind SelectedPlacement.ColumnSpan, Mode=TwoWay}" />
                                        </Grid>

                                        <TextBlock x:Uid="LayoutEditorControlMarginHeader" Margin="0,8,0,0" />
                                        <Grid
                                            HorizontalAlignment="Center"
                                            ColumnSpacing="4"
                                            RowSpacing="4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <uc:SafeNumberBox
                                                x:Uid="LayoutEditorControlMarginLeftBox"
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                PlaceholderText="0"
                                                Value="{x:Bind SelectedPlacement.MarginLeft, Mode=TwoWay}" />
                                            <uc:SafeNumberBox
                                                x:Uid="LayoutEditorControlMarginTopBox"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                PlaceholderText="0"
                                                Value="{x:Bind SelectedPlacement.MarginTop, Mode=TwoWay}" />
                                            <uc:SafeNumberBox
                                                x:Uid="LayoutEditorControlMarginRightBox"
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                PlaceholderText="0"
                                                Value="{x:Bind SelectedPlacement.MarginRight, Mode=TwoWay}" />
                                            <uc:SafeNumberBox
                                                x:Uid="LayoutEditorControlMarginBottomBox"
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                PlaceholderText="0"
                                                Value="{x:Bind SelectedPlacement.MarginBottom, Mode=TwoWay}" />
                                        </Grid>

                                        <TextBlock x:Uid="LayoutEditorControlSizeHeader" Margin="0,8,0,0" />
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox
                                                x:Name="PropWidthBox"
                                                x:Uid="SettingsPageWidth"
                                                Grid.Column="0"
                                                Minimum="0"
                                                PlaceholderText="0"
                                                Value="{x:Bind SelectedPlacement.Width, Mode=TwoWay}" />
                                            <ComboBox
                                                x:Name="PropWidthTypeBox"
                                                Grid.Column="1"
                                                Width="80"
                                                VerticalAlignment="Bottom"
                                                SelectionChanged="PropWidthTypeBox_SelectionChanged">
                                                <ComboBoxItem Content="Auto" Tag="Auto" />
                                                <ComboBoxItem Content="px" Tag="px" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox
                                                x:Name="PropHeightBox"
                                                x:Uid="SettingsPageHeight"
                                                Grid.Column="0"
                                                Minimum="0"
                                                PlaceholderText="0"
                                                Value="{x:Bind SelectedPlacement.Height, Mode=TwoWay}" />
                                            <ComboBox
                                                x:Name="PropHeightTypeBox"
                                                Grid.Column="1"
                                                Width="80"
                                                VerticalAlignment="Bottom"
                                                SelectionChanged="PropHeightTypeBox_SelectionChanged">
                                                <ComboBoxItem Content="Auto" Tag="Auto" />
                                                <ComboBoxItem Content="px" Tag="px" />
                                            </ComboBox>
                                        </Grid>

                                        <TextBlock x:Uid="LayoutEditorControlAlignmentHeader" Margin="0,8,0,0" />
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox
                                                x:Uid="LayoutEditorControlHorizontalAlignmentBox"
                                                Grid.Column="0"
                                                HorizontalAlignment="Stretch"
                                                SelectedIndex="{x:Bind SelectedPlacement.HorizontalAlignment, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                                                <ComboBoxItem x:Uid="LayoutEditorControlHorizontalAlignmentLeft" Tag="Left" />
                                                <ComboBoxItem x:Uid="LayoutEditorControlHorizontalAlignmentCenter" Tag="Center" />
                                                <ComboBoxItem x:Uid="LayoutEditorControlHorizontalAlignmentRight" Tag="Right" />
                                                <ComboBoxItem x:Uid="LayoutEditorControlHorizontalAlignmentStretch" Tag="Stretch" />
                                            </ComboBox>
                                            <ComboBox
                                                x:Uid="LayoutEditorControlVerticalAlignmentBox"
                                                Grid.Column="1"
                                                HorizontalAlignment="Stretch"
                                                SelectedIndex="{x:Bind SelectedPlacement.VerticalAlignment, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                                                <ComboBoxItem x:Uid="LayoutEditorControlVerticalAlignmentTop" Tag="Top" />
                                                <ComboBoxItem x:Uid="LayoutEditorControlVerticalAlignmentCenter" Tag="Center" />
                                                <ComboBoxItem x:Uid="LayoutEditorControlVerticalAlignmentBottom" Tag="Bottom" />
                                                <ComboBoxItem x:Uid="LayoutEditorControlVerticalAlignmentStretch" Tag="Stretch" />
                                            </ComboBox>
                                        </Grid>

                                        <Button
                                            x:Uid="LayoutEditorControlRemoveButton"
                                            Margin="0,16,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{x:Bind RemoveSelectedCommand}"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                    </StackPanel>
                                </ContentControl>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </controls:Case>
            </controls:SwitchPresenter>
        </Grid>

        <Grid
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,42,0"
            Padding="4"
            Style="{ThemeResource CardGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    Margin="8,0,0,0"
                    FontFamily="{StaticResource SegoeFluentIcons}"
                    FontSize="16"
                    Glyph="&#xE8AC;" />
                <TextBox
                    x:Uid="LayoutSettingsControlLayoutNameTextBox"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Text="{x:Bind LayoutProfile.Name, Mode=TwoWay}" />
            </Grid>

            <AppBarSeparator Grid.Column="1" />

            <ToggleButton
                x:Name="HandToolToggle"
                Grid.Column="2"
                Click="HandToolToggle_Click"
                Style="{ThemeResource GhostToggleButtonStyle}">
                <ToggleButton.Content>
                    <FontIcon
                        FontFamily="{StaticResource SegoeFluentIcons}"
                        FontSize="16"
                        Glyph="&#xECE9;" />
                </ToggleButton.Content>
                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="LayoutEditorControlHandToolToggle" />
                </ToolTipService.ToolTip>
            </ToggleButton>

            <Button
                Grid.Column="3"
                Click="ZoomIn_Click"
                Style="{ThemeResource GhostButtonStyle}">
                <Button.Content>
                    <FontIcon
                        FontFamily="{StaticResource SegoeFluentIcons}"
                        FontSize="16"
                        Glyph="&#xE8A3;" />
                </Button.Content>
                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="LayoutEditorControlZoomInButton" />
                </ToolTipService.ToolTip>
            </Button>
            <Button
                Grid.Column="4"
                Click="ZoomOut_Click"
                Style="{ThemeResource GhostButtonStyle}">
                <Button.Content>
                    <FontIcon
                        FontFamily="{StaticResource SegoeFluentIcons}"
                        FontSize="16"
                        Glyph="&#xE71F;" />
                </Button.Content>
                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="LayoutEditorControlZoomOutButton" />
                </ToolTipService.ToolTip>
            </Button>
            <Button
                Grid.Column="5"
                Click="ZoomReset_Click"
                Style="{ThemeResource GhostButtonStyle}">
                <Button.Content>
                    <FontIcon
                        FontFamily="{StaticResource SegoeFluentIcons}"
                        FontSize="16"
                        Glyph="&#xE740;" />
                </Button.Content>
                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="LayoutEditorControlZoomResetButton" />
                </ToolTipService.ToolTip>
            </Button>
            <TextBlock
                Grid.Column="6"
                Width="48"
                Margin="4,0,0,2"
                VerticalAlignment="Center"
                Text="{x:Bind FormatZoom(CurrentZoom), Mode=OneWay}" />

            <AppBarSeparator Grid.Column="7" />

            <Button
                x:Name="HelpButton"
                Grid.Column="8"
                Style="{ThemeResource GhostButtonStyle}">
                <Button.Content>
                    <FontIcon
                        FontFamily="{StaticResource SegoeFluentIcons}"
                        FontSize="16"
                        Glyph="&#xE897;" />
                </Button.Content>
                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="LayoutEditorControlHelpButton" />
                </ToolTipService.ToolTip>
                <Button.Flyout>
                    <Flyout Placement="Bottom" ShouldConstrainToRootBounds="False">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding" Value="20" />
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>

                        <StackPanel Spacing="16">
                            <TextBlock
                                x:Uid="LayoutEditorControlKeyboardShortcutsHeader"
                                FontSize="16"
                                FontWeight="Bold" />

                            <TextBlock
                                x:Uid="LayoutEditorControlCanvasNavigationHeader"
                                Margin="0,0,0,-8"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    x:Uid="LayoutEditorControlTemporaryActivateHandHeader"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    VerticalAlignment="Center" />
                                <uc:InfoTag
                                    x:Uid="LayoutEditorControlTemporaryActivateHandInfoTag"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right" />

                                <TextBlock
                                    x:Uid="LayoutEditorControlHorizontalScrollHeader"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    VerticalAlignment="Center" />
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <uc:InfoTag Text="Shift" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="+" />
                                    <uc:InfoTag x:Uid="LayoutEditorControlHorizontalScrollInfoTag" />
                                </StackPanel>

                                <TextBlock
                                    x:Uid="LayoutEditorControlZoomCanvasHeader"
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    VerticalAlignment="Center" />
                                <StackPanel
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <uc:InfoTag Text="Ctrl" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="+" />
                                    <uc:InfoTag x:Uid="LayoutEditorControlZoomCanvasInfoTag" />
                                </StackPanel>

                                <TextBlock
                                    x:Uid="LayoutEditorControlFocusComponentHeader"
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    VerticalAlignment="Center" />
                                <uc:InfoTag
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Text="F" />
                            </Grid>

                            <MenuFlyoutSeparator Margin="-20,0" />

                            <TextBlock
                                x:Uid="LayoutEditorControlComponentOperationHeader"
                                Margin="0,0,0,-8"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    x:Uid="LayoutEditorControlSelectNextComponentHeader"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    VerticalAlignment="Center" />
                                <uc:InfoTag
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Text="Tab" />

                                <TextBlock
                                    x:Uid="LayoutEditorControlSelectPrevComponentHeader"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    VerticalAlignment="Center" />
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <uc:InfoTag Text="Shift" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="+" />
                                    <uc:InfoTag Text="Tab" />
                                </StackPanel>

                                <TextBlock
                                    x:Uid="LayoutEditorControlMoveComponentHeader"
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    VerticalAlignment="Center" />
                                <uc:InfoTag
                                    x:Uid="LayoutEditorControlMoveComponentInfoTag"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right" />

                                <TextBlock
                                    x:Uid="LayoutEditorControlChangeComponentSpanHeader"
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    VerticalAlignment="Center" />
                                <StackPanel
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <uc:InfoTag Text="Shift" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="+" />
                                    <uc:InfoTag x:Uid="LayoutEditorControlChangeComponentSpanInfoTag" />
                                </StackPanel>

                                <TextBlock
                                    x:Uid="LayoutEditorControlDeleteComponentHeader"
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    VerticalAlignment="Center" />
                                <StackPanel
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <uc:InfoTag Text="Delete / Backspace" />
                                </StackPanel>
                            </Grid>

                            <MenuFlyoutSeparator Margin="-20,0" />

                            <uc:ExternalLinkButton
                                x:Uid="LayoutEditorControlLearnMoreLink"
                                Padding="0"
                                NavigateUri="https://betterlyrics.github.io/layout-editor" />

                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

        </Grid>

        <Grid
            Grid.Row="1"
            Grid.Column="1"
            ColumnSpacing="4"
            RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Style="{ThemeResource CardGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Uid="LayoutEditorControlColumnHeader"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Uid="LayoutEditorControlRowHeader"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    TextWrapping="Wrap" />

                <Line
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Stretch="Fill"
                    Stroke="{ThemeResource CardStrokeColorDefault}"
                    StrokeThickness="1"
                    X1="0"
                    X2="1"
                    Y1="0"
                    Y2="1" />
            </Grid>

            <ScrollViewer
                Grid.Row="0"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled">
                <ItemsControl
                    x:Name="ColHeadersItemsControl"
                    Margin="{x:Bind ScaledColPadding, Mode=OneWay}"
                    ItemTemplate="{StaticResource ColumnHeaderTemplate}"
                    ItemsSource="{x:Bind ColumnHeaderItems, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <ScrollViewer
                Grid.Row="1"
                Grid.Column="0"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled">
                <ItemsControl
                    x:Name="RowHeadersItemsControl"
                    Margin="{x:Bind ScaledRowPadding, Mode=OneWay}"
                    ItemTemplate="{StaticResource RowHeaderTemplate}"
                    ItemsSource="{x:Bind RowHeaderItems, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <ScrollViewer
                x:Name="PreviewScrollViewer"
                Grid.Row="1"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                MaxZoomFactor="5.0"
                MinZoomFactor="0.5"
                PointerCanceled="PreviewScrollViewer_PointerReleased"
                PointerMoved="PreviewScrollViewer_PointerMoved"
                PointerPressed="PreviewScrollViewer_PointerPressed"
                PointerReleased="PreviewScrollViewer_PointerReleased"
                SizeChanged="PreviewContainer_SizeChanged"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled"
                ViewChanged="PreviewScrollViewer_ViewChanged"
                ZoomMode="Enabled">

                <Grid
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    PointerWheelChanged="WheelInterceptor_PointerWheelChanged">

                    <Grid
                        x:Name="PreviewGrid"
                        AllowDrop="True"
                        DragOver="Common_DragOver"
                        Drop="Common_Drop"
                        Style="{ThemeResource CardGridStyle}" />

                </Grid>

            </ScrollViewer>

            <Border
                x:Name="MinimapContainer"
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Width="160"
                Height="160"
                Margin="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Visibility="Collapsed">
                <Viewbox Stretch="Uniform">
                    <Canvas
                        x:Name="MinimapCanvas"
                        Width="100"
                        Height="100"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        PointerCanceled="MinimapCanvas_PointerCanceled"
                        PointerMoved="MinimapCanvas_PointerMoved"
                        PointerPressed="MinimapCanvas_PointerPressed"
                        PointerReleased="MinimapCanvas_PointerReleased">

                        <Rectangle
                            x:Name="MinimapViewportBox"
                            Fill="{ThemeResource SystemAccentColor}"
                            Opacity="0.3"
                            Stroke="{ThemeResource SystemAccentColor}"
                            StrokeThickness="2" />
                    </Canvas>
                </Viewbox>
            </Border>
        </Grid>

        <Grid
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Padding="4"
            ColumnSpacing="4"
            Style="{ThemeResource CardGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Uid="LayoutEditorControlPlacedComponentsTextBlock"
                    Grid.Row="0"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Uid="LayoutEditorControlPlacedComponentsDescriptionTextBlock"
                    Grid.Row="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </Grid>
            <ListView
                Grid.Column="1"
                ItemsSource="{x:Bind LayoutProfile.Placements, Mode=OneWay}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled"
                SelectedItem="{x:Bind SelectedPlacement, Mode=TwoWay}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                FontFamily="{StaticResource SegoeFluentIcons}"
                                FontSize="16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{Binding ComponentType, Converter={StaticResource ComponentTypeToIconConverter}}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{Binding DisplayName}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

    </Grid>
</UserControl>