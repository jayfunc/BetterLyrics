<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.StoryPageTime"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <StackPanel
            Margin="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="24">
            <TextBlock
                x:Name="Text1"
                x:Uid="StoryPageTimeText1"
                FontSize="20"
                Foreground="White"
                Opacity="0" />

            <StackPanel
                x:Name="Panel1"
                Margin="0,16,0,16"
                Opacity="0">
                <TextBlock
                    x:Name="PeakHourTextBlock"
                    FontSize="64"
                    FontWeight="Bold"
                    Foreground="White" />
            </StackPanel>

            <TextBlock
                x:Name="Text2"
                x:Uid="StoryPageTimeText2"
                FontSize="24"
                Foreground="White"
                Opacity="0" />
            <TextBlock
                x:Name="Text3"
                x:Uid="StoryPageTimeText3"
                FontSize="20"
                Foreground="White"
                Opacity="0" />

            <StackPanel
                x:Name="Panel2"
                Margin="0,40,0,0"
                Opacity="0"
                Orientation="Horizontal">
                <TextBlock
                    x:Uid="StoryPageTimeText4"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Foreground="White"
                    Opacity="0.5" />
                <TextBlock
                    x:Name="QuietHourTextBlock"
                    Margin="8,0,8,0"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="White" />
                <TextBlock
                    x:Uid="StoryPageTimeText5"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Foreground="White"
                    Opacity="0.5" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
