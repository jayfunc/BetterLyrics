<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.LayoutSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:constants1="using:BetterLyrics.Core.Constants"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models1="using:BetterLyrics.Core.Models"
    xmlns:uc="using:BetterLyrics.WinUI3.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    x:Name="RootLayoutSettings"
    Loaded="RootLayoutSettings_Loaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="LayoutProfileDataTemplate" x:DataType="models1:LayoutProfile">
            <Grid>
                <Grid
                    Padding="6"
                    Background="Transparent"
                    RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <FontIcon
                        Grid.RowSpan="3"
                        Margin="0,0,12,0"
                        FontFamily="Segoe UI Symbol"
                        FontSize="16"
                        Glyph="&#x283F;"
                        Visibility="{x:Bind Mode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=999}" />
                    <TextBlock
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap">
                        <ToolTipService.ToolTip>
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                        </ToolTipService.ToolTip>
                    </TextBlock>
                    <uc:LayoutPreviewControl
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        LayoutProfile="{x:Bind}"
                        LyricsWindowStatus="{Binding ElementName=RootLayoutSettings, Path=LyricsWindowStatus, Mode=OneWay}" />
                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Button
                            Padding="6"
                            Click="ConfigButton_Click"
                            Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                  FontSize=16,
                                                  Glyph=&#xE90F;}"
                            Visibility="{x:Bind Mode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=999}">
                            <ToolTipService.ToolTip>
                                <TextBlock x:Uid="LyricsWindowSettingsControlLyricsWindowConfig" />
                            </ToolTipService.ToolTip>
                        </Button>
                        <Button Padding="6" Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, FontSize=16, Glyph=&#xE712;}">
                            <Button.Flyout>
                                <MenuBarItemFlyout Opened="MenuBarItemFlyout_Opened" ShouldConstrainToRootBounds="False">
                                    <MenuFlyoutItem x:Uid="SettingsPageCreateFromCurrent" Click="CopyMenuFlyoutItem_Click" />
                                    <MenuFlyoutItem x:Uid="LyricsWindowSettingsControlShare" Click="ExportMenuFlyoutItem_Click" />
                                    <MenuFlyoutItem
                                        x:Uid="SettingsPageDelete"
                                        Click="DeleteMenuFlyoutItem_Click"
                                        Visibility="{x:Bind Mode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=999}" />
                                    <MenuFlyoutSubItem x:Uid="LayoutSettingsControlViewAppliedLyricsWindow" />
                                </MenuBarItemFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
                <uc:DragIndicator Width="32" Visibility="{x:Bind Mode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=999}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>

        <Grid RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" />

            <ScrollViewer Grid.Row="1">
                <StackPanel Padding="36,0">
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        IsExpanded="True">
                        <Expander.Header>
                            <TextBlock x:Uid="LayoutSettingsControlSystemProfiles" />
                        </Expander.Header>
                        <ListView
                            x:Name="SystemProfilesListView"
                            AllowDrop="False"
                            CanDragItems="False"
                            CanReorderItems="False"
                            ItemContainerStyle="{ThemeResource ListViewCardStyle}"
                            ItemTemplate="{StaticResource LayoutProfileDataTemplate}"
                            ItemsSource="{x:Bind SystemProfiles, Mode=OneWay}"
                            SelectedItem="{x:Bind SelectedLayoutProfile, Mode=OneWay}"
                            SelectionChanged="SystemProfilesListView_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                    </Expander>
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        IsExpanded="True">
                        <Expander.Header>
                            <TextBlock x:Uid="LayoutSettingsControlCustomProfiles" />
                        </Expander.Header>
                        <Grid>
                            <ListView
                                x:Name="CustomProfilesListView"
                                AllowDrop="True"
                                CanDragItems="True"
                                CanReorderItems="True"
                                DragItemsCompleted="CustomProfilesListView_DragItemsCompleted"
                                ItemContainerStyle="{ThemeResource ListViewCardStyle}"
                                ItemTemplate="{StaticResource LayoutProfileDataTemplate}"
                                ItemsSource="{x:Bind CustomProfiles, Mode=OneWay}"
                                SelectedItem="{x:Bind SelectedLayoutProfile, Mode=OneWay}"
                                SelectionChanged="CustomProfilesListView_SelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                            </ListView>
                            <Grid Visibility="{x:Bind CustomProfiles.Count, Mode=OneWay, Converter={StaticResource IntNegationToVisibilityConverter}}">
                                <StackPanel
                                    Margin="0,24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                                    <Image MaxWidth="100" Source="/Assets/EmptyBox.png" />
                                    <TextBlock
                                        x:Uid="LayoutSettingsControlCustomProfilesEmpty"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Grid
                Grid.Row="2"
                Margin="36,20"
                ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Uid="SettingsPageLayoutConfigShareHint"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />

                <uc:ExternalLinkButton
                    x:Uid="SettingsPageShareHub"
                    Grid.Column="1"
                    NavigateUri="{x:Bind constants1:Link.LayoutsStore}" />

                <Button x:Uid="SettingsPageCreateFromTemplates" Grid.Column="2">
                    <Button.Flyout>
                        <MenuFlyout x:Name="CreateFromTemplatesMenuFlyout" ShouldConstrainToRootBounds="False" />
                    </Button.Flyout>
                </Button>

                <Button
                    x:Uid="SettingsPageImport"
                    Grid.Column="3"
                    Click="ImportButton_Click" />
            </Grid>

        </Grid>

        <uc:FloatSidePanel x:Name="ConfigPanel">
            <Grid>
                <uc:LayoutEditorControl LayoutProfile="{x:Bind EditingLayoutProfile, Mode=OneWay}" LyricsWindowStatus="{x:Bind LyricsWindowStatus, Mode=OneWay}" />
                <Button
                    Height="42"
                    Margin="0,0,36,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="BackButton_Click"
                    Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                          FontSize=16,
                                          Glyph=&#xE72B;}"
                    Style="{ThemeResource AccentButtonStyle}" />
            </Grid>
        </uc:FloatSidePanel>

    </Grid>

</UserControl>