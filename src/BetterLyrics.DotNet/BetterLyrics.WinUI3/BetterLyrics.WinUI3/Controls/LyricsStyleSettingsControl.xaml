<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.LyricsStyleSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BetterLyrics.WinUI3.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:BetterLyrics.Core.Models.Settings"
    xmlns:ui="using:CommunityToolkit.WinUI"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer Style="{StaticResource SettingsScrollViewerStyle}">
            <Grid Style="{StaticResource SettingsGridStyle}">
                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

                    <!--  Lyrics style  -->

                    <TextBlock x:Uid="SettingsPageLyricsStyle" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                    <controls:SettingsExpander x:Uid="SettingsPageLyricsAlignment" HeaderIcon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xE8E3;}">
                        <Grid>
                            <ComboBox
                                IsEnabled="{x:Bind LyricsWindowStatus.LyricsStyleSettings.UseInternalLyricsAlignment, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                SelectedIndex="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsAlignmentType, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}"
                                Visibility="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsLayoutOrientation, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=0, Mode=OneWay}">
                                <ComboBoxItem x:Uid="SettingsPageLeft" />
                                <ComboBoxItem x:Uid="SettingsPageCenter" />
                                <ComboBoxItem x:Uid="SettingsPageRight" />
                                <ComboBoxItem x:Uid="SettingsPageLeftRight" />
                            </ComboBox>
                            <ComboBox
                                IsEnabled="{x:Bind LyricsWindowStatus.LyricsStyleSettings.UseInternalLyricsAlignment, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                SelectedIndex="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsAlignmentType, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}"
                                Visibility="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsLayoutOrientation, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=1, Mode=OneWay}">
                                <ComboBoxItem x:Uid="SettingsPageTop" />
                                <ComboBoxItem x:Uid="SettingsPageCenter" />
                                <ComboBoxItem x:Uid="SettingsPageBottom" />
                                <ComboBoxItem x:Uid="SettingsPageTopBottom" />
                            </ComboBox>
                        </Grid>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="SettingsPageUseInternalLyricsAlignment">
                                <ToggleSwitch IsOn="{x:Bind LyricsWindowStatus.LyricsStyleSettings.UseInternalLyricsAlignment, Mode=TwoWay}" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander
                        x:Name="LyricsContentLayout"
                        x:Uid="SettingsPageLyricsContentOrientation"
                        HeaderIcon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                 Glyph=&#xE80A;}">
                        <ComboBox SelectedIndex="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsLayoutOrientation, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                            <ComboBoxItem x:Uid="SettingsPageLayoutOrientationHorizontal" />
                            <ComboBoxItem x:Uid="SettingsPageLayoutOrientationVertical" />
                        </ComboBox>
                    </controls:SettingsExpander>

                    <Grid
                        Margin="0,-21,0,0"
                        Padding="59,16,16,16"
                        RowSpacing="16"
                        Style="{ThemeResource CardGridStyle}"
                        Visibility="{Binding ElementName=LyricsContentLayout, Path=IsExpanded, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="LyricsStyleSettingsControlLyricsLayoutOrder" />
                        <ListView
                            x:Name="LyricsLayerOrderListView"
                            Grid.Row="1"
                            AllowDrop="True"
                            CanDragItems="True"
                            CanReorderItems="True"
                            DragItemsCompleted="LyricsLayerOrderListView_DragItemsCompleted"
                            ItemContainerStyle="{ThemeResource ListViewStretchedItemContainerStyle}"
                            ItemsSource="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsLayerOrder, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="settings:LyricsLayerConfig">
                                    <Grid>
                                        <controls:SettingsCard Header="{x:Bind LyricsLayerName}">
                                            <controls:SettingsCard.HeaderIcon>
                                                <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#x283F;" />
                                            </controls:SettingsCard.HeaderIcon>
                                        </controls:SettingsCard>
                                        <local:DragIndicator />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <controls:SettingsCard x:Uid="SettingsPageAutoWrap" HeaderIcon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xF465;}">
                        <ToggleSwitch IsOn="{x:Bind LyricsWindowStatus.LyricsStyleSettings.AutoWrap, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="SettingsPageLyricsCenterTopOffset" HeaderIcon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xE78A;}">
                        <local:ExtendedSlider
                            Default="50"
                            Maximum="99"
                            Minimum="1"
                            Unit="%"
                            Value="{x:Bind LyricsWindowStatus.LyricsStyleSettings.PlayingLineTopOffset, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsExpander x:Uid="SettingsPageLyricsLineSpacingFactor" HeaderIcon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xF579;}">
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="SettingsPageLyricsLineOverallSpacingFactor">
                                <local:ExtendedSlider
                                    Default="0.5"
                                    Frequency="0.1"
                                    Maximum="2"
                                    Minimum="0"
                                    Unit="x"
                                    Value="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsLineOverallSpacingFactor, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="SettingsPageLyricsLineInnerSpacingFactor">
                                <local:ExtendedSlider
                                    Default="0.1"
                                    Frequency="0.1"
                                    Maximum="2"
                                    Minimum="-0.1"
                                    Unit="x"
                                    Value="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsLineInnerSpacingFactor, Mode=TwoWay}" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander x:Uid="SettingsPageLyricsFontFamily" HeaderIcon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xE8D2;}">
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="SettingsPageCJK">
                                <local:FontPicker AllowMultipleSelection="False" SelectedFontId="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsCJKFontFamily, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="SettingsPageWesternChar">
                                <local:FontPicker AllowMultipleSelection="False" SelectedFontId="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsWesternFontFamily, Mode=TwoWay}" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsCard x:Uid="SettingsPageLyricsFontWeight" HeaderIcon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xE8DD;}">
                        <ComboBox SelectedIndex="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsFontWeight, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                            <ComboBoxItem x:Uid="SettingsPageLyricsThin" />
                            <ComboBoxItem x:Uid="SettingsPageLyricsExtraLight" />
                            <ComboBoxItem x:Uid="SettingsPageLyricsLight" />
                            <ComboBoxItem x:Uid="SettingsPageLyricsSemiLight" />
                            <ComboBoxItem x:Uid="SettingsPageLyricsNormal" />
                            <ComboBoxItem x:Uid="SettingsPageLyricsMedium" />
                            <ComboBoxItem x:Uid="SettingsPageLyricsSemiBold" />
                            <ComboBoxItem x:Uid="SettingsPageLyricsBold" />
                            <ComboBoxItem x:Uid="SettingsPageLyricsExtraBold" />
                            <ComboBoxItem x:Uid="SettingsPageLyricsBlack" />
                            <ComboBoxItem x:Uid="SettingsPageLyricsExtraBlack" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="SettingsPageLyricsFontStrokeWidth" HeaderIcon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xEC12;}">
                        <local:ExtendedSlider
                            Default="0"
                            Maximum="10"
                            Minimum="0"
                            Value="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsFontStrokeWidth, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <!--  字体颜色  -->
                    <controls:SettingsExpander x:Uid="SettingsPageFontColor" HeaderIcon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xE8D3;}">
                        <controls:SettingsExpander.Items>

                            <!--  描边（已播放）  -->
                            <controls:SettingsCard x:Uid="SettingsPagePlayedStrokeFontColor">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ComboBox SelectedIndex="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsPlayedStrokeFontColorType, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                                        <ComboBoxItem x:Uid="SettingsPageLyricsFontColorAdaptiveColored" />
                                        <ComboBoxItem x:Uid="SettingsPageLyricsFontColorAdaptiveGrayed" />
                                        <ComboBoxItem x:Uid="SettingsPageLyricsFontColorCustom" />
                                    </ComboBox>
                                    <controls:ColorPickerButton SelectedColor="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsCustomPlayedStrokeFontColor, Converter={StaticResource AppColorToColorConverter}, Mode=TwoWay}" Visibility="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsPlayedStrokeFontColorType, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=2}" />
                                    <controls:ColorPickerButton
                                        IsEnabled="False"
                                        SelectedColor="{x:Bind LyricsWindowStatus.WindowPalette.PlayedTextStrokeColor, Converter={StaticResource AppColorToColorConverter}, Mode=OneWay}"
                                        Visibility="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsPlayedStrokeFontColorType, Mode=OneWay, Converter={StaticResource EnumNegationToVisibilityConverter}, ConverterParameter=2}" />
                                </StackPanel>
                            </controls:SettingsCard>

                            <!--  描边（未播放）  -->
                            <controls:SettingsCard x:Uid="SettingsPageUnplayedStrokeFontColor">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ComboBox SelectedIndex="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsUnplayedStrokeFontColorType, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                                        <ComboBoxItem x:Uid="SettingsPageLyricsFontColorAdaptiveColored" />
                                        <ComboBoxItem x:Uid="SettingsPageLyricsFontColorAdaptiveGrayed" />
                                        <ComboBoxItem x:Uid="SettingsPageLyricsFontColorCustom" />
                                    </ComboBox>
                                    <controls:ColorPickerButton SelectedColor="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsCustomUnplayedStrokeFontColor, Converter={StaticResource AppColorToColorConverter}, Mode=TwoWay}" Visibility="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsUnplayedStrokeFontColorType, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=2}" />
                                    <controls:ColorPickerButton
                                        IsEnabled="False"
                                        SelectedColor="{x:Bind LyricsWindowStatus.WindowPalette.UnplayedTextStrokeColor, Converter={StaticResource AppColorToColorConverter}, Mode=OneWay}"
                                        Visibility="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsUnplayedStrokeFontColorType, Mode=OneWay, Converter={StaticResource EnumNegationToVisibilityConverter}, ConverterParameter=2}" />
                                </StackPanel>
                            </controls:SettingsCard>

                            <!--  非当前行  -->
                            <controls:SettingsCard x:Uid="SettingsPageLyricsBgFontColor">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ComboBox SelectedIndex="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsBgFontColorType, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                                        <ComboBoxItem x:Uid="SettingsPageLyricsFontColorAdaptiveColored" />
                                        <ComboBoxItem x:Uid="SettingsPageLyricsFontColorAdaptiveGrayed" />
                                        <ComboBoxItem x:Uid="SettingsPageLyricsFontColorCustom" />
                                    </ComboBox>
                                    <controls:ColorPickerButton SelectedColor="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsCustomBgFontColor, Converter={StaticResource AppColorToColorConverter}, Mode=TwoWay}" Visibility="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsBgFontColorType, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=2}" />
                                    <controls:ColorPickerButton
                                        IsEnabled="False"
                                        SelectedColor="{x:Bind LyricsWindowStatus.WindowPalette.NonCurrentLineFillColor, Converter={StaticResource AppColorToColorConverter}, Mode=OneWay}"
                                        Visibility="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsBgFontColorType, Mode=OneWay, Converter={StaticResource EnumNegationToVisibilityConverter}, ConverterParameter=2}" />
                                </StackPanel>
                            </controls:SettingsCard>

                            <!--  当前行（已播放）  -->
                            <controls:SettingsCard x:Uid="SettingsPageLyricsPlayedFgFontColor">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ComboBox SelectedIndex="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsPlayedFgFontColorType, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                                        <ComboBoxItem x:Uid="SettingsPageLyricsFontColorAdaptiveColored" />
                                        <ComboBoxItem x:Uid="SettingsPageLyricsFontColorAdaptiveGrayed" />
                                        <ComboBoxItem x:Uid="SettingsPageLyricsFontColorCustom" />
                                    </ComboBox>
                                    <controls:ColorPickerButton SelectedColor="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsCustomPlayedFgFontColor, Converter={StaticResource AppColorToColorConverter}, Mode=TwoWay}" Visibility="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsPlayedFgFontColorType, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=2}" />
                                    <controls:ColorPickerButton
                                        IsEnabled="False"
                                        SelectedColor="{x:Bind LyricsWindowStatus.WindowPalette.PlayedCurrentLineFillColor, Converter={StaticResource AppColorToColorConverter}, Mode=OneWay}"
                                        Visibility="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsPlayedFgFontColorType, Mode=OneWay, Converter={StaticResource EnumNegationToVisibilityConverter}, ConverterParameter=2}" />
                                </StackPanel>
                            </controls:SettingsCard>

                            <!--  当前行（未播放）  -->
                            <controls:SettingsCard x:Uid="SettingsPageLyricsUnplayedFgFontColor">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ComboBox SelectedIndex="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsUnplayedFgFontColorType, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                                        <ComboBoxItem x:Uid="SettingsPageLyricsFontColorAdaptiveColored" />
                                        <ComboBoxItem x:Uid="SettingsPageLyricsFontColorAdaptiveGrayed" />
                                        <ComboBoxItem x:Uid="SettingsPageLyricsFontColorCustom" />
                                    </ComboBox>
                                    <controls:ColorPickerButton SelectedColor="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsCustomUnplayedFgFontColor, Converter={StaticResource AppColorToColorConverter}, Mode=TwoWay}" Visibility="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsUnplayedFgFontColorType, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=2}" />
                                    <controls:ColorPickerButton
                                        IsEnabled="False"
                                        SelectedColor="{x:Bind LyricsWindowStatus.WindowPalette.UnplayedCurrentLineFillColor, Converter={StaticResource AppColorToColorConverter}, Mode=OneWay}"
                                        Visibility="{x:Bind LyricsWindowStatus.LyricsStyleSettings.LyricsUnplayedFgFontColorType, Mode=OneWay, Converter={StaticResource EnumNegationToVisibilityConverter}, ConverterParameter=2}" />
                                </StackPanel>
                            </controls:SettingsCard>

                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!--  字体大小  -->
                    <controls:SettingsExpander x:Uid="SettingsPageLyricsFontSize" HeaderIcon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xE8E9;}">
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="SettingsPageAutoAdjust">
                                <ToggleSwitch IsOn="{x:Bind LyricsWindowStatus.LyricsStyleSettings.IsDynamicLyricsFontSize, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="SettingsPagePhoneticText" IsEnabled="{x:Bind LyricsWindowStatus.LyricsStyleSettings.IsDynamicLyricsFontSize, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                                <local:ExtendedSlider
                                    Frequency="2"
                                    Maximum="256"
                                    Minimum="12"
                                    ResetButtonVisibility="Collapsed"
                                    Value="{x:Bind LyricsWindowStatus.LyricsStyleSettings.PhoneticLyricsFontSize, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="SettingsPageOriginalText" IsEnabled="{x:Bind LyricsWindowStatus.LyricsStyleSettings.IsDynamicLyricsFontSize, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                                <local:ExtendedSlider
                                    Frequency="2"
                                    Maximum="256"
                                    Minimum="12"
                                    ResetButtonVisibility="Collapsed"
                                    Value="{x:Bind LyricsWindowStatus.LyricsStyleSettings.OriginalLyricsFontSize, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="SettingsPageTranslatedText" IsEnabled="{x:Bind LyricsWindowStatus.LyricsStyleSettings.IsDynamicLyricsFontSize, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                                <local:ExtendedSlider
                                    Frequency="2"
                                    Maximum="256"
                                    Minimum="12"
                                    ResetButtonVisibility="Collapsed"
                                    Value="{x:Bind LyricsWindowStatus.LyricsStyleSettings.TranslatedLyricsFontSize, Mode=TwoWay}" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!--  字体不透明度  -->
                    <controls:SettingsExpander x:Uid="SettingsPageLyricsOpacity" HeaderIcon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xEF20;}">
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="SettingsPagePhoneticText">
                                <local:ExtendedSlider
                                    Default="60"
                                    Frequency="1"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{x:Bind LyricsWindowStatus.LyricsStyleSettings.PhoneticLyricsOpacity, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="SettingsPagePlayedOriginalText">
                                <local:ExtendedSlider
                                    Default="100"
                                    Frequency="1"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{x:Bind LyricsWindowStatus.LyricsStyleSettings.PlayedOriginalLyricsOpacity, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="SettingsPageUnplayedOriginalText">
                                <local:ExtendedSlider
                                    Default="30"
                                    Frequency="1"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{x:Bind LyricsWindowStatus.LyricsStyleSettings.UnplayedOriginalLyricsOpacity, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="SettingsPageTranslatedText">
                                <local:ExtendedSlider
                                    Default="60"
                                    Frequency="1"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{x:Bind LyricsWindowStatus.LyricsStyleSettings.TranslatedLyricsOpacity, Mode=TwoWay}" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <TextBlock x:Uid="SettingsPageLyricsCardStyle" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                    <controls:SettingsCard>
                        <controls:SettingsCard.Header>
                            <TextBlock x:Uid="LyricsSharePageStyleTitle" />
                        </controls:SettingsCard.Header>
                        <ComboBox x:Name="LyricsCardStyleComboBox" SelectionChanged="LyricsCardStyleComboBox_SelectionChanged" />
                    </controls:SettingsCard>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>