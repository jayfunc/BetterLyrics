<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.StoryPageSpecialMoment"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <StackPanel
            Margin="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="24">

            <TextBlock
                x:Name="Text1"
                x:Uid="StoryPageSpecialMomentText1"
                FontSize="20"
                Foreground="White"
                Opacity="0" />
            <TextBlock
                x:Name="Text2"
                x:Uid="StoryPageSpecialMomentText2"
                FontSize="20"
                Foreground="White"
                Opacity="0" />

            <StackPanel
                x:Name="Panel1"
                Margin="0,8,0,32"
                Opacity="0">
                <TextBlock
                    x:Name="FirstSongTextBlock"
                    FontSize="40"
                    FontWeight="Bold"
                    Foreground="White"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                x:Name="LateNightPanel1"
                HorizontalAlignment="Left"
                Opacity="0"
                Orientation="Horizontal">
                <TextBlock
                    x:Uid="StoryPageSpecialMomentText3"
                    Margin="0,0,8,4"
                    VerticalAlignment="Bottom"
                    FontSize="20"
                    Foreground="White" />
                <TextBlock
                    x:Name="LateNightDateTextBlock"
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="White" />
                <TextBlock
                    x:Uid="StoryPageSpecialMomentText4"
                    Margin="0,0,0,4"
                    VerticalAlignment="Bottom"
                    FontSize="20"
                    Foreground="White" />
            </StackPanel>

            <StackPanel
                x:Name="LateNightPanel2"
                HorizontalAlignment="Left"
                Opacity="0"
                Orientation="Horizontal">
                <TextBlock
                    x:Uid="StoryPageSpecialMomentText5"
                    Margin="0,0,8,4"
                    VerticalAlignment="Bottom"
                    FontSize="20"
                    Foreground="White" />
                <TextBlock
                    x:Name="LateNightTimeTextBlock"
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="White" />
                <TextBlock
                    x:Uid="StoryPageSpecialMomentText6"
                    Margin="0,0,0,4"
                    VerticalAlignment="Bottom"
                    FontSize="20"
                    Foreground="White" />
            </StackPanel>

            <StackPanel
                x:Name="Panel2"
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                Opacity="0">
                <TextBlock
                    x:Name="LateNightSongTextBlock"
                    HorizontalAlignment="Center"
                    FontSize="40"
                    FontWeight="Bold"
                    Foreground="White"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
