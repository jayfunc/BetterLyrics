<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.FontPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models1="using:BetterLyrics.Core.Models"
    mc:Ignorable="d">

    <Button
        x:Name="TriggerButton"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Click="TriggerButton_Click">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ItemsControl
                x:Name="SelectedFontsItemsControl"
                VerticalAlignment="Center"
                IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:WrapPanel
                            HorizontalSpacing="6"
                            Orientation="Horizontal"
                            VerticalSpacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models1:ExtendedFontFamily">
                        <StackPanel Padding="8,4" CornerRadius="4">
                            <TextBlock FontFamily="{x:Bind FontFamily}" Text="{x:Bind LocalizedFontFamily}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind FontFamily}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel
                x:Name="LoadingPanel"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressRing
                    x:Name="LoadingRing"
                    Width="16"
                    Height="16"
                    IsActive="False" />
                <TextBlock
                    x:Name="LoadingTextBlock"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <FontIcon
                Grid.Column="1"
                Margin="0,0,4,0"
                FontFamily="{StaticResource SegoeFluentIcons}"
                FontSize="10"
                Glyph="&#xE70D;"
                Opacity="0.6" />
        </Grid>
    </Button>
</UserControl>