<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.StatsDashboardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:BetterLyrics.WinUI3.Controls.Charts"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:labs="using:CommunityToolkit.Labs.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models1="using:BetterLyrics.Core.Models"
    xmlns:stats="using:BetterLyrics.Core.Models.Stats"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="StatsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Transitions">
                <Setter.Value>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="20" IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Loaded="Grid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  加载条  -->
        <ProgressBar
            Grid.Row="0"
            Grid.RowSpan="3"
            VerticalAlignment="Top"
            Background="Transparent"
            IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!--  时间选取  -->
        <controls:SettingsExpander
            x:Uid="StatsDashboardControlTimeRange"
            Grid.Row="1"
            Margin="36,36,36,4"
            HeaderIcon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                     Glyph=&#xEC92;}"
            IsExpanded="{x:Bind ViewModel.SelectedTimeRange, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=6}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button
                    Command="{x:Bind ViewModel.RefreshDataCommand}"
                    Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                          FontSize=12,
                                          Glyph=&#xE72C;}"
                    Style="{ThemeResource GhostButtonStyle}" />
                <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedTimeRange, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                    <ComboBoxItem x:Uid="StatsDashboardControlToday" />
                    <ComboBoxItem x:Uid="StatsDashboardControlThisWeek" />
                    <ComboBoxItem x:Uid="StatsDashboardControlThisMonth" />
                    <ComboBoxItem x:Uid="StatsDashboardControlThisQuarter" />
                    <ComboBoxItem x:Uid="StatsDashboardControlThisYear" />
                    <ComboBoxItem x:Uid="StatsDashboardControlAllTime" />
                    <ComboBoxItem x:Uid="StatsDashboardControlCustom" />
                </ComboBox>
            </StackPanel>

            <controls:SettingsExpander.Items>
                <controls:SettingsCard x:Uid="StatsDashboardControlStart">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <CalendarDatePicker Date="{x:Bind ViewModel.CustomStartDate, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsCustomRangeSelected, Mode=OneWay}" />
                        <TimePicker
                            VerticalAlignment="Bottom"
                            IsEnabled="{x:Bind ViewModel.IsCustomRangeSelected, Mode=OneWay}"
                            Time="{x:Bind ViewModel.CustomStartTime, Mode=TwoWay}" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="StatsDashboardControlEnd">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <CalendarDatePicker Date="{x:Bind ViewModel.CustomEndDate, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsCustomRangeSelected, Mode=OneWay}" />
                        <TimePicker
                            VerticalAlignment="Bottom"
                            IsEnabled="{x:Bind ViewModel.IsCustomRangeSelected, Mode=OneWay}"
                            Time="{x:Bind ViewModel.CustomEndTime, Mode=TwoWay}" />
                    </StackPanel>
                </controls:SettingsCard>

            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <!--  结果展示  -->
        <ScrollViewer Grid.Row="2" Padding="36,0,32,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  总时长  -->
                    <Border Grid.Column="0" Style="{StaticResource StatsCardStyle}">
                        <Grid>
                            <FontIcon
                                Margin="0,0,-10,-10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontSize="80"
                                Glyph="&#xE916;"
                                Opacity="0.03" />
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE916;" />
                                    <TextBlock
                                        x:Uid="StatsDashboardControlTotalDuration"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,16,0,0"
                                    VerticalAlignment="Bottom"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <TextBlock
                                        FontSize="32"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="{x:Bind ViewModel.TotalDuration.TotalHours, Mode=OneWay, Converter={StaticResource DoubleToDecimalConverter}}" />
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        VerticalAlignment="Bottom"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Opacity="0.8"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="Hrs" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  已播放曲目数  -->
                    <Border Grid.Column="1" Style="{StaticResource StatsCardStyle}">
                        <Grid>
                            <FontIcon
                                Margin="0,0,-10,-10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontSize="80"
                                Glyph="&#xE8D6;"
                                Opacity="0.03" />
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE8D6;" />
                                    <TextBlock
                                        x:Uid="StatsDashboardControlTracksPlayed"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,16,0,0"
                                    FontSize="32"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.TotalTracksPlayed, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  常用播放源  -->
                    <Border Grid.Column="2" Style="{StaticResource StatsCardStyle}">
                        <Grid>
                            <FontIcon
                                Margin="0,0,-10,-10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontSize="80"
                                Glyph="&#xEC4A;"
                                Opacity="0.03" />
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xEC4A;" />
                                    <TextBlock
                                        x:Uid="StatsDashboardControlTopSource"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,16,0,0"
                                    FontSize="32"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.TopPlayerName, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!--  热度图  -->
                <Border Grid.Row="1" Style="{StaticResource StatsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Uid="StatsDashboardControlHeatmap"
                            Margin="0,0,0,12"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,20,8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="18" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    x:Name="HeatmapLabel1"
                                    Grid.Row="1"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="HeatmapLabel3"
                                    Grid.Row="3"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="HeatmapLabel5"
                                    Grid.Row="5"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <ScrollViewer
                                Grid.Column="1"
                                Padding="0,0,0,8"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <ItemsControl Grid.Row="0" ItemsSource="{x:Bind ViewModel.MonthLabels, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models1:MonthLabel">
                                                <Grid>
                                                    <Grid.RenderTransform>
                                                        <TranslateTransform X="{x:Bind Offset}" />
                                                    </Grid.RenderTransform>
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Name}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.HeatmapData, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VariableSizedWrapGrid
                                                    ItemHeight="18"
                                                    ItemWidth="18"
                                                    MaximumRowsOrColumns="7"
                                                    Orientation="Vertical" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models1:HeatmapNode">
                                                <Border
                                                    Width="14"
                                                    Height="14"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="2"
                                                    Opacity="{x:Bind Opacity}"
                                                    PointerEntered="HeatmapNode_PointerEntered"
                                                    PointerExited="HeatmapNode_PointerExited">
                                                    <ToolTipService.ToolTip>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Date.ToShortDateString()}" />
                                                            <Grid Width="4" />
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind PlayCount}" />
                                                            <Grid Width="2" />
                                                            <TextBlock x:Uid="StatsDashboardControlTrackCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </ToolTipService.ToolTip>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <!--  Activity by hour  -->
                <Border Grid.Row="2" Style="{StaticResource StatsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Margin="0,0,0,12"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock x:Uid="StatsDashboardControlActivityByHour" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    x:Uid="StatsDashboardControlMostActive"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.PeakHourText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    x:Uid="StatsDashboardControlLeastActive"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.QuietHourText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <charts:HourlyBarChartControl
                            Grid.Row="2"
                            Height="180"
                            Margin="0,8,0,0"
                            ItemsSource="{x:Bind ViewModel.HourlySeriesValues, Mode=OneWay}" />
                    </Grid>
                </Border>

                <!--  Top artists and sources  -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Top artists  -->
                    <Border Grid.Column="0" Style="{StaticResource StatsCardStyle}">
                        <StackPanel>
                            <TextBlock
                                x:Uid="StatsDashboardControlTopArtists"
                                Margin="0,0,0,12"
                                Style="{ThemeResource SubtitleTextBlockStyle}" />

                            <ItemsControl ItemsSource="{x:Bind ViewModel.TopArtists, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="stats:ArtistPlayCount">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <PersonPicture
                                                    Width="32"
                                                    Height="32"
                                                    DisplayName="{x:Bind Artist}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind Artist}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold">
                                                <Run Text="{x:Bind PlayCount}" />
                                                <Run
                                                    x:Uid="StatsDashboardControlTrackCountText"
                                                    FontSize="10"
                                                    FontWeight="Normal"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>

                    <!--  Top tracks  -->
                    <Border Grid.Column="1" Style="{StaticResource StatsCardStyle}">
                        <StackPanel>
                            <TextBlock
                                x:Uid="StatsDashboardControlTopSongs"
                                Margin="0,0,0,12"
                                Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.TopSongs, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="stats:SongPlayCount">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Width="40"
                                                Height="40"
                                                Margin="0,0,12,0"
                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                CornerRadius="4">
                                                <FontIcon
                                                    FontSize="16"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE8D6;" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Artist}" />
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold">
                                                <Run Text="{x:Bind PlayCount}" />
                                                <Run
                                                    x:Uid="StatsDashboardControlTrackCountText"
                                                    FontSize="10"
                                                    FontWeight="Normal"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </Grid>

                <!--  TODO 滚动到此处抛异常  -->
                <!--  播放源分布  -->
                <Border Grid.Row="4" Style="{StaticResource StatsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Uid="StatsDashboardControlSources"
                            Margin="0,0,0,12"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <charts:SourcePieChartControl
                            Grid.Row="1"
                            MinHeight="250"
                            ItemsSource="{x:Bind ViewModel.SourceSeries, Mode=OneWay}" />

                    </Grid>
                </Border>

                <!--  记录条  -->
                <Grid
                    Grid.Row="5"
                    Margin="0,0,4,0"
                    Visibility="{x:Bind ViewModel.GSMTCService.IsScrobbled, Mode=OneWay, Converter={StaticResource BoolNegationToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <InfoBar
                        x:Uid="StatsDashboardControlRecording"
                        Grid.Row="0"
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind ViewModel.GSMTCService.CurrentSongInfo.Title, Mode=OneWay}" />
                    <ProgressBar
                        Grid.Row="1"
                        Background="Transparent"
                        Maximum="{x:Bind ViewModel.GSMTCService.TargetScrobbledDuration.TotalSeconds, Mode=OneWay}"
                        ShowPaused="{x:Bind ViewModel.GSMTCService.CurrentIsPlaying, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                        Value="{x:Bind ViewModel.GSMTCService.ScrobbledDuration.TotalSeconds, Mode=OneWay}" />
                </Grid>

                <Grid Grid.Row="6" Height="32" />

            </Grid>
        </ScrollViewer>

        <Button
            Grid.RowSpan="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Command="{x:Bind ViewModel.GenerateTestDataCommand}"
            Content="TEST" />

    </Grid>
</UserControl>