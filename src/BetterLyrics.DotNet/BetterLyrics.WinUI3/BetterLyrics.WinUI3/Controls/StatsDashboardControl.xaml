<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.StatsDashboardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:BetterLyrics.WinUI3.Controls.Charts"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:labs="using:CommunityToolkit.Labs.WinUI"
    xmlns:local="using:BetterLyrics.WinUI3.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:models="using:BetterLyrics.Core.Models"
    xmlns:stats="using:BetterLyrics.Core.Models.Stats"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Grid>

        <!--  加载条  -->
        <ProgressBar
            VerticalAlignment="Top"
            Background="Transparent"
            IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!--  结果展示  -->
        <ScrollViewer x:Name="MainScrollViewer">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!--  Hero Banner (Memoir + Top Stats)  -->
                <Grid Grid.Row="0">
                    <Grid Padding="36,36,36,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Top Bar: Memoir & Time Selection  -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Uid="StatsDashboardControlMemoirTitle" Style="{ThemeResource TitleTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="StatsDashboardControlMemoirDesc"
                                    Margin="0,4,0,16"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource BodyTextBlockStyle}" />
                                <Button
                                    BorderThickness="0"
                                    Click="PlayStoryButton_Click"
                                    Style="{ThemeResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                                        <TextBlock x:Uid="StatsDashboardControlMemoirPlay" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!--  Time Selection (Sleek)  -->
                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Spacing="12">
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Command="{x:Bind ViewModel.RefreshDataCommand}"
                                        Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                              FontSize=12,
                                                              Glyph=&#xE72C;}"
                                        Style="{ThemeResource GhostButtonStyle}" />
                                    <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedTimeRange, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                                        <ComboBoxItem x:Uid="StatsDashboardControlToday" />
                                        <ComboBoxItem x:Uid="StatsDashboardControlThisWeek" />
                                        <ComboBoxItem x:Uid="StatsDashboardControlThisMonth" />
                                        <ComboBoxItem x:Uid="StatsDashboardControlThisQuarter" />
                                        <ComboBoxItem x:Uid="StatsDashboardControlThisYear" />
                                        <ComboBoxItem x:Uid="StatsDashboardControlAllTime" />
                                        <ComboBoxItem x:Uid="StatsDashboardControlCustom" />
                                    </ComboBox>
                                </StackPanel>

                                <Grid HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.IsCustomRangeSelected, Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel
                                        Grid.Row="0"
                                        Margin="0,0,0,8"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            x:Uid="StatsDashboardControlStartText"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <CalendarDatePicker Date="{x:Bind ViewModel.CustomStartDate, Mode=TwoWay}" />
                                        <TimePicker Time="{x:Bind ViewModel.CustomStartTime, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            x:Uid="StatsDashboardControlEndText"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <CalendarDatePicker Date="{x:Bind ViewModel.CustomEndDate, Mode=TwoWay}" />
                                        <TimePicker Time="{x:Bind ViewModel.CustomEndTime, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!--  Counters  -->
                        <Grid
                            Grid.Row="2"
                            Margin="16,48,16,0"
                            ColumnSpacing="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  总时长  -->
                            <Grid Grid.Column="0">
                                <FontIcon
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    FontSize="120"
                                    Glyph="&#xE916;"
                                    Opacity="0.15">
                                    <FontIcon.Clip>
                                        <RectangleGeometry Rect="0,0,90,90" />
                                    </FontIcon.Clip>
                                </FontIcon>
                                <StackPanel>
                                    <TextBlock
                                        x:Uid="StatsDashboardControlTotalDuration"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <StackPanel
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Bottom"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <TextBlock
                                            FontSize="42"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind ViewModel.TotalDuration.TotalHours, Mode=OneWay, Converter={StaticResource DoubleToDecimalConverter}}" />
                                        <TextBlock
                                            x:Uid="StatsDashboardControlHours"
                                            Margin="0,0,0,8"
                                            VerticalAlignment="Bottom"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource BodyTextBlockStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!--  已播放曲目数  -->
                            <Grid Grid.Column="1">
                                <FontIcon
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    FontSize="120"
                                    Glyph="&#xEC4F;"
                                    Opacity="0.15">
                                    <FontIcon.Clip>
                                        <RectangleGeometry Rect="0,0,90,90" />
                                    </FontIcon.Clip>
                                </FontIcon>
                                <StackPanel>
                                    <TextBlock
                                        x:Uid="StatsDashboardControlTracksPlayed"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Margin="0,12,0,0"
                                        FontSize="42"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.TotalTracksPlayed, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <!--  常用播放源  -->
                            <Grid Grid.Column="2">
                                <FontIcon
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    FontSize="120"
                                    Glyph="&#xE774;"
                                    Opacity="0.15">
                                    <FontIcon.Clip>
                                        <RectangleGeometry Rect="0,0,90,90" />
                                    </FontIcon.Clip>
                                </FontIcon>
                                <StackPanel>
                                    <TextBlock
                                        x:Uid="StatsDashboardControlTopSource"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Margin="0,12,0,0"
                                        FontSize="42"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.TopPlayerName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <!--  热度图  -->
                <Grid
                    Grid.Row="1"
                    Margin="36,0"
                    Padding="24"
                    Style="{ThemeResource CardGridStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Uid="StatsDashboardControlHeatmap"
                            Margin="0,0,0,12"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,20,8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="18" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="1"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.HeatmapLabel1, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Row="3"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.HeatmapLabel3, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Row="5"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.HeatmapLabel5, Mode=OneWay}" />
                            </Grid>

                            <ScrollViewer
                                Grid.Column="1"
                                Padding="0,0,0,8"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <ItemsControl Grid.Row="0" ItemsSource="{x:Bind ViewModel.MonthLabels, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:MonthLabel">
                                                <Grid>
                                                    <Grid.RenderTransform>
                                                        <TranslateTransform X="{x:Bind Offset}" />
                                                    </Grid.RenderTransform>
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Name}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.HeatmapData, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VariableSizedWrapGrid
                                                    ItemHeight="18"
                                                    ItemWidth="18"
                                                    MaximumRowsOrColumns="7"
                                                    Orientation="Vertical" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:HeatmapNode">
                                                <Border
                                                    Width="14"
                                                    Height="14"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="2"
                                                    Opacity="{x:Bind Opacity}"
                                                    PointerEntered="HeatmapNode_PointerEntered"
                                                    PointerExited="HeatmapNode_PointerExited">
                                                    <ToolTipService.ToolTip>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Date.ToShortDateString()}" />
                                                            <Grid Width="4" />
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind PlayCount}" />
                                                            <Grid Width="2" />
                                                            <TextBlock x:Uid="StatsDashboardControlTrackCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </ToolTipService.ToolTip>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!--  Activity by hour  -->
                <Grid
                    Grid.Row="2"
                    Margin="36,0"
                    Padding="24"
                    Style="{ThemeResource CardGridStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Margin="0,0,0,12"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock x:Uid="StatsDashboardControlActivityByHour" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    x:Uid="StatsDashboardControlMostActive"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.PeakHourText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    x:Uid="StatsDashboardControlLeastActive"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.QuietHourText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <charts:HourlyBarChartControl
                            Grid.Row="2"
                            Height="180"
                            Margin="0,8,0,0"
                            ItemsSource="{x:Bind ViewModel.HourlySeriesValues, Mode=OneWay}" />
                    </Grid>
                </Grid>

                <!--  Top artists and sources  -->
                <Grid Grid.Row="3" Margin="36,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Top artists  -->
                    <Grid
                        Grid.Column="0"
                        Padding="24"
                        Style="{ThemeResource CardGridStyle}">
                        <StackPanel>
                            <TextBlock
                                x:Uid="StatsDashboardControlTopArtists"
                                Margin="0,0,0,12"
                                Style="{ThemeResource SubtitleTextBlockStyle}" />

                            <ItemsControl ItemsSource="{x:Bind ViewModel.TopArtists, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="stats:ArtistPlayCount">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <PersonPicture
                                                    Width="32"
                                                    Height="32"
                                                    DisplayName="{x:Bind Artist}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind Artist}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold">
                                                <Run Text="{x:Bind PlayCount}" />
                                                <Run
                                                    x:Uid="StatsDashboardControlTrackCountText"
                                                    FontSize="10"
                                                    FontWeight="Normal"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Grid>

                    <!--  Top tracks  -->
                    <Grid
                        Grid.Column="1"
                        Padding="24"
                        Style="{ThemeResource CardGridStyle}">
                        <StackPanel>
                            <TextBlock
                                x:Uid="StatsDashboardControlTopSongs"
                                Margin="0,0,0,12"
                                Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.TopSongs, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="stats:SongPlayCount">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Width="40"
                                                Height="40"
                                                Margin="0,0,12,0"
                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                CornerRadius="4">
                                                <FontIcon
                                                    FontSize="16"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE8D6;" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Artist}" />
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold">
                                                <Run Text="{x:Bind PlayCount}" />
                                                <Run
                                                    x:Uid="StatsDashboardControlTrackCountText"
                                                    FontSize="10"
                                                    FontWeight="Normal"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                </Grid>

                <!--  播放源分布  -->
                <Grid
                    Grid.Row="4"
                    Margin="36,0"
                    Padding="24"
                    Style="{ThemeResource CardGridStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Uid="StatsDashboardControlSources"
                            Margin="0,0,0,12"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <charts:SourceBarChartControl
                            Grid.Row="1"
                            MinHeight="250"
                            Margin="0,16,0,0"
                            ItemsSource="{x:Bind ViewModel.SourceSeries, Mode=OneWay}" />

                    </Grid>
                </Grid>

                <!--  记录条  -->
                <Grid
                    Grid.Row="6"
                    Margin="36,0,36,0"
                    Visibility="{x:Bind ViewModel.GSMTCService.IsScrobbled, Mode=OneWay, Converter={StaticResource BoolNegationToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <InfoBar
                        x:Uid="StatsDashboardControlRecording"
                        Grid.Row="0"
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind ViewModel.GSMTCService.CurrentSongInfo.Title, Mode=OneWay}" />
                    <ProgressBar
                        Grid.Row="1"
                        Background="Transparent"
                        Maximum="{x:Bind ViewModel.GSMTCService.TargetScrobbledDuration.TotalSeconds, Mode=OneWay}"
                        ShowPaused="{x:Bind ViewModel.GSMTCService.CurrentIsPlaying, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                        Value="{x:Bind ViewModel.GSMTCService.ScrobbledDuration.TotalSeconds, Mode=OneWay}" />
                </Grid>

                <Grid Grid.Row="7" Height="32" />

            </Grid>
        </ScrollViewer>

        <Button
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Command="{x:Bind ViewModel.GenerateTestDataCommand}"
            Content="TEST" />

        <local:StoryViewerControl
            x:Name="StoryViewer"
            CloseRequested="StoryViewer_CloseRequested"
            Visibility="Collapsed" />

    </Grid>
</UserControl>