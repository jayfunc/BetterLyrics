<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.StoryPageTopSong"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <StackPanel
            Margin="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="24">
            <TextBlock
                x:Name="Text1"
                x:Uid="StoryPageTopSongText1"
                FontSize="20"
                Foreground="White"
                Opacity="0" />

            <TextBlock
                x:Name="Text2"
                x:Uid="StoryPageTopSongText2"
                FontSize="20"
                Foreground="White"
                Opacity="0" />

            <StackPanel
                x:Name="Panel1"
                Margin="0,24,0,24"
                Opacity="0">
                <TextBlock
                    x:Name="SongTitleTextBlock"
                    Margin="0,0,0,8"
                    FontSize="48"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="-"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    x:Name="SongArtistTextBlock"
                    FontSize="24"
                    Foreground="White"
                    Opacity="0.8"
                    Text="-" />
            </StackPanel>

            <StackPanel
                x:Name="Panel2"
                Opacity="0"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Uid="StoryPageTopSongText3"
                    Margin="0,0,0,8"
                    VerticalAlignment="Bottom"
                    FontSize="24"
                    Foreground="White"
                    Opacity="0.8" />
                <TextBlock
                    x:Name="PlayCountTextBlock"
                    FontSize="64"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="0" />
                <TextBlock
                    x:Uid="StoryPageTopSongText4"
                    Margin="0,0,0,8"
                    VerticalAlignment="Bottom"
                    FontSize="24"
                    Foreground="White"
                    Opacity="0.8" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
