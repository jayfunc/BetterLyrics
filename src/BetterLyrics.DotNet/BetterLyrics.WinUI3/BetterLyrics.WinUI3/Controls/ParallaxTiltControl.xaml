<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    x:Class="BetterLyrics.WinUI3.Controls.ParallaxTiltControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        RenderTransformOrigin="0.5,0.5">

        <Grid.Projection>
            <PlaneProjection x:Name="TiltProjection" />
        </Grid.Projection>

        <ContentPresenter x:Name="ContentPresenter" Content="{x:Bind Child, Mode=OneWay}">
            <ContentPresenter.RenderTransform>
                <CompositeTransform x:Name="ParallaxTransform" />
            </ContentPresenter.RenderTransform>
        </ContentPresenter>

    </Grid>
</UserControl>