<?xml version="1.0" encoding="utf-8" ?>

<Application
    x:Class="BetterLyrics.WinUI3.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Merged dictionaries here  -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.Segmented/Segmented/Segmented.xaml" />
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.SettingsControls/SettingsExpander/SettingsExpander.xaml" />

                <ResourceDictionary Source="ms-appx:///Themes/DefaultStyles.xaml" />

                <ResourceDictionary Source="ms-appx:///Themes/Converters.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/GhostSliderStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/InteractiveGridViewHeaderStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/InteractiveListViewHeaderStyle.xaml" />

                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardAncientBookStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardBambooSlipsStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardCDStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardCinematicStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardCyberpunkStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardDunhuangStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardInkWashStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardJournalStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardLINEStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardMagazineStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardMinimalStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardPodStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardPolaroidStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardQQStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardReceiptStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardRetroMSNStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardRetroQQStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardStickyNoteStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardSwissStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardTelegramStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardTicketStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardVinylStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardWeChatStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardWhatsAppStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/LyricsCardWindowsPhoneStyle.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <!--  Theme  -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <ImageSource x:Key="MusicWave">ms-appx:///Assets/MusicWaveBlack.gif</ImageSource>
                    <ImageSource x:Key="DiscordLogo">ms-appx:///Assets/DiscordLogoBlack.png</ImageSource>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <ImageSource x:Key="MusicWave">ms-appx:///Assets/MusicWaveWhite.gif</ImageSource>
                    <ImageSource x:Key="DiscordLogo">ms-appx:///Assets/DiscordLogoWhite.png</ImageSource>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  Animation  -->
            <ExponentialEase x:Key="EaseInOut" EasingMode="EaseInOut" />
            <ExponentialEase x:Key="EaseOut" EasingMode="EaseOut" />
            <ExponentialEase x:Key="EaseIn" EasingMode="EaseIn" />

            <x:Double x:Key="SettingsCardSpacing">4</x:Double>

            <!--  TextBlock Styles  -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>

            <Style
                x:Key="TitleTextBlockStyle"
                BasedOn="{StaticResource BaseTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource TitleTextBlockFontSize}" />
                <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>

            <Style
                x:Key="SubtitleTextBlockStyle"
                BasedOn="{StaticResource BaseTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource SubtitleTextBlockFontSize}" />
                <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>

            <Style
                x:Key="BodyTextBlockStyle"
                BasedOn="{StaticResource BaseTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>

            <Style
                x:Key="CaptionTextBlockStyle"
                BasedOn="{StaticResource BaseTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>

            <Style
                x:Key="BodyStrongTextBlockStyle"
                BasedOn="{StaticResource BaseTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource BodyStrongTextBlockFontSize}" />
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>

            <Style
                x:Key="SettingsSectionHeaderTextBlockStyle"
                BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                TargetType="TextBlock">
                <Style.Setters>
                    <Setter Property="Margin" Value="1,30,0,6" />
                </Style.Setters>
            </Style>

            <!--  RichTextBlock Styles  -->
            <Style TargetType="RichTextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>

            <!--  Grid Styles  -->
            <Style x:Key="CardGridStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>

            <Style x:Key="SettingsGridStyle" TargetType="Grid">
                <Setter Property="Padding" Value="0,0,0,36" />
            </Style>

            <!--  ScrollViewer Styles  -->
            <Style
                x:Key="SettingsScrollViewerStyle"
                BasedOn="{StaticResource DefaultScrollViewerStyle}"
                TargetType="ScrollViewer">
                <Setter Property="Padding" Value="36,0" />
            </Style>

            <!--  FlyoutPresenter Styles  -->
            <Style
                x:Key="FlyoutPageStyle"
                BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                TargetType="FlyoutPresenter">
                <Setter Property="Opacity" Value="0.9" />
                <Setter Property="MinWidth" Value="850" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
            </Style>

            <Style
                x:Key="FlyoutGhostStyle"
                BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                TargetType="FlyoutPresenter">
                <Setter Property="Padding" Value="0" />
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
            </Style>

            <!--  InfoBar Styles  -->
            <Style TargetType="InfoBar">
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>

            <!--  CalendarDatePicker Styles  -->
            <Style BasedOn="{StaticResource DefaultCalendarDatePicker}" TargetType="CalendarDatePicker">
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>

            <!--  Dimensions  -->

            <!--  Fonts  -->
            <FontFamily x:Key="SegoeFluentIcons">ms-appx:///Assets/Fonts/SegoeFluentIcons.ttf#Segoe Fluent Icons</FontFamily>
            <FontFamily x:Key="SloganCNFont">ms-appx:///Assets/Fonts/SloganCNFont.ttf#LXGW WenKai Lite</FontFamily>
            <FontFamily x:Key="SloganENFont">ms-appx:///Assets/Fonts/SloganENFont.ttf#Lora</FontFamily>

        </ResourceDictionary>
    </Application.Resources>

</Application>