<?xml version="1.0" encoding="utf-8" ?>

<Application
    x:Class="BetterLyrics.WinUI3.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Merged dictionaries here  -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.Segmented/Segmented/Segmented.xaml" />
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.SettingsControls/SettingsExpander/SettingsExpander.xaml" />

                <ResourceDictionary Source="/Themes/DefaultStyles.xaml" />

                <ResourceDictionary Source="/Themes/Converters.xaml" />
                <ResourceDictionary Source="/Themes/GhostSliderStyle.xaml" />
                <ResourceDictionary Source="/Themes/InteractiveGridViewHeaderStyle.xaml" />
                <ResourceDictionary Source="/Themes/InteractiveListViewHeaderStyle.xaml" />

                <ResourceDictionary Source="/Themes/LyricsCardAncientBookStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardBambooSlipsStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardCDStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardCinematicStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardCyberpunkStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardDunhuangStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardInkWashStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardJournalStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardLINEStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardMagazineStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardMinimalStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardPodStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardPolaroidStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardQQStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardReceiptStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardRetroMSNStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardRetroQQStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardStickyNoteStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardSwissStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardTelegramStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardTicketStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardVinylStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardWeChatStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardWhatsAppStyle.xaml" />
                <ResourceDictionary Source="/Themes/LyricsCardWindowsPhoneStyle.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <!--  Theme  -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <ImageSource x:Key="MusicWave">ms-appx:///Assets/MusicWaveBlack.gif</ImageSource>
                    <ImageSource x:Key="DiscordLogo">ms-appx:///Assets/DiscordLogoBlack.png</ImageSource>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <ImageSource x:Key="MusicWave">ms-appx:///Assets/MusicWaveWhite.gif</ImageSource>
                    <ImageSource x:Key="DiscordLogo">ms-appx:///Assets/DiscordLogoWhite.png</ImageSource>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  Animation  -->
            <ExponentialEase x:Key="EaseInOut" EasingMode="EaseInOut" />
            <ExponentialEase x:Key="EaseOut" EasingMode="EaseOut" />
            <ExponentialEase x:Key="EaseIn" EasingMode="EaseIn" />

            <x:Double x:Key="SettingsCardSpacing">4</x:Double>

            <!--  TextBlock Styles  -->
            <Style
                x:Key="SettingsSectionHeaderTextBlockStyle"
                BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                TargetType="TextBlock">
                <Style.Setters>
                    <Setter Property="Margin" Value="1,30,0,6" />
                </Style.Setters>
            </Style>

            <!--  Grid Styles  -->
            <Style x:Key="CardGridStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>

            <Style x:Key="SettingsGridStyle" TargetType="Grid">
                <Setter Property="Padding" Value="0,0,0,36" />
            </Style>

            <!--  ScrollViewer Styles  -->
            <Style
                x:Key="SettingsScrollViewerStyle"
                BasedOn="{StaticResource DefaultScrollViewerStyle}"
                TargetType="ScrollViewer">
                <Setter Property="Padding" Value="36,0" />
            </Style>

            <!--  FlyoutPresenter Styles  -->
            <Style
                x:Key="FlyoutPageStyle"
                BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                TargetType="FlyoutPresenter">
                <Setter Property="Opacity" Value="0.9" />
                <Setter Property="MinWidth" Value="850" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
            </Style>

            <Style
                x:Key="FlyoutGhostStyle"
                BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                TargetType="FlyoutPresenter">
                <Setter Property="Padding" Value="0" />
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
            </Style>

            <!--  Dimensions  -->

            <!--  Fonts  -->
            <FontFamily x:Key="SegoeFluentIcons">ms-appx:///Assets/Fonts/SegoeFluentIcons.ttf#Segoe Fluent Icons</FontFamily>
            <FontFamily x:Key="SloganCNFont">ms-appx:///Assets/Fonts/SloganCNFont.ttf#LXGW WenKai Lite</FontFamily>
            <FontFamily x:Key="SloganENFont">ms-appx:///Assets/Fonts/SloganENFont.ttf#Lora</FontFamily>

        </ResourceDictionary>
    </Application.Resources>

</Application>