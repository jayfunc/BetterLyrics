<?xml version="1.0" encoding="utf-8" ?>

<Window
    x:Class="BetterLyrics.WinUI3.Views.ToastOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="using:BetterLyrics.WinUI3.Controls"
    Title="ToastOverlayWindow"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <uc:InAppNotificationStack
            x:Name="NotificationStack"
            Margin="0,0,0,72"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Loaded="NotificationStack_Loaded"
            Unloaded="NotificationStack_Unloaded" />
    </Grid>

</Window>