<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BetterLyrics.WinUI3.Views.MusicGalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:BetterLyrics.WinUI3.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="using:BetterLyrics.Core.Enums"
    xmlns:helpers="using:BetterLyrics.WinUI3.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BetterLyrics.Core.Models"
    xmlns:settings="using:BetterLyrics.Core.Models.Settings"
    xmlns:uc="using:BetterLyrics.WinUI3.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <converters:FileSizeToStringConverter x:Key="FileSizeToStringConverter" />
        <converters:DateTimeToStringConverter x:Key="DateTimeToStringConverter" />
        <CollectionViewSource
            x:Name="GroupedTracksCVS"
            IsSourceGrouped="True"
            Source="{x:Bind ViewModel.GroupedTracks, Mode=OneWay}" />
        <CollectionViewSource
            x:Name="GroupedAlbumsCVS"
            IsSourceGrouped="True"
            Source="{x:Bind ViewModel.GroupedAlbums, Mode=OneWay}" />
        <CollectionViewSource
            x:Name="GroupedArtistsCVS"
            IsSourceGrouped="True"
            Source="{x:Bind ViewModel.GroupedArtists, Mode=OneWay}" />
        <DataTemplate x:Key="TitleSortTemplate" x:DataType="models:ExtendedTrack">
            <Grid
                Padding="12"
                helpers:GridColumnVisibilityHelper.SyncWithMusicGallerySettings="True"
                Background="Transparent"
                ColumnSpacing="12"
                DoubleTapped="SongListViewItem_DoubleTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Padding="0"
                    Text="{x:Bind Title}"
                    TextWrapping="Wrap" />
                <HyperlinkButton
                    Grid.Column="1"
                    Padding="0"
                    VerticalAlignment="Top"
                    Click="ArtistHyperlibkButton_Click">
                    <TextBlock Text="{x:Bind Artist}" TextWrapping="Wrap" />
                </HyperlinkButton>
                <HyperlinkButton
                    Grid.Column="2"
                    Padding="0"
                    VerticalAlignment="Top"
                    Click="AlbumHyperlibkButton_Click">
                    <TextBlock Text="{x:Bind Album}" TextWrapping="Wrap" />
                </HyperlinkButton>
                <TextBlock
                    Grid.Column="3"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Genre}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="4"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Year}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind TrackNumber}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="6"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Bitrate}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="7"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind SampleRate}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind AudioFormatShortName}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="9"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind FileSize, Converter={StaticResource FileSizeToStringConverter}}"
                    TextWrapping="Wrap" />
                <HyperlinkButton
                    Grid.Column="10"
                    Padding="0"
                    VerticalAlignment="Top"
                    Click="PathHyperlibkButton_Click">
                    <TextBlock Text="{x:Bind ParentFolderName}" TextWrapping="Wrap" />
                </HyperlinkButton>
                <TextBlock
                    Grid.Column="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Duration, Converter={StaticResource SecondsToFormattedTimeConverter}}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind DateCreated, Converter={StaticResource DateTimeToStringConverter}}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind DateModified, Converter={StaticResource DateTimeToStringConverter}}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid Padding="0,0,0,66" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="LeftSidePanel" Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Uid="MusicGalleryPagePlaylist"
                        Grid.Row="0"
                        Margin="12"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--  播放列表  -->
                        <ListView
                            x:Name="StarredPlaylistsListView"
                            Grid.Row="0"
                            ItemsSource="{x:Bind ViewModel.AppSettings.StarredPlaylists, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedSongsTabInfoIndex, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="settings:SongsTabInfo">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid
                                            Grid.Column="0"
                                            Background="Transparent"
                                            ColumnSpacing="6"
                                            Tapped="PlaylistGrid_Tapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                Grid.Column="0"
                                                FontFamily="{StaticResource SegoeFluentIcons}"
                                                FontSize="16"
                                                Glyph="{x:Bind Icon}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="0,8"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Text="{x:Bind Name}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                        <Button
                                            Grid.Column="1"
                                            Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                                  FontSize=16,
                                                                  Glyph=&#xE712;}"
                                            Style="{ThemeResource GhostButtonStyle}"
                                            Visibility="{x:Bind IsDefault, Converter={StaticResource BoolNegationToVisibilityConverter}}">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <!--  从播放列表移除  -->
                                                    <MenuFlyoutItem x:Uid="MusicGalleryPageRemoveFromCustomList" Click="RemoveFromPlaylistMenuFlyoutItem_Click" />
                                                    <MenuFlyoutItem
                                                        x:Uid="MusicGalleryPageOpenInFileExplorer"
                                                        Click="OpenPlaylistInFileExplorerMenuFlyoutItem_Click"
                                                        Visibility="{x:Bind FilterProperty, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=4}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <NavigationViewItemSeparator Grid.Row="1" />
                        <!--  命令区域  -->
                        <Grid Grid.Row="2">
                            <StackPanel>
                                <!--  创建播放列表  -->
                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Command="{x:Bind ViewModel.CreatePlaylistCommand}">
                                    <Button.Content>
                                        <StackPanel
                                            Padding="4,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <FontIcon
                                                FontFamily="{StaticResource SegoeFluentIcons}"
                                                FontSize="16"
                                                Glyph="&#xE710;" />
                                            <TextBlock x:Uid="MusicGalleryPageNewPlaylist" />
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                                <!--  导入播放列表  -->
                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Command="{x:Bind ViewModel.ImportPlaylistCommand}">
                                    <Button.Content>
                                        <StackPanel
                                            Padding="4,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <FontIcon
                                                FontFamily="{StaticResource SegoeFluentIcons}"
                                                FontSize="16"
                                                Glyph="&#xE896;" />
                                            <TextBlock x:Uid="MusicGalleryPageImportFromFile" />
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <NavigationViewItemSeparator Grid.Row="2" />
                    <StackPanel
                        Grid.Row="3"
                        Margin="12"
                        Orientation="Horizontal"
                        Spacing="3">
                        <TextBlock x:Uid="MusicGalleryPageFolder" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Button
                            Command="{x:Bind ViewModel.OpenMediaSettingsCommand}"
                            Content="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                                  FontSize=12,
                                                  Glyph=&#xE713;}"
                            Style="{ThemeResource GhostButtonStyle}" />
                    </StackPanel>
                    <TreeView
                        x:Name="FolderTreeView"
                        Grid.Row="4"
                        AllowDrop="False"
                        CanDrag="False"
                        CanDragItems="False"
                        ItemInvoked="FolderTreeView_ItemInvoked"
                        ItemsSource="{x:Bind ViewModel.FolderRoots, Mode=OneWay}"
                        SelectionMode="Single">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="models:FolderNode">
                                <TreeViewItem
                                    Background="Transparent"
                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                    ItemsSource="{x:Bind SubFolders}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Grid.Column="0"
                                            FontSize="16"
                                            Glyph="{x:Bind SourceType, Converter={StaticResource FileSourceTypeToIconConverter}}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind FolderName}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </ScrollViewer>
            <Grid x:Name="SongViewer" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="34" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <InfoBar
                        x:Uid="MusicGalleryPageDataSync"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsDataSyncing, Mode=OneWay}" />
                    <InfoBar
                        x:Uid="MusicGalleryPageDataSyncError"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsDataSyncError, Mode=OneWay}"
                        Severity="Error" />
                </StackPanel>
                <!--  顶部命令栏  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  切换卡  -->
                    <controls:Segmented
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        SelectedIndex="{x:Bind ViewModel.CurrentView, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}"
                        Visibility="{x:Bind ViewModel.IsMainView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <controls:SegmentedItem x:Uid="MusicGalleryPageSongsTab" />
                        <controls:SegmentedItem x:Uid="MusicGalleryPageAlbumsTab" />
                        <controls:SegmentedItem x:Uid="MusicGalleryPageArtistsTab" />
                        <controls:SegmentedItem Visibility="Collapsed" />
                        <controls:SegmentedItem Visibility="Collapsed" />
                    </controls:Segmented>
                    <!--  搜索  -->
                    <AutoSuggestBox
                        x:Name="SongSearchBox"
                        x:Uid="MusicGalleryPageSongSearchBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SongSearchQuery, Mode=TwoWay}" />
                </Grid>
                <NavigationViewItemSeparator Grid.Row="2" />
                <controls:SwitchPresenter
                    Grid.Row="3"
                    Visibility="{x:Bind ViewModel.IsLocalMediaNotFound, Mode=OneWay, Converter={StaticResource BoolNegationToVisibilityConverter}}"
                    Value="{x:Bind ViewModel.CurrentView, Mode=OneWay}">
                    <controls:SwitchPresenter.ContentTransitions>
                        <TransitionCollection>
                            <PopupThemeTransition />
                        </TransitionCollection>
                    </controls:SwitchPresenter.ContentTransitions>
                    <controls:Case Value="{x:Bind enums:MusicLibraryViewType.Songs}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!--  Fake Header  -->
                            <uc:SongListFakeHeaderControl
                                Grid.Row="0"
                                Margin="12,0"
                                ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                            <SemanticZoom Grid.Row="1">
                                <SemanticZoom.ZoomedInView>
                                    <ListView
                                        x:Name="SongListView"
                                        ItemTemplate="{StaticResource TitleSortTemplate}"
                                        ItemsSource="{x:Bind GroupedTracksCVS.View, Mode=OneWay}"
                                        RightTapped="SongListView_RightTapped"
                                        SelectionChanged="OnGenericSelectionChanged"
                                        SelectionMode="{x:Bind ViewModel.SongListViewSelectionMode, Mode=TwoWay, Converter={StaticResource AppListViewSelectionModeToListViewSelectionModeConverter}}">
                                        <ListView.ContextFlyout>
                                            <MenuBarItemFlyout Opened="AddToMenuBarItemFlyout_Opened">
                                                <MenuFlyoutSubItem x:Uid="MusicGalleryPageAddToPlayingQueue" IsEnabled="{x:Bind ViewModel.SelectedTracks.Count, Mode=OneWay, Converter={StaticResource IntToBoolConverter}}">
                                                    <MenuFlyoutItem x:Uid="MusicGalleryPageAddToNext" Click="AddSongToQueueNextMenuFlyoutItem_Click" />
                                                    <MenuFlyoutItem x:Uid="MusicGalleryPageAddToEnd" Click="AddSongToQueueEndMenuFlyoutItem_Click" />
                                                </MenuFlyoutSubItem>
                                                <MenuFlyoutSubItem
                                                    x:Name="AddToCustomListMenuFlyoutSubItem"
                                                    x:Uid="MusicGalleryPageAddToCustomList"
                                                    IsEnabled="{x:Bind ViewModel.SelectedTracks.Count, Mode=OneWay, Converter={StaticResource IntToBoolConverter}}" />
                                            </MenuBarItemFlyout>
                                        </ListView.ContextFlyout>
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel AreStickyGroupHeadersEnabled="True" />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderContainerStyle>
                                                    <Style BasedOn="{StaticResource InteractiveListViewHeaderStyle}" TargetType="ListViewHeaderItem" />
                                                </GroupStyle.HeaderContainerStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate x:DataType="models:GroupInfoList">
                                                        <TextBlock Text="{x:Bind}" />
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ListView.GroupStyle>
                                        <ListView.ItemContainerStyle>
                                            <Style BasedOn="{StaticResource ListViewStretchedItemContainerStyle}" TargetType="ListViewItem" />
                                        </ListView.ItemContainerStyle>
                                    </ListView>
                                </SemanticZoom.ZoomedInView>
                                <SemanticZoom.ZoomedOutView>
                                    <GridView
                                        MaxWidth="500"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ItemsSource="{x:Bind GroupedTracksCVS.View.CollectionGroups, Mode=OneWay}">
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="models:GroupInfoList">
                                                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding}" />
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </SemanticZoom.ZoomedOutView>
                            </SemanticZoom>
                        </Grid>
                    </controls:Case>
                    <controls:Case Value="{x:Bind enums:MusicLibraryViewType.Albums}">
                        <SemanticZoom>
                            <SemanticZoom.ZoomedInView>
                                <GridView
                                    x:Name="AlbumGridView"
                                    IsItemClickEnabled="{x:Bind ViewModel.SongListViewSelectionMode, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=1}"
                                    ItemClick="AlbumGridView_ItemClick"
                                    ItemsSource="{x:Bind GroupedAlbumsCVS.View, Mode=OneWay}"
                                    SelectionChanged="OnGenericSelectionChanged"
                                    SelectionMode="{x:Bind ViewModel.SongListViewSelectionMode, Mode=OneWay, Converter={StaticResource AppListViewSelectionModeToListViewSelectionModeConverter}}">
                                    <GridView.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderContainerStyle>
                                                <Style BasedOn="{StaticResource InteractiveGridViewHeaderStyle}" TargetType="GridViewHeaderItem" />
                                            </GroupStyle.HeaderContainerStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate x:DataType="models:GroupInfoList">
                                                    <TextBlock Text="{x:Bind}" />
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </GridView.GroupStyle>
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="models:AlbumModel">
                                            <StackPanel
                                                Width="150"
                                                Margin="8"
                                                Spacing="8">
                                                <Grid
                                                    Width="150"
                                                    Height="150"
                                                    CornerRadius="8">
                                                    <Image Source="{x:Bind LocalAlbumArtPath, Converter={StaticResource PathToImageConverter}}" Stretch="UniformToFill" />
                                                </Grid>
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{x:Bind Title}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </SemanticZoom.ZoomedInView>
                            <SemanticZoom.ZoomedOutView>
                                <GridView
                                    MaxWidth="500"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ItemsSource="{x:Bind GroupedAlbumsCVS.View.CollectionGroups, Mode=OneWay}">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="models:GroupInfoList">
                                            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding}" />
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </SemanticZoom.ZoomedOutView>
                        </SemanticZoom>
                    </controls:Case>
                    <controls:Case Value="{x:Bind enums:MusicLibraryViewType.Artists}">
                        <SemanticZoom>
                            <SemanticZoom.ZoomedInView>
                                <GridView
                                    x:Name="ArtistGridView"
                                    IsItemClickEnabled="{x:Bind ViewModel.SongListViewSelectionMode, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=1}"
                                    ItemClick="ArtistGridView_ItemClick"
                                    ItemsSource="{x:Bind GroupedArtistsCVS.View, Mode=OneWay}"
                                    SelectionChanged="OnGenericSelectionChanged"
                                    SelectionMode="{x:Bind ViewModel.SongListViewSelectionMode, Mode=OneWay, Converter={StaticResource AppListViewSelectionModeToListViewSelectionModeConverter}}">
                                    <GridView.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderContainerStyle>
                                                <Style BasedOn="{StaticResource InteractiveGridViewHeaderStyle}" TargetType="GridViewHeaderItem" />
                                            </GroupStyle.HeaderContainerStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate x:DataType="models:GroupInfoList">
                                                    <TextBlock Text="{x:Bind}" />
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </GridView.GroupStyle>
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ArtistModel">
                                            <StackPanel
                                                Width="150"
                                                Margin="8"
                                                HorizontalAlignment="Center"
                                                Spacing="8">
                                                <Grid
                                                    Width="120"
                                                    Height="120"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    CornerRadius="60">
                                                    <FontIcon
                                                        FontFamily="{StaticResource SegoeFluentIcons}"
                                                        FontSize="48"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE77B;" />
                                                </Grid>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{x:Bind Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </SemanticZoom.ZoomedInView>
                            <SemanticZoom.ZoomedOutView>
                                <GridView
                                    MaxWidth="500"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ItemsSource="{x:Bind GroupedArtistsCVS.View.CollectionGroups, Mode=OneWay}">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="models:GroupInfoList">
                                            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding}" />
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </SemanticZoom.ZoomedOutView>
                        </SemanticZoom>
                    </controls:Case>
                    <controls:Case Value="{x:Bind enums:MusicLibraryViewType.AlbumDetail}">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Column="0"
                                    Width="150"
                                    Height="150"
                                    CornerRadius="8">
                                    <Image Source="{x:Bind ViewModel.SelectedAlbum.LocalAlbumArtPath, Mode=OneWay, Converter={StaticResource PathToImageConverter}}" Stretch="UniformToFill" />
                                </Grid>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <TextBlock
                                        Style="{StaticResource TitleTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SelectedAlbum.Title, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!--  Fake Header  -->
                                <uc:SongListFakeHeaderControl
                                    Grid.Row="0"
                                    Margin="12,0"
                                    ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                                <ListView
                                    x:Name="AlbumDetailSongListView"
                                    Grid.Row="1"
                                    ItemTemplate="{StaticResource TitleSortTemplate}"
                                    ItemsSource="{x:Bind ViewModel.DetailTracks, Mode=OneWay}"
                                    RightTapped="SongListView_RightTapped"
                                    SelectionChanged="OnGenericSelectionChanged"
                                    SelectionMode="{x:Bind ViewModel.SongListViewSelectionMode, Mode=TwoWay, Converter={StaticResource AppListViewSelectionModeToListViewSelectionModeConverter}}">
                                    <ListView.ContextFlyout>
                                        <MenuBarItemFlyout Opened="AddToMenuBarItemFlyout_Opened">
                                            <MenuFlyoutSubItem x:Uid="MusicGalleryPageAddToPlayingQueue" IsEnabled="{x:Bind ViewModel.SelectedTracks.Count, Mode=OneWay, Converter={StaticResource IntToBoolConverter}}">
                                                <MenuFlyoutItem x:Uid="MusicGalleryPageAddToNext" Click="AddSongToQueueNextMenuFlyoutItem_Click" />
                                                <MenuFlyoutItem x:Uid="MusicGalleryPageAddToEnd" Click="AddSongToQueueEndMenuFlyoutItem_Click" />
                                            </MenuFlyoutSubItem>
                                            <MenuFlyoutSubItem
                                                x:Name="AddToCustomListMenuFlyoutSubItem_AlbumDetail"
                                                x:Uid="MusicGalleryPageAddToCustomList"
                                                IsEnabled="{x:Bind ViewModel.SelectedTracks.Count, Mode=OneWay, Converter={StaticResource IntToBoolConverter}}" />
                                        </MenuBarItemFlyout>
                                    </ListView.ContextFlyout>
                                    <ListView.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource ListViewStretchedItemContainerStyle}" TargetType="ListViewItem" />
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </Grid>
                        </Grid>
                    </controls:Case>
                    <controls:Case Value="{x:Bind enums:MusicLibraryViewType.ArtistDetail}">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Column="0"
                                    Width="150"
                                    Height="150"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="75">
                                    <FontIcon
                                        FontFamily="{StaticResource SegoeFluentIcons}"
                                        FontSize="60"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE77B;" />
                                </Grid>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <TextBlock
                                        Style="{StaticResource TitleTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SelectedArtist.Name, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!--  Fake Header  -->
                                <uc:SongListFakeHeaderControl
                                    Grid.Row="0"
                                    Margin="12,0"
                                    ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                                <ListView
                                    x:Name="ArtistDetailSongListView"
                                    Grid.Row="1"
                                    ItemTemplate="{StaticResource TitleSortTemplate}"
                                    ItemsSource="{x:Bind ViewModel.DetailTracks, Mode=OneWay}"
                                    RightTapped="SongListView_RightTapped"
                                    SelectionChanged="OnGenericSelectionChanged"
                                    SelectionMode="{x:Bind ViewModel.SongListViewSelectionMode, Mode=TwoWay, Converter={StaticResource AppListViewSelectionModeToListViewSelectionModeConverter}}">
                                    <ListView.ContextFlyout>
                                        <MenuBarItemFlyout Opened="AddToMenuBarItemFlyout_Opened">
                                            <MenuFlyoutSubItem x:Uid="MusicGalleryPageAddToPlayingQueue" IsEnabled="{x:Bind ViewModel.SelectedTracks.Count, Mode=OneWay, Converter={StaticResource IntToBoolConverter}}">
                                                <MenuFlyoutItem x:Uid="MusicGalleryPageAddToNext" Click="AddSongToQueueNextMenuFlyoutItem_Click" />
                                                <MenuFlyoutItem x:Uid="MusicGalleryPageAddToEnd" Click="AddSongToQueueEndMenuFlyoutItem_Click" />
                                            </MenuFlyoutSubItem>
                                            <MenuFlyoutSubItem
                                                x:Name="AddToCustomListMenuFlyoutSubItem_ArtistDetail"
                                                x:Uid="MusicGalleryPageAddToCustomList"
                                                IsEnabled="{x:Bind ViewModel.SelectedTracks.Count, Mode=OneWay, Converter={StaticResource IntToBoolConverter}}" />
                                        </MenuBarItemFlyout>
                                    </ListView.ContextFlyout>
                                    <ListView.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource ListViewStretchedItemContainerStyle}" TargetType="ListViewItem" />
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </Grid>
                        </Grid>
                    </controls:Case>
                </controls:SwitchPresenter>
                <Grid Grid.Row="3" Visibility="{x:Bind ViewModel.IsLocalMediaNotFound, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                        <Image MaxWidth="200" Source="/Assets/EmptyState.png" />
                        <TextBlock
                            x:Uid="MusicGalleryPageFileNotFound"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <NavigationViewItemSeparator Grid.Row="4" />
                <!--  底部命令栏  -->
                <Grid
                    Grid.Row="5"
                    Margin="0,0,0,6"
                    ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  多选  -->
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <!--  切换选择模式  -->
                        <ToggleButton
                            x:Name="SongListViewSelectionModeToggleButton"
                            Grid.Column="0"
                            Command="{x:Bind ViewModel.ToggleSongListViewSelectionModeCommand}"
                            Content="{ui:FontIcon FontSize=16,
                                                  FontFamily={StaticResource SegoeFluentIcons},
                                                  Glyph=&#xE762;}"
                            Style="{ThemeResource GhostToggleButtonStyle}" />
                        <!--  为多选模式保留  -->
                        <CheckBox
                            x:Name="SelectAllCheckBox"
                            Grid.Column="1"
                            MinWidth="0"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Checked="SelectAllCheckBox_Checked"
                            Unchecked="SelectAllCheckBox_Unchecked"
                            Visibility="{Binding ElementName=SongListViewSelectionModeToggleButton, Path=IsChecked, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                        <RichTextBlock
                            Grid.Column="2"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                            <Paragraph>
                                <Run Text="{x:Bind ViewModel.SelectedTracks.Count, Mode=OneWay}" />
                                <Run Text="/" />
                                <Run Text="{x:Bind GroupedTracksCVS.View.Count, Mode=OneWay}" />
                                <Run Text="{x:Bind ViewModel.SelectedTracksTotalDuration, Mode=OneWay, Converter={StaticResource SecondsToFormattedTimeConverter}}" />
                            </Paragraph>
                        </RichTextBlock>
                    </Grid>
                    <!--  播放  -->
                    <Grid Grid.Column="2" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Uid="MusicGalleryPageShufflePlay"
                            Grid.Column="0"
                            Command="{x:Bind ViewModel.ShuffleCommand}" />
                        <Button
                            x:Uid="MusicGalleryPageRepeatAll"
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.RepeatAllCommand}" />
                    </Grid>
                </Grid>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <controls:SwitchPresenter Value="{x:Bind ViewModel.AppSettings.MusicGallerySettings.TrackInfoDisplayTarget, Mode=OneWay}">
                        <controls:SwitchPresenter.ContentTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                            </TransitionCollection>
                        </controls:SwitchPresenter.ContentTransitions>
                        <controls:Case Value="{x:Bind enums:TrackInfoDisplayTarget.SelectedItem}">
                            <uc:TrackDetailCard ExtendedTrack="{x:Bind ViewModel.SelectedFirstTrack, Mode=OneWay}" />
                        </controls:Case>
                        <controls:Case Value="{x:Bind enums:TrackInfoDisplayTarget.PlayingItem}">
                            <uc:TrackDetailCard ExtendedTrack="{x:Bind ViewModel.SMTCService.PlayingTrack, Mode=OneWay}" />
                        </controls:Case>
                    </controls:SwitchPresenter>
                    <controls:Segmented
                        Margin="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        SelectedIndex="{x:Bind ViewModel.AppSettings.MusicGallerySettings.TrackInfoDisplayTarget, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                        <controls:SegmentedItem Icon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xE962;}">
                            <ToolTipService.ToolTip>
                                <ToolTip x:Uid="MusicGalleryPageSelectedTrackDetail" />
                            </ToolTipService.ToolTip>
                        </controls:SegmentedItem>
                        <controls:SegmentedItem Icon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xEC4F;}">
                            <ToolTipService.ToolTip>
                                <ToolTip x:Uid="MusicGalleryPagePlayingTrackDetail" />
                            </ToolTipService.ToolTip>
                        </controls:SegmentedItem>
                    </controls:Segmented>
                </Grid>
                <uc:PlayQueue x:Name="PlayQueue" Grid.Row="1" />
            </Grid>
        </Grid>
    </Grid>
</Page>