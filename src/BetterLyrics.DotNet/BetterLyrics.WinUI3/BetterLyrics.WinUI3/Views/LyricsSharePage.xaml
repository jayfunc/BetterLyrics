<?xml version="1.0" encoding="utf-8" ?>

<Page
    x:Class="BetterLyrics.WinUI3.Views.LyricsSharePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lyrics="using:BetterLyrics.Core.Models.Lyrics"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BetterLyrics.Core.Models"
    xmlns:uc="using:BetterLyrics.WinUI3.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Page.Resources>
        <CollectionViewSource
            x:Name="StyleGroupsCVS"
            IsSourceGrouped="True"
            Source="{x:Bind ViewModel.StyleGroups, Mode=OneWay}" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColDef" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightColDef" />
        </Grid.ColumnDefinitions>

        <Grid
            Grid.Column="0"
            Padding="24"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Uid="LyricsSharePageSelectLyricsTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <CheckBox
                    x:Name="LyricsHostCheckBox"
                    Click="LyricsHostCheckBox_Click"
                    IsThreeState="True" />
            </StackPanel>
            <ListView
                x:Name="LyricsListView"
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.GSMTCService.CurrentLyricsData.LyricsLines, Mode=OneWay}"
                SelectionChanged="LyricsListView_SelectionChanged"
                SelectionMode="Multiple">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="lyrics:LyricsLine">
                        <StackPanel Padding="0,8" Spacing="2">
                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind SecondaryText}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind SecondaryText, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid
            Grid.Column="1"
            Margin="24"
            RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:WrapPanel
                Grid.Row="0"
                Margin="0,0,0,16"
                HorizontalSpacing="6"
                VerticalSpacing="6">
                <DropDownButton>
                    <DropDownButton.Content>
                        <TextBlock x:Uid="LyricsSharePageFontFamily" />
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <Flyout FlyoutPresenterStyle="{StaticResource FlyoutGhostStyle}">
                            <uc:FontPicker MaxWidth="400" SelectedFontId="{x:Bind ViewModel.CardConfig.FontFamily, Mode=TwoWay}" />
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <DropDownButton>
                    <DropDownButton.Content>
                        <TextBlock x:Uid="LyricsSharePageImageQuality" />
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <Flyout>
                            <uc:ExtendedSlider
                                x:Name="ImageQualitySlider"
                                Default="100"
                                Frequency="1"
                                Maximum="100"
                                Minimum="10"
                                Unit="%"
                                Value="100" />
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

            </controls:WrapPanel>

            <Viewbox x:Name="PreviewCardContainer" Grid.Row="1">
                <uc:LyricsCard
                    x:Name="PreviewCard"
                    Title="{x:Bind ViewModel.CardData.Title, Mode=OneWay}"
                    Artist="{x:Bind ViewModel.CardData.Artist, Mode=OneWay}"
                    CoverAccentColor="{x:Bind ViewModel.CardData.AccentCoverColor, Converter={StaticResource AppColorToColorConverter}, Mode=OneWay}"
                    CoverImage="{x:Bind ViewModel.CardData.CoverImageBytes, Converter={StaticResource ByteArrayToImageConverter}, Mode=OneWay}"
                    LyricsLines="{x:Bind ViewModel.CardData.Lyrics, Mode=OneWay}"
                    StyleKey="{x:Bind ViewModel.SelectedStyleItem.StyleKey, Mode=OneWay}" />
            </Viewbox>
            <TextBlock
                Grid.Row="2"
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.SelectedStyleItem.DisplayText, Mode=OneWay}" />
        </Grid>

        <Grid
            Grid.Column="2"
            Padding="24"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Uid="LyricsSharePageStyleTitle"
                Grid.Row="0"
                Style="{StaticResource SubtitleTextBlockStyle}" />

            <Grid Grid.Row="1">
                <SemanticZoom>
                    <SemanticZoom.ZoomedInView>
                        <GridView ItemsSource="{Binding Source={StaticResource StyleGroupsCVS}}" SelectedItem="{x:Bind ViewModel.SelectedStyleItem, Mode=TwoWay}">

                            <GridView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ItemContainerStyle>

                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid HorizontalAlignment="Stretch" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>

                            <GridView.GroupStyle>
                                <GroupStyle>

                                    <GroupStyle.HeaderContainerStyle>
                                        <Style TargetType="GridViewHeaderItem">
                                            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                                            <Setter Property="FontSize" Value="{ThemeResource GridViewHeaderItemThemeFontSize}" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Margin" Value="0,0,0,4" />
                                            <Setter Property="Padding" Value="6,12" />
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                            <Setter Property="VerticalContentAlignment" Value="Top" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="CornerRadius" Value="4" />
                                            <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GridViewHeaderItem">
                                                        <Grid
                                                            x:Name="RootGrid"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="{TemplateBinding CornerRadius}">
                                                            <ContentPresenter
                                                                x:Name="ContentPresenter"
                                                                Margin="{TemplateBinding Padding}"
                                                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                Content="{TemplateBinding Content}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                ContentTransitions="{TemplateBinding ContentTransitions}" />
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualStateGroup.Transitions>
                                                                        <VisualTransition GeneratedDuration="0:0:0.1" />
                                                                    </VisualStateGroup.Transitions>

                                                                    <VisualState x:Name="Normal" />

                                                                    <VisualState x:Name="PointerOver">
                                                                        <VisualState.Setters>
                                                                            <Setter Target="RootGrid.Background" Value="{ThemeResource ListViewItemBackgroundPointerOver}" />
                                                                        </VisualState.Setters>
                                                                    </VisualState>

                                                                    <VisualState x:Name="Pressed">
                                                                        <VisualState.Setters>
                                                                            <Setter Target="RootGrid.Background" Value="{ThemeResource ListViewItemBackgroundPressed}" />
                                                                        </VisualState.Setters>
                                                                    </VisualState>

                                                                    <VisualState x:Name="Disabled">
                                                                        <VisualState.Setters>
                                                                            <Setter Target="ContentPresenter.Opacity" Value="{ThemeResource ListViewItemDisabledThemeOpacity}" />
                                                                        </VisualState.Setters>
                                                                    </VisualState>
                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.HeaderContainerStyle>

                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate x:DataType="models:LyricsCardStyleGroup">
                                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind GroupTitle}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>

                                    <GroupStyle.Panel>
                                        <ItemsPanelTemplate>
                                            <controls:WrapPanel
                                                HorizontalSpacing="8"
                                                Orientation="Horizontal"
                                                VerticalSpacing="8" />
                                        </ItemsPanelTemplate>
                                    </GroupStyle.Panel>

                                </GroupStyle>
                            </GridView.GroupStyle>

                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:LyricsCardStyleItem">
                                    <Grid Padding="0" Style="{StaticResource CardGridStyle}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                            <Viewbox
                                                Width="110"
                                                Height="150"
                                                IsHitTestVisible="False"
                                                Stretch="Uniform"
                                                Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <uc:LyricsCard
                                                    Title="{x:Bind CardData.Title}"
                                                    Artist="{x:Bind CardData.Artist}"
                                                    LyricsLines="{x:Bind CardData.Lyrics}"
                                                    StyleKey="{x:Bind StyleKey}" />
                                            </Viewbox>
                                        </Grid>
                                        <TextBlock
                                            Grid.Row="1"
                                            Width="94"
                                            Margin="8"
                                            HorizontalAlignment="Center"
                                            Text="{x:Bind DisplayText}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </SemanticZoom.ZoomedInView>
                    <SemanticZoom.ZoomedOutView>
                        <ListView
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding Source={StaticResource StyleGroupsCVS}, Path=CollectionGroups}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="0,12"
                                        Style="{ThemeResource SubtitleTextBlockStyle}"
                                        Text="{Binding Group.GroupTitle}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </SemanticZoom.ZoomedOutView>
                </SemanticZoom>
                <controls:Segmented
                    Margin="0,6,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    SelectedIndex="{x:Bind ViewModel.SelectedStyleDisplayTypeIndex, Mode=TwoWay}">
                    <controls:SegmentedItem Content="{ui:FontIcon FontSize=16, FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xE8C0;}" />
                    <controls:SegmentedItem Content="{ui:FontIcon FontSize=16, FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xE8BF;}" />
                </controls:Segmented>
            </Grid>

            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Uid="LyricsSharePageSaveImage"
                        Click="SaveImage_Click"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button x:Uid="LyricsSharePageCopyImage" Click="CopyImage_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid
            x:Name="ProcessingOverlay"
            Grid.ColumnSpan="3"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Opacity="0"
            Visibility="Collapsed">
            <Grid.OpacityTransition>
                <ScalarTransition />
            </Grid.OpacityTransition>
            <ProgressRing />
        </Grid>

    </Grid>
</Page>