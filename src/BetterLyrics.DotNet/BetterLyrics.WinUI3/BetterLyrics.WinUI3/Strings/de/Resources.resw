  <data name="StoryPageOverviewText1.Text" xml:space="preserve"><value>In der letzten Zeit,</value></data>
  <data name="StoryPageOverviewText2.Text" xml:space="preserve"><value>du gingst durch Klang und Land</value></data>
  <data name="StoryPageOverviewCountUnit.Text" xml:space="preserve"><value>Mal</value></data>
  <data name="StoryPageOverviewText3.Text" xml:space="preserve"><value>und hielst die Melodie in Hand</value></data>
  <data name="StoryPageOverviewHourUnit.Text" xml:space="preserve"><value>Stunden</value></data>
  <data name="StoryPageTimeText1.Text" xml:space="preserve"><value>Du liebtest es, dich zu verlieren um</value></data>
  <data name="StoryPageTimeText2.Text" xml:space="preserve"><value>wo die Nacht leise klang,</value></data>
  <data name="StoryPageTimeText3.Text" xml:space="preserve"><value>als die Welt fern war und der Rhythmus dich sang</value></data>
  <data name="StoryPageTimeText4.Text" xml:space="preserve"><value>Doch um</value></data>
  <data name="StoryPageTimeText5.Text" xml:space="preserve"><value>zog dich die Stille in ihren Klang</value></data>
  <data name="StoryPageTopArtistText1.Text" xml:space="preserve"><value>Im Meer der Gesichter,</value></data>
  <data name="StoryPageTopArtistText2.Text" xml:space="preserve"><value>zog dich</value></data>
  <data name="StoryPageTopArtistText3.Text" xml:space="preserve"><value>wie ein alter, vertrauter Klang</value></data>
  <data name="StoryPageTopArtistText4.Text" xml:space="preserve"><value>Dieser Klang begleitete dich durch</value></data>
  <data name="StoryPageTopArtistText5.Text" xml:space="preserve"><value>Lieder, und blieb dein Klang</value></data>
  <data name="StoryPageTopSongText1.Text" xml:space="preserve"><value>Eine Melodie gab es,</value></data>
  <data name="StoryPageTopSongText2.Text" xml:space="preserve"><value>die dich leise berührte...</value></data>
  <data name="StoryPageTopSongText3.Text" xml:space="preserve"><value>Du hast sie</value></data>
  <data name="StoryPageTopSongText4.Text" xml:space="preserve"><value>Male gehört, und sie hat dich geführt</value></data>
  <data name="StoryPageStreakText1.Text" xml:space="preserve"><value>Am </value></data>
  <data name="StoryPageStreakText2.Text" xml:space="preserve"><value> vergaßest du im Klang das Morgen</value></data>
  <data name="StoryPageStreakText3.Text" xml:space="preserve"><value>Du hörst </value></data>
  <data name="StoryPageStreakText4.Text" xml:space="preserve"><value>Lieder, ein jedes ein neues Morgen</value></data>
  <data name="StoryPageStreakText5.Text" xml:space="preserve"><value>Du hieltest die Kette</value></data>
  <data name="StoryPageStreakText6.Text" xml:space="preserve"><value>Tage, und der Klang blieb geborgen</value></data>
  <data name="StoryPageSpecialMomentText1.Text" xml:space="preserve"><value>Wo die Reise begann,</value></data>
  <data name="StoryPageSpecialMomentText2.Text" xml:space="preserve"><value>war dieses Lied der Schlüssel:</value></data>
  <data name="StoryPageSpecialMomentText3.Text" xml:space="preserve"><value>Am </value></data>
  <data name="StoryPageSpecialMomentText4.Text" xml:space="preserve"><value>,</value></data>
  <data name="StoryPageSpecialMomentText5.Text" xml:space="preserve"><value>um </value></data>
  <data name="StoryPageSpecialMomentText6.Text" xml:space="preserve"><value> hörst du noch immer, was er erschloss:</value></data>
  <data name="StoryPagePersonaText1.Text" xml:space="preserve"><value>Im Spiegel des Lieds erscheint dein Musikprofil:</value></data>
  <data name="PersonaDefaultTitle" xml:space="preserve"><value>Musikentdecker</value></data>
  <data name="PersonaDefaultDesc" xml:space="preserve"><value>Du streifst frei durch die Welt des Klangs</value></data>
  <data name="PersonaNightOwlTitle" xml:space="preserve"><value>Nachteule</value></data>
  <data name="PersonaNightOwlDesc" xml:space="preserve"><value>Je tiefer die Nacht, desto näher der Klang</value></data>
  <data name="PersonaStreakTitle" xml:space="preserve"><value>Melodiensüchtig</value></data>
  <data name="PersonaStreakDesc" xml:space="preserve"><value>Ein Tag ohne Musik fühlt sich zu lang an</value></data>
  <data name="PersonaLoyalTitle" xml:space="preserve"><value>Treuer Fan</value></data>
  <data name="PersonaLoyalDesc" xml:space="preserve"><value>Eine Stimme bleibt dir, Nacht und Tag, im Klang</value></data>
