  <data name="StatsDashboardControlMemoirTitle.Text" xml:space="preserve"><value>Memorie musicali</value></data>
  <data name="StatsDashboardControlMemoirDesc.Text" xml:space="preserve"><value>Ripercorrere il percorso musicale e generare un report di ascolto personalizzato</value></data>
  <data name="StatsDashboardControlMemoirPlay.Text" xml:space="preserve"><value>Riproduci ora</value></data>
  <data name="StatsDashboardControlStartText.Text" xml:space="preserve"><value>Da</value></data>
  <data name="StatsDashboardControlEndText.Text" xml:space="preserve"><value>A</value></data>
  <data name="StatsDashboardControlHours.Text" xml:space="preserve"><value>Ore</value></data>
  <data name="StoryPageOverviewText1.Text" xml:space="preserve"><value>In questo tempo,</value></data>
  <data name="StoryPageOverviewText2.Text" xml:space="preserve"><value>ha attraversato una terra musicale</value></data>
  <data name="StoryPageOverviewCountUnit.Text" xml:space="preserve"><value>volte</value></data>
  <data name="StoryPageOverviewText3.Text" xml:space="preserve"><value>e tenuto la melodia in mano</value></data>
  <data name="StoryPageOverviewHourUnit.Text" xml:space="preserve"><value>ore</value></data>
  <data name="StoryPageTimeText1.Text" xml:space="preserve"><value>Le piaceva perdersi alle</value></data>
  <data name="StoryPageTimeText2.Text" xml:space="preserve"><value>dove la notte suonava,</value></data>
  <data name="StoryPageTimeText3.Text" xml:space="preserve"><value>quando il mondo taceva e la musica l'abbracciava</value></data>
  <data name="StoryPageTimeText4.Text" xml:space="preserve"><value>E alle </value></data>
  <data name="StoryPageTimeText5.Text" xml:space="preserve"><value> sceglieva il silenzio che l'abbracciava</value></data>
  <data name="StoryPageTopArtistText1.Text" xml:space="preserve"><value>Tra tanti volti,</value></data>
  <data name="StoryPageTopArtistText2.Text" xml:space="preserve"><value>la attraeva</value></data>
  <data name="StoryPageTopArtistText3.Text" xml:space="preserve"><value>la cui voce le era sorella</value></data>
  <data name="StoryPageTopArtistText4.Text" xml:space="preserve"><value>Quella voce l'ha seguita attraverso</value></data>
  <data name="StoryPageTopArtistText5.Text" xml:space="preserve"><value>brani, e ancora le è vicina</value></data>
  <data name="StoryPageTopSongText1.Text" xml:space="preserve"><value>C'era una melodia,</value></data>
  <data name="StoryPageTopSongText2.Text" xml:space="preserve"><value>che appariva all'improvviso e la accarezzava...</value></data>
  <data name="StoryPageTopSongText3.Text" xml:space="preserve"><value>L'ha ascoltata</value></data>
  <data name="StoryPageTopSongText4.Text" xml:space="preserve"><value>volte, e ancora la commuove</value></data>
  <data name="StoryPageStreakText1.Text" xml:space="preserve"><value>Il </value></data>
  <data name="StoryPageStreakText2.Text" xml:space="preserve"><value> si è lasciata portare dal suono, dimenticando il domani</value></data>
  <data name="StoryPageStreakText3.Text" xml:space="preserve"><value>Ha ascoltato </value></data>
  <data name="StoryPageStreakText4.Text" xml:space="preserve"><value>brani, ciascuno un nuovo domani</value></data>
  <data name="StoryPageStreakText5.Text" xml:space="preserve"><value>Ha mantenuto la serie </value></data>
  <data name="StoryPageStreakText6.Text" xml:space="preserve"><value>giorni, e il canto tornava ogni domani</value></data>
  <data name="StoryPageSpecialMomentText1.Text" xml:space="preserve"><value>Dove è iniziato il viaggio,</value></data>
  <data name="StoryPageSpecialMomentText2.Text" xml:space="preserve"><value>questa canzone era la chiave:</value></data>
  <data name="StoryPageSpecialMomentText3.Text" xml:space="preserve"><value>Il </value></data>
  <data name="StoryPageSpecialMomentText4.Text" xml:space="preserve"><value>,</value></data>
  <data name="StoryPageSpecialMomentText5.Text" xml:space="preserve"><value>alle </value></data>
  <data name="StoryPageSpecialMomentText6.Text" xml:space="preserve"><value> ascoltava ancora, libera e lieve:</value></data>
  <data name="StoryPagePersonaText1.Text" xml:space="preserve"><value>Allo specchio della canzone, il suo personaggio musicale è:</value></data>
  <data name="PersonaDefaultTitle" xml:space="preserve"><value>Esploratore musicale</value></data>
  <data name="PersonaDefaultDesc" xml:space="preserve"><value>Vaga libera dove risuona la canzone</value></data>
  <data name="PersonaNightOwlTitle" xml:space="preserve"><value>Nottambulo</value></data>
  <data name="PersonaNightOwlDesc" xml:space="preserve"><value>Più la notte è profonda, più la canzone le è vicina</value></data>
  <data name="PersonaStreakTitle" xml:space="preserve"><value>Dipendente dalle melodie</value></data>
  <data name="PersonaStreakDesc" xml:space="preserve"><value>Una giornata senza musica le sembra troppo lunga</value></data>
  <data name="PersonaLoyalTitle" xml:space="preserve"><value>Fan fedele</value></data>
  <data name="PersonaLoyalDesc" xml:space="preserve"><value>Una voce resta in lei, dal mattino alla canzone</value></data>
  <data name="PersonaExplorerTitle" xml:space="preserve"><value>Esploratore musicale</value></data>
  <data name="PersonaExplorerDesc" xml:space="preserve"><value>Ogni suono lontano trova in lei la sua canzone</value></data>
