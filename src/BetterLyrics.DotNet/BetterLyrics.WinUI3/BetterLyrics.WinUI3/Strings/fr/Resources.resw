  <data name="StoryPageOverviewText1.Text" xml:space="preserve"><value>Durant ce temps,</value></data>
  <data name="StoryPageOverviewText2.Text" xml:space="preserve"><value>vous avez traversé une terre musicale</value></data>
  <data name="StoryPageOverviewCountUnit.Text" xml:space="preserve"><value>fois</value></data>
  <data name="StoryPageOverviewText3.Text" xml:space="preserve"><value>et gardé la mélodie en main</value></data>
  <data name="StoryPageOverviewHourUnit.Text" xml:space="preserve"><value>heures</value></data>
  <data name="StoryPageTimeText1.Text" xml:space="preserve"><value>Vous aimiez vous perdre à</value></data>
  <data name="StoryPageTimeText2.Text" xml:space="preserve"><value>où la nuit chantait doucement,</value></data>
  <data name="StoryPageTimeText3.Text" xml:space="preserve"><value>quand le monde s'effaçait dans un tendre moment</value></data>
  <data name="StoryPageTimeText4.Text" xml:space="preserve"><value>Et à </value></data>
  <data name="StoryPageTimeText5.Text" xml:space="preserve"><value> vous choisissiez le calme et le moment</value></data>
  <data name="StoryPageTopArtistText1.Text" xml:space="preserve"><value>Parmi la foule,</value></data>
  <data name="StoryPageTopArtistText2.Text" xml:space="preserve"><value>vous attirait</value></data>
  <data name="StoryPageTopArtistText3.Text" xml:space="preserve"><value>dont la voix vous ressemblait</value></data>
  <data name="StoryPageTopArtistText4.Text" xml:space="preserve"><value>Cette voix vous a suivi à travers</value></data>
  <data name="StoryPageTopArtistText5.Text" xml:space="preserve"><value>chansons, et le charme subsistait</value></data>
  <data name="StoryPageTopSongText1.Text" xml:space="preserve"><value>Il était une mélodie,</value></data>
  <data name="StoryPageTopSongText2.Text" xml:space="preserve"><value>qui surgissait, imprévisible, dans vos pensées...</value></data>
  <data name="StoryPageTopSongText3.Text" xml:space="preserve"><value>Vous l'avez écoutée</value></data>
  <data name="StoryPageTopSongText4.Text" xml:space="preserve"><value>fois, et l'émotion est restée</value></data>
  <data name="StoryPageStreakText1.Text" xml:space="preserve"><value>Le </value></data>
  <data name="StoryPageStreakText2.Text" xml:space="preserve"><value> vous vous êtes laissé porter par l'air, oubliant l'avenir</value></data>
  <data name="StoryPageStreakText3.Text" xml:space="preserve"><value>Vous avez écouté </value></data>
  <data name="StoryPageStreakText4.Text" xml:space="preserve"><value>chansons, chacune un nouvel avenir</value></data>
  <data name="StoryPageStreakText5.Text" xml:space="preserve"><value>Vous avez gardé la série </value></data>
  <data name="StoryPageStreakText6.Text" xml:space="preserve"><value>jours, et la musique a su revenir</value></data>
  <data name="StoryPageSpecialMomentText1.Text" xml:space="preserve"><value>Là où le voyage a commencé,</value></data>
  <data name="StoryPageSpecialMomentText2.Text" xml:space="preserve"><value>cette chanson en était la clé :</value></data>
  <data name="StoryPageSpecialMomentText3.Text" xml:space="preserve"><value>Le </value></data>
  <data name="StoryPageSpecialMomentText4.Text" xml:space="preserve"><value>,</value></data>
  <data name="StoryPageSpecialMomentText5.Text" xml:space="preserve"><value>à </value></data>
  <data name="StoryPageSpecialMomentText6.Text" xml:space="preserve"><value> vous écoutiez encore, libre et léger :</value></data>
  <data name="StoryPagePersonaText1.Text" xml:space="preserve"><value>Dans le miroir de la chanson, votre personnage musical est :</value></data>
