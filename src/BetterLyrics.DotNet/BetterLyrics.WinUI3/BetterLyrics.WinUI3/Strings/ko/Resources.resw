  <data name="StoryPageTimeText1.Text" xml:space="preserve"><value>당신은 항상</value></data>
  <data name="StoryPageTimeText2.Text" xml:space="preserve"><value>에 마음을 맡기고,</value></data>
  <data name="StoryPageTimeText3.Text" xml:space="preserve"><value>별도 함께 울던 순간이었어요</value></data>
  <data name="StoryPageTimeText4.Text" xml:space="preserve"><value>그리고 </value></data>
  <data name="StoryPageTimeText5.Text" xml:space="preserve"><value>에는 고요에 귀를 기울였어요</value></data>
  <data name="StoryPageTopArtistText1.Text" xml:space="preserve"><value>수많은 사람 속에서,</value></data>
  <data name="StoryPageTopArtistText2.Text" xml:space="preserve"><value>당신은</value></data>
  <data name="StoryPageTopArtistText3.Text" xml:space="preserve"><value>의 목소리에 끌렸어요</value></data>
  <data name="StoryPageTopArtistText4.Text" xml:space="preserve"><value>그 목소리는</value></data>
