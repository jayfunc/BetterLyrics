  <data name="StoryPageOverviewText1.Text" xml:space="preserve"><value>この少しのあいだ、</value></data>
  <data name="StoryPageOverviewText2.Text" xml:space="preserve"><value>音楽とめぐり逢い</value></data>
  <data name="StoryPageOverviewCountUnit.Text" xml:space="preserve"><value>回</value></data>
  <data name="StoryPageOverviewText3.Text" xml:space="preserve"><value>旋律にただよい</value></data>
  <data name="StoryPageOverviewHourUnit.Text" xml:space="preserve"><value>時間</value></data>
  <data name="StoryPageTimeText1.Text" xml:space="preserve"><value>あなたはいつも</value></data>
  <data name="StoryPageTimeText2.Text" xml:space="preserve"><value>に心を預け、</value></data>
  <data name="StoryPageTimeText3.Text" xml:space="preserve"><value>星も響きに耳を澄ます頃</value></data>
  <data name="StoryPageTimeText4.Text" xml:space="preserve"><value>そして</value></data>
  <data name="StoryPageTimeText5.Text" xml:space="preserve"><value>には静けさに耳を澄ます</value></data>
  <data name="StoryPageTopArtistText1.Text" xml:space="preserve"><value>人波の中で、</value></data>
  <data name="StoryPageTopArtistText2.Text" xml:space="preserve"><value>あなたは</value></data>
  <data name="StoryPageTopArtistText3.Text" xml:space="preserve"><value>の声に、深く惹かれる</value></data>
  <data name="StoryPageTopArtistText4.Text" xml:space="preserve"><value>その声はあなたと共に</value></data>
  <data name="StoryPageTopArtistText5.Text" xml:space="preserve"><value>曲を越えて、まだ惹かれる</value></data>
  <data name="StoryPageTopSongText1.Text" xml:space="preserve"><value>ある旋律が、</value></data>
  <data name="StoryPageTopSongText2.Text" xml:space="preserve"><value>ふとした瞬間に胸を打つ……</value></data>
  <data name="StoryPageTopSongText3.Text" xml:space="preserve"><value>あなたはそれを</value></data>
  <data name="StoryPageTopSongText4.Text" xml:space="preserve"><value>回、いまだに胸を打つ</value></data>
  <data name="StoryPageStreakText1.Text" xml:space="preserve"><value></value></data>
  <data name="StoryPageStreakText2.Text" xml:space="preserve"><value> この日、旋律にただよい、明日を忘れた</value></data>
  <data name="StoryPageStreakText3.Text" xml:space="preserve"><value>あなたは</value></data>
  <data name="StoryPageStreakText4.Text" xml:space="preserve"><value>曲、どれも心に残った</value></data>
  <data name="StoryPageStreakText5.Text" xml:space="preserve"><value>あなたは</value></data>
  <data name="StoryPageStreakText6.Text" xml:space="preserve"><value>日、途切れぬ響きを保った</value></data>
  <data name="StoryPageSpecialMomentText1.Text" xml:space="preserve"><value>旅の始まりは、</value></data>
  <data name="StoryPageSpecialMomentText2.Text" xml:space="preserve"><value>この歌に導かれた：</value></data>
  <data name="StoryPageSpecialMomentText3.Text" xml:space="preserve"><value></value></data>
  <data name="StoryPageSpecialMomentText4.Text" xml:space="preserve"><value>、</value></data>
  <data name="StoryPageSpecialMomentText5.Text" xml:space="preserve"><value></value></data>
  <data name="StoryPageSpecialMomentText6.Text" xml:space="preserve"><value> あなたはまだ聴いていた：</value></data>
  <data name="StoryPagePersonaText1.Text" xml:space="preserve"><value>歌を鏡に、あなたの音楽人格は：</value></data>
