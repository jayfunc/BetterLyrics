  <data name="StatsDashboardControlHours.Text" xml:space="preserve"><value>H</value></data>
  <data name="StoryPageOverviewText1.Text" xml:space="preserve"><value>Durante este tiempo,</value></data>
  <data name="StoryPageOverviewText2.Text" xml:space="preserve"><value>cruzaste una tierra musical</value></data>
  <data name="StoryPageOverviewCountUnit.Text" xml:space="preserve"><value>veces</value></data>
  <data name="StoryPageOverviewText3.Text" xml:space="preserve"><value>y sostuviste la melodía en la mano</value></data>
  <data name="StoryPageOverviewHourUnit.Text" xml:space="preserve"><value>horas</value></data>
  <data name="StoryPageTimeText1.Text" xml:space="preserve"><value>A usted le gustaba perderse a</value></data>
  <data name="StoryPageTimeText2.Text" xml:space="preserve"><value>donde la noche sonaba,</value></data>
  <data name="StoryPageTimeText3.Text" xml:space="preserve"><value>cuando el mundo callaba y la música le abrazaba</value></data>
  <data name="StoryPageTimeText4.Text" xml:space="preserve"><value>Y a las </value></data>
  <data name="StoryPageTimeText5.Text" xml:space="preserve"><value> elegía el silencio que también le abrazaba</value></data>
  <data name="StoryPageTopArtistText1.Text" xml:space="preserve"><value>Entre tanta gente,</value></data>
  <data name="StoryPageTopArtistText2.Text" xml:space="preserve"><value>le atraía</value></data>
  <data name="StoryPageTopArtistText3.Text" xml:space="preserve"><value>cuya voz le sonaba hermana</value></data>
  <data name="StoryPageTopArtistText4.Text" xml:space="preserve"><value>Esa voz le acompañó durante</value></data>
  <data name="StoryPageTopArtistText5.Text" xml:space="preserve"><value>canciones, y aún le está cerca</value></data>
  <data name="StoryPageTopSongText1.Text" xml:space="preserve"><value>Había una melodía,</value></data>
  <data name="StoryPageTopSongText2.Text" xml:space="preserve"><value>que aparecía sin aviso y le acariciaba...</value></data>
  <data name="StoryPageTopSongText3.Text" xml:space="preserve"><value>La escuchó</value></data>
  <data name="StoryPageTopSongText4.Text" xml:space="preserve"><value>veces, y aún le conmueve igual</value></data>
  <data name="StoryPageStreakText1.Text" xml:space="preserve"><value>El </value></data>
  <data name="StoryPageStreakText2.Text" xml:space="preserve"><value> se dejó llevar por el aire, olvidando el mañana</value></data>
  <data name="StoryPageStreakText3.Text" xml:space="preserve"><value>Escuchó </value></data>
  <data name="StoryPageStreakText4.Text" xml:space="preserve"><value>canciones, cada una una nueva mañana</value></data>
  <data name="StoryPageStreakText5.Text" xml:space="preserve"><value>Mantuvo la racha </value></data>
  <data name="StoryPageStreakText6.Text" xml:space="preserve"><value>días, y el canto volvía cada mañana</value></data>
  <data name="StoryPageSpecialMomentText1.Text" xml:space="preserve"><value>Donde empezó el viaje,</value></data>
  <data name="StoryPageSpecialMomentText2.Text" xml:space="preserve"><value>esta canción fue la llave:</value></data>
  <data name="StoryPageSpecialMomentText3.Text" xml:space="preserve"><value>El </value></data>
  <data name="StoryPageSpecialMomentText4.Text" xml:space="preserve"><value>,</value></data>
  <data name="StoryPageSpecialMomentText5.Text" xml:space="preserve"><value>a las </value></data>
  <data name="StoryPageSpecialMomentText6.Text" xml:space="preserve"><value> seguía escuchando, libre y suave:</value></data>
  <data name="StoryPagePersonaText1.Text" xml:space="preserve"><value>Ante el espejo de la canción, tu personaje musical es:</value></data>
  <data name="PersonaDefaultTitle" xml:space="preserve"><value>Explorador musical</value></data>
  <data name="PersonaDefaultDesc" xml:space="preserve"><value>Usted vaga libre donde suena la melodía</value></data>
  <data name="PersonaNightOwlTitle" xml:space="preserve"><value>Ave nocturna</value></data>
  <data name="PersonaNightOwlDesc" xml:space="preserve"><value>Cuanto más honda es la noche, más le acompaña la melodía</value></data>
  <data name="PersonaStreakTitle" xml:space="preserve"><value>Adicto a las melodías</value></data>
  <data name="PersonaStreakDesc" xml:space="preserve"><value>Un día sin música se le hace largo y vacío</value></data>
  <data name="PersonaLoyalTitle" xml:space="preserve"><value>Fan incondicional</value></data>
  <data name="PersonaLoyalDesc" xml:space="preserve"><value>Una voz permanece en usted, fiel día tras día</value></data>
  <data name="PersonaExplorerTitle" xml:space="preserve"><value>Explorador musical</value></data>
  <data name="PersonaExplorerDesc" xml:space="preserve"><value>Cada sonido lejano halla en usted su melodía</value></data>
