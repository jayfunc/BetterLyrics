  <data name="StatsDashboardControlMemoirDesc.Text" xml:space="preserve"><value>Revise su trayectoria musical y genere un informe de escucha personalizado</value></data>
  <data name="StatsDashboardControlMemoirPlay.Text" xml:space="preserve"><value>Reproducir ahora</value></data>
  <data name="StatsDashboardControlStartText.Text" xml:space="preserve"><value>Desde</value></data>
