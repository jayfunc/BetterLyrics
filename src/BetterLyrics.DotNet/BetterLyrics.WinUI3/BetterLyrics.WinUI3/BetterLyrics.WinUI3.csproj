        <RootNamespace>BetterLyrics.WinUI3</RootNamespace>
        <Platforms>x86;x64;ARM64</Platforms>
        <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
        <UseWinUI>true</UseWinUI>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <AppxDefaultResourceQualifiers>Language=en;ar;de;es;fr;hi;id;it;ja;ko;ms;pt;ru;th;vi;zh-Hans;zh-Hant|Contrast=standard|Scale=200|HomeRegion=001|TargetSize=256|LayoutDirection=LTR|DXFeatureLevel=DX9|Configuration=|AlternateForm=</AppxDefaultResourceQualifiers>
