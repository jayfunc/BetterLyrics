<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="using:BetterLyrics.WinUI3.Controls">

    <Style x:Key="LyricsCardStickyNoteStyle" TargetType="uc:LyricsCard">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="uc:LyricsCard">
                    <Grid
                        Width="450"
                        Height="{TemplateBinding LyricsAreaSize}"
                        MinHeight="500"
                        CornerRadius="8">

                        <Grid
                            Margin="40"
                            Background="#FFF4A3"
                            BorderBrush="#EAE096"
                            BorderThickness="1"
                            CornerRadius="2,2,16,2">

                            <Grid Margin="32,40,32,32">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                                    <TextBlock
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="26"
                                        FontWeight="SemiBold"
                                        Foreground="#2C3440"
                                        Text="{Binding Title, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="15"
                                        Foreground="#5C6673"
                                        Text="{Binding Artist, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ItemsControl
                                        x:Name="PART_LyricsItemsControl"
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        ItemsSource="{Binding LyricsLines, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,16">
                                                    <StackPanel>
                                                        <TextBlock
                                                            FontSize="18"
                                                            Foreground="#2C3440"
                                                            LineHeight="28"
                                                            Text="{Binding Text}"
                                                            TextWrapping="Wrap" />

                                                        <TextBlock
                                                            Margin="0,4,0,0"
                                                            FontSize="14"
                                                            Foreground="#7A8491"
                                                            LineHeight="22"
                                                            Text="{Binding SecondaryText}"
                                                            TextWrapping="Wrap"
                                                            Visibility="{Binding SecondaryText, Converter={StaticResource StringToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel
                                    Grid.Row="2"
                                    HorizontalAlignment="Right"
                                    Opacity="0.5"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="10"
                                        FontStyle="Italic"
                                        Foreground="#2C3440"
                                        Text="BetterLyrics" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Rectangle
                            Width="100"
                            Height="25"
                            Margin="0,25,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Fill="#D9D9D9"
                            Opacity="0.6">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="-2" CenterX="50" CenterY="12.5" />
                            </Rectangle.RenderTransform>
                        </Rectangle>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>