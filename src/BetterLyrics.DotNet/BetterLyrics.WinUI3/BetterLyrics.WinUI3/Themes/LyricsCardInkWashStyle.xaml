<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="using:BetterLyrics.WinUI3.Controls">

    <Style x:Key="LyricsCardInkWashStyle" TargetType="uc:LyricsCard">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="uc:LyricsCard">
                    <Grid
                        Width="450"
                        Height="{TemplateBinding LyricsAreaSize}"
                        MinHeight="600"
                        Background="#F5F4F0">
                        <Image
                            Opacity="0.1"
                            Source="{Binding CoverImage, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                            Stretch="UniformToFill" />

                        <Rectangle Fill="#F5F4F0" Opacity="0.6" />

                        <Grid Margin="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Rectangle
                                    Width="1"
                                    HorizontalAlignment="Center"
                                    Fill="#333333"
                                    Opacity="0.15" />

                                <Border
                                    Width="28"
                                    Height="60"
                                    Margin="0,40,0,0"
                                    VerticalAlignment="Top"
                                    Background="#A01C1C"
                                    CornerRadius="2">
                                    <TextBlock
                                        Width="14"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="14"
                                        Foreground="#F5F4F0"
                                        Text="水墨"
                                        TextWrapping="Wrap" />
                                </Border>
                            </Grid>

                            <Grid Grid.Column="1" Padding="20,10,10,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,30">
                                    <TextBlock
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="28"
                                        FontWeight="SemiBold"
                                        Foreground="#1A1A1A"
                                        Text="{Binding Title, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="16"
                                        Foreground="#595959"
                                        Text="{Binding Artist, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                    <Rectangle
                                        Height="1"
                                        Margin="0,16,0,0"
                                        Fill="#1A1A1A"
                                        Opacity="0.1" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ItemsControl
                                        x:Name="PART_LyricsItemsControl"
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        ItemsSource="{Binding LyricsLines, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,20">
                                                    <TextBlock
                                                        FontSize="18"
                                                        Foreground="#262626"
                                                        LineHeight="28"
                                                        Text="{Binding Text}"
                                                        TextWrapping="Wrap" />

                                                    <TextBlock
                                                        Margin="0,6,0,0"
                                                        FontSize="14"
                                                        Foreground="#737373"
                                                        LineHeight="22"
                                                        Text="{Binding SecondaryText}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{Binding SecondaryText, Converter={StaticResource StringToVisibilityConverter}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel
                                    Grid.Row="2"
                                    Margin="0,20,0,0"
                                    HorizontalAlignment="Right"
                                    Opacity="0.7"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        FontSize="12"
                                        Foreground="#333333"
                                        Text="曲拨心弦 词落云笺" />
                                    <Ellipse
                                        Width="4"
                                        Height="4"
                                        Margin="6,0,0,0"
                                        Fill="#A01C1C" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>