<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="using:BetterLyrics.WinUI3.Controls">

    <Style x:Key="LyricsCardTelegramStyle" TargetType="uc:LyricsCard">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="uc:LyricsCard">
                    <Grid
                        Width="460"
                        Height="{TemplateBinding LyricsAreaSize}"
                        MinHeight="600"
                        Background="#0E1621"
                        CornerRadius="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            Height="56"
                            Background="#17212B"
                            CornerRadius="8,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse
                                Grid.Column="0"
                                Width="40"
                                Height="40"
                                Margin="16,0,12,0"
                                VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding CoverImage, RelativeSource={RelativeSource Mode=TemplatedParent}}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#F5F5F5"
                                    Text="{Binding Artist, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="13"
                                    Foreground="#5288C1"
                                    Text="online" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="20">
                                <FontIcon
                                    FontFamily="{StaticResource SegoeFluentIcons}"
                                    FontSize="16"
                                    Foreground="#7B8DA1"
                                    Glyph="&#xE721;" />
                                <FontIcon
                                    FontFamily="{StaticResource SegoeFluentIcons}"
                                    FontSize="16"
                                    Foreground="#7B8DA1"
                                    Glyph="&#xE717;" />
                                <FontIcon
                                    FontFamily="{StaticResource SegoeFluentIcons}"
                                    FontSize="16"
                                    Foreground="#7B8DA1"
                                    Glyph="&#xE90D;" />
                                <FontIcon
                                    FontFamily="{StaticResource SegoeFluentIcons}"
                                    FontSize="16"
                                    Foreground="#7B8DA1"
                                    Glyph="&#xE712;" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <StackPanel Padding="0,16,0,24">

                                <Border
                                    Margin="0,0,0,20"
                                    Padding="12,4"
                                    HorizontalAlignment="Center"
                                    Background="#18222D"
                                    CornerRadius="12">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#7A8B9C"
                                        Text="Today" />
                                </Border>

                                <StackPanel
                                    Margin="16,0,16,16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Orientation="Horizontal">
                                    <Path
                                        Margin="0,0,-1,0"
                                        VerticalAlignment="Bottom"
                                        Data="M 8 0 L 8 8 L 0 8 Z"
                                        Fill="#182533" />

                                    <Border
                                        MinWidth="240"
                                        MaxWidth="320"
                                        Padding="12,10"
                                        Background="#182533"
                                        CornerRadius="12,12,12,0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Grid
                                                    Grid.Column="0"
                                                    Width="48"
                                                    Height="48"
                                                    Margin="0,0,12,0">
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding CoverImage, RelativeSource={RelativeSource Mode=TemplatedParent}}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <Ellipse Fill="#66000000" />
                                                    <FontIcon
                                                        Margin="2,0,0,0"
                                                        FontFamily="{StaticResource SegoeFluentIcons}"
                                                        FontSize="18"
                                                        Foreground="#FFFFFF"
                                                        Glyph="&#xE768;" />
                                                </Grid>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFFFFF"
                                                        Text="{Binding Title, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="13"
                                                        Foreground="#7B8DA1"
                                                        Text="{Binding Artist, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Right"
                                                FontSize="11"
                                                Foreground="#7B8DA1"
                                                Text="10:05" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <ItemsControl
                                    x:Name="PART_LyricsItemsControl"
                                    FontFamily="{Binding Config.FontFamily, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                    ItemsSource="{Binding LyricsLines, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">

                                                <StackPanel
                                                    Margin="16,0,16,4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Orientation="Horizontal">
                                                    <Path
                                                        Margin="0,0,-1,0"
                                                        VerticalAlignment="Bottom"
                                                        Data="M 8 0 L 8 8 L 0 8 Z"
                                                        Fill="#182533" />
                                                    <Border
                                                        MaxWidth="340"
                                                        Padding="12,10,12,6"
                                                        Background="#182533"
                                                        CornerRadius="12,12,12,0">
                                                        <StackPanel>
                                                            <TextBlock
                                                                FontSize="15"
                                                                Foreground="#FFFFFF"
                                                                LineHeight="22"
                                                                Text="{Binding Text}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                Margin="0,4,0,0"
                                                                HorizontalAlignment="Right"
                                                                FontSize="11"
                                                                Foreground="#7B8DA1"
                                                                Text="10:06" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel
                                                    Margin="16,0,16,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding SecondaryText, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <Border
                                                        MaxWidth="340"
                                                        Padding="12,10,12,6"
                                                        Background="#2B5278"
                                                        CornerRadius="12,12,0,12">
                                                        <StackPanel>
                                                            <TextBlock
                                                                FontSize="15"
                                                                Foreground="#FFFFFF"
                                                                LineHeight="22"
                                                                Text="{Binding SecondaryText}"
                                                                TextWrapping="Wrap" />

                                                            <StackPanel
                                                                Margin="0,4,0,0"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal">
                                                                <TextBlock
                                                                    Margin="0,0,4,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="11"
                                                                    Foreground="#71A0CD"
                                                                    Text="10:07" />
                                                                <Grid VerticalAlignment="Center">
                                                                    <FontIcon
                                                                        FontFamily="{StaticResource SegoeFluentIcons}"
                                                                        FontSize="13"
                                                                        FontWeight="Bold"
                                                                        Foreground="#53AEE5"
                                                                        Glyph="&#xE8FB;" />
                                                                    <FontIcon
                                                                        Margin="6,0,0,0"
                                                                        FontFamily="{StaticResource SegoeFluentIcons}"
                                                                        FontSize="13"
                                                                        FontWeight="Bold"
                                                                        Foreground="#53AEE5"
                                                                        Glyph="&#xE8FB;" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <Path
                                                        Margin="-1,0,0,0"
                                                        VerticalAlignment="Bottom"
                                                        Data="M 0 8 L 8 8 L 0 0 Z"
                                                        Fill="#2B5278" />
                                                </StackPanel>

                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </ScrollViewer>

                        <Grid
                            Grid.Row="2"
                            Height="56"
                            Background="#17212B"
                            CornerRadius="0,0,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                Margin="16,0,12,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <FontIcon
                                    FontFamily="{StaticResource SegoeFluentIcons}"
                                    FontSize="20"
                                    Foreground="#7B8DA1"
                                    Glyph="&#xE723;" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                Foreground="#7B8DA1"
                                Text="BetterLyrics" />

                            <StackPanel
                                Grid.Column="2"
                                Margin="12,0,16,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="16">
                                <FontIcon
                                    FontFamily="{StaticResource SegoeFluentIcons}"
                                    FontSize="20"
                                    Foreground="#7B8DA1"
                                    Glyph="&#xE11D;" />
                                <FontIcon
                                    FontFamily="{StaticResource SegoeFluentIcons}"
                                    FontSize="20"
                                    Foreground="#7B8DA1"
                                    Glyph="&#xE720;" />
                            </StackPanel>
                        </Grid>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>