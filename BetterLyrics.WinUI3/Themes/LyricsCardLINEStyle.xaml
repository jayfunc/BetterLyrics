<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lyricsmodels="using:BetterLyrics.WinUI3.Models.Lyrics"
    xmlns:models="using:BetterLyrics.WinUI3.Models">

    <DataTemplate x:Key="LyricsCardLINEStyle">
        <Grid
            x:Name="LINECardRoot"
            Width="460"
            MinHeight="500"
            Background="#8BA5C7"
            CornerRadius="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Height="56"
                Background="#FFFFFF"
                CornerRadius="8,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="16,0,12,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse Width="36" Height="36">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding CoverImage}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        MaxWidth="250"
                        HorizontalAlignment="Left"
                        FontSize="16"
                        Foreground="#111111"
                        Text="{Binding Artist}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="20">
                    <FontIcon
                        FontFamily="{StaticResource SegoeFluentIcons}"
                        FontSize="16"
                        Foreground="#555555"
                        Glyph="&#xE721;" />
                    <FontIcon
                        FontFamily="{StaticResource SegoeFluentIcons}"
                        FontSize="16"
                        Foreground="#555555"
                        Glyph="&#xE70B;" />
                    <FontIcon
                        FontFamily="{StaticResource SegoeFluentIcons}"
                        FontSize="16"
                        Foreground="#555555"
                        Glyph="&#xE712;" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Padding="0,16,0,24">

                <Border
                    Margin="0,0,0,20"
                    Padding="16,4"
                    HorizontalAlignment="Center"
                    Background="#33000000"
                    CornerRadius="12">
                    <TextBlock
                        FontSize="12"
                        Foreground="#FFFFFF"
                        Text="今日" />
                </Border>

                <Grid
                    Margin="16,0,16,16"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse
                        Grid.Column="0"
                        Width="40"
                        Height="40"
                        VerticalAlignment="Top">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding CoverImage}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left">

                        <StackPanel Orientation="Horizontal">
                            <Path
                                Margin="0,12,-1,0"
                                VerticalAlignment="Top"
                                Data="M 8 0 L 0 4 L 8 8 Z"
                                Fill="#FFFFFF" />

                            <Border
                                MaxWidth="280"
                                Padding="14,10"
                                Background="#FFFFFF"
                                CornerRadius="12">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Border
                                        Width="30"
                                        Height="30"
                                        Margin="0,0,10,0"
                                        Background="#F0F0F0"
                                        CornerRadius="15">
                                        <FontIcon
                                            FontFamily="{StaticResource SegoeFluentIcons}"
                                            FontSize="14"
                                            Foreground="#888888"
                                            Glyph="&#xE8D6;" />
                                    </Border>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Foreground="#111111"
                                        Text="{Binding Title}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Bottom"
                                FontSize="10"
                                Foreground="#E0E0E0"
                                Text="10:05" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <ItemsControl FontFamily="{Binding Config.FontFamily}" ItemsSource="{Binding SelectedLyrics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">

                                <Grid
                                    Margin="16,0,16,4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse
                                        Grid.Column="0"
                                        Width="40"
                                        Height="40"
                                        VerticalAlignment="Top">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding DataContext.CoverImage, ElementName=LINECardRoot}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left">

                                        <StackPanel Orientation="Horizontal">
                                            <Path
                                                Margin="0,12,-1,0"
                                                VerticalAlignment="Top"
                                                Data="M 8 0 L 0 4 L 8 8 Z"
                                                Fill="#FFFFFF" />

                                            <Border
                                                MaxWidth="280"
                                                Padding="14,10"
                                                Background="#FFFFFF"
                                                CornerRadius="12">
                                                <TextBlock
                                                    FontSize="15"
                                                    Foreground="#111111"
                                                    LineHeight="22"
                                                    Text="{Binding Text}"
                                                    TextWrapping="Wrap" />
                                            </Border>

                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Bottom"
                                                FontSize="10"
                                                Foreground="#E0E0E0"
                                                Text="10:06" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <StackPanel
                                    Margin="16,16,16,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal"
                                    Visibility="{Binding SecondaryText, Converter={StaticResource StringToVisibilityConverter}}">

                                    <StackPanel Margin="0,0,6,0" VerticalAlignment="Bottom">
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="10"
                                            Foreground="#EAEAEA"
                                            Text="既読" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            HorizontalAlignment="Right"
                                            FontSize="10"
                                            Foreground="#EAEAEA"
                                            Text="10:07" />
                                    </StackPanel>

                                    <Border
                                        MaxWidth="320"
                                        Padding="14,10"
                                        Background="#8CE053"
                                        CornerRadius="12">
                                        <TextBlock
                                            FontSize="15"
                                            Foreground="#111111"
                                            LineHeight="22"
                                            Text="{Binding SecondaryText}"
                                            TextWrapping="Wrap" />
                                    </Border>

                                    <Path
                                        Margin="-1,12,0,0"
                                        VerticalAlignment="Top"
                                        Data="M 0 0 L 8 4 L 0 8 Z"
                                        Fill="#8CE053" />
                                </StackPanel>

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

            <Grid
                Grid.Row="2"
                Height="60"
                Background="#FFFFFF"
                BorderBrush="#D6D6D6"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="16,0,12,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="16">
                    <FontIcon
                        FontFamily="{StaticResource SegoeFluentIcons}"
                        FontSize="20"
                        Foreground="#555555"
                        Glyph="&#xE11D;" />
                    <FontIcon
                        FontFamily="{StaticResource SegoeFluentIcons}"
                        FontSize="20"
                        Foreground="#555555"
                        Glyph="&#xE710;" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Height="36"
                    Padding="12,0"
                    Background="#F5F5F5"
                    CornerRadius="18">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#999999"
                        Text="BetterLyrics" />
                </Border>

                <StackPanel
                    Grid.Column="2"
                    Margin="12,0,16,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="16">
                    <FontIcon
                        FontFamily="{StaticResource SegoeFluentIcons}"
                        FontSize="20"
                        Foreground="#555555"
                        Glyph="&#xE8B7;" />
                    <FontIcon
                        FontFamily="{StaticResource SegoeFluentIcons}"
                        FontSize="20"
                        Foreground="#555555"
                        Glyph="&#xE720;" />
                </StackPanel>
            </Grid>

        </Grid>
    </DataTemplate>
</ResourceDictionary>