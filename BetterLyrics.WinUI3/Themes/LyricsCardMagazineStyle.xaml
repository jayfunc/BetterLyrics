<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lyricsmodels="using:BetterLyrics.WinUI3.Models.Lyrics"
    xmlns:models="using:BetterLyrics.WinUI3.Models">

    <DataTemplate x:Key="LyricsCardMagazineStyle">
        <Grid
            Width="450"
            MinHeight="600"
            Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="300" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Image
                VerticalAlignment="Center"
                Source="{Binding CoverImage}"
                Stretch="UniformToFill" />

            <TextBlock
                Margin="-5,0,0,-20"
                VerticalAlignment="Bottom"
                FontSize="80"
                FontWeight="Bold"
                Foreground="White"
                Opacity="0.2"
                Text="LYRICS" />

            <Grid Grid.Row="1" Padding="30,40,30,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock
                        FontFamily="{Binding Config.FontFamily}"
                        FontSize="32"
                        FontWeight="Black"
                        Foreground="Black"
                        LineHeight="36"
                        Text="{Binding Title}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,8,0,0"
                        FontFamily="{Binding Config.FontFamily}"
                        FontSize="16"
                        FontStyle="Italic"
                        Foreground="#666"
                        Text="{Binding Artist}"
                        TextWrapping="Wrap" />

                    <Border
                        Width="40"
                        Height="4"
                        Margin="0,15,0,25"
                        HorizontalAlignment="Left"
                        Background="Black" />
                </StackPanel>

                <ItemsControl
                    Grid.Row="1"
                    FontFamily="{Binding Config.FontFamily}"
                    ItemsSource="{Binding SelectedLyrics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,20">

                                <TextBlock
                                    FontSize="18"
                                    Foreground="#333"
                                    LineHeight="28"
                                    Text="{Binding Text}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="14"
                                    Foreground="#888"
                                    LineHeight="20"
                                    Text="{Binding SecondaryText}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding SecondaryText, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Visible}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel
                    Grid.Row="2"
                    Margin="0,40,0,0"
                    Opacity="0.5"
                    Orientation="Horizontal">
                    <TextBlock
                        FontFamily="{Binding Config.FontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="Black"
                        Text="BetterLyrics" />
                    <TextBlock
                        FontFamily="{Binding Config.FontFamily}"
                        FontSize="12"
                        Foreground="Black"
                        Text=" • ISSUE 01" />
                </StackPanel>
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>