<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="BetterLyrics.WinUI3.Controls.FontPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BetterLyrics.WinUI3.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BetterLyrics.WinUI3.Models"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">800</x:Double>
    </ContentDialog.Resources>

    <Grid
        Width="700"
        Height="400"
        ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox
                x:Name="SearchBox"
                x:Uid="FontPickerSearchBox"
                Grid.Row="0"
                InputScope="Search"
                TextChanged="SearchBox_TextChanged"
                TextWrapping="Wrap" />
            <ListView
                x:Name="FontListView"
                Grid.Row="1"
                Loaded="FontListView_Loaded"
                SelectionChanged="FontListView_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ExtendedFontFamily">
                        <Grid Margin="0,12" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <RichTextBlock
                                Grid.Row="0"
                                FontFamily="{x:Bind FontFamily}"
                                FontSize="16"
                                IsTextSelectionEnabled="False"
                                TextWrapping="Wrap">
                                <Paragraph>
                                    <Run Text="曲拨心弦，词落云笺。" />
                                </Paragraph>
                                <Paragraph>
                                    <Run Text="Strums the Heartstrings, Graces the Wordscapes." />
                                </Paragraph>
                            </RichTextBlock>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Right">
                                <TextBlock
                                    FontFamily="{x:Bind FontFamily}"
                                    Text="{x:Bind LocalizedFontFamily}"
                                    TextAlignment="Right"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind FontFamily}"
                                    TextAlignment="Right"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Column="1" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Uid="FontPickerSelectedFontText"
                Grid.Row="0"
                Margin="0,6,0,0" />
            <ListView
                x:Name="SelectedFontsListView"
                Grid.Row="1"
                AllowDrop="True"
                CanReorderItems="True"
                ItemContainerStyle="{StaticResource ListViewStretchedItemContainerStyle}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ExtendedFontFamily">
                        <Grid>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    Margin="16,0"
                                    FontFamily="Segoe UI Symbol"
                                    FontSize="16"
                                    Glyph="&#x283F;" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontFamily="{x:Bind FontFamily}" Text="{x:Bind LocalizedFontFamily}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind LocalizedFontFamily}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    Click="RemoveFont_Click"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Tag="{x:Bind}">
                                    <FontIcon
                                        FontFamily="{StaticResource SegoeFluentIcons}"
                                        FontSize="16"
                                        Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                            <local:DragIndicator Width="42" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

    </Grid>
</ContentDialog>