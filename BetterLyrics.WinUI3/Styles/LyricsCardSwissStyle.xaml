<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lyricsmodels="using:BetterLyrics.WinUI3.Models.Lyrics"
    xmlns:models="using:BetterLyrics.WinUI3.Models">

    <DataTemplate x:Key="LyricsCardSwissStyle">
        <Grid
            Width="450"
            MinHeight="600"
            Background="#F0F0F0">
            <Grid
                Margin="20"
                BorderBrush="Black"
                BorderThickness="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Padding="20"
                    Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            FontSize="48"
                            FontWeight="Black"
                            Foreground="Black"
                            LineHeight="40"
                            Text="{Binding Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="Black"
                            Text="{Binding Artist}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Margin="10,-20,-10,0"
                        VerticalAlignment="Top"
                        FontSize="80"
                        FontWeight="Bold"
                        Foreground="#EEE"
                        Text="01" />
                </Grid>

                <Rectangle
                    Grid.Row="1"
                    Height="4"
                    Fill="Black" />

                <Grid Grid.Row="2" Background="{Binding OverlayBrush}">
                    <Rectangle Fill="White" Opacity="0.8" />

                    <ItemsControl Margin="20,30" ItemsSource="{Binding SelectedLyrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,24">

                                    <TextBlock
                                        FontFamily="Arial"
                                        FontSize="24"
                                        FontWeight="Black"
                                        Foreground="Black"
                                        LineHeight="28"
                                        Text="{Binding Text}"
                                        TextAlignment="Left"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontFamily="Arial"
                                        FontSize="16"
                                        FontWeight="Normal"
                                        Foreground="#444444"
                                        LineHeight="22"
                                        Text="{Binding SecondaryText}"
                                        TextAlignment="Left"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding SecondaryText, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Visible}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Grid
                    Grid.Row="3"
                    Padding="20,15"
                    Background="Black"
                    BorderBrush="Black"
                    BorderThickness="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="40"
                            Height="40"
                            Background="White"
                            CornerRadius="20">
                            <Image Source="{Binding CoverImage}" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="NOW PLAYING" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Opacity="0.5"
                        Text="BetterLyrics" />
                </Grid>
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
