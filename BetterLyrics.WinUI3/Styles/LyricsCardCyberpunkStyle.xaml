<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lyricsmodels="using:BetterLyrics.WinUI3.Models.Lyrics"
    xmlns:models="using:BetterLyrics.WinUI3.Models">

    <DataTemplate x:Key="LyricsCardCyberpunkStyle">
        <Grid
            Width="450"
            MinHeight="600"
            Background="#050505">
            <Image
                Opacity="0.2"
                Source="{Binding CoverImage}"
                Stretch="UniformToFill" />
            <Rectangle Fill="#000000" Opacity="0.7" />

            <Border
                Margin="20"
                BorderThickness="2"
                CornerRadius="0">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#00FF9D" />
                        <GradientStop Offset="0.5" Color="#00E5FF" />
                        <GradientStop Offset="1" Color="#FF0055" />
                    </LinearGradientBrush>
                </Border.BorderBrush>

                <Grid>
                    <Grid
                        Height="40"
                        VerticalAlignment="Top"
                        Background="#111">
                        <TextBlock
                            Margin="10,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource GeekFont}"
                            FontSize="12"
                            Foreground="#00FF9D"
                            Text="BETTERLYRICS" />
                        <StackPanel
                            Margin="10,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Rectangle
                                Width="10"
                                Height="10"
                                Margin="2"
                                Fill="#FF0055" />
                            <Rectangle
                                Width="10"
                                Height="10"
                                Margin="2"
                                Fill="#00E5FF" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="30" VerticalAlignment="Center">
                        <Grid Margin="0,0,0,30">
                            <TextBlock
                                FontSize="36"
                                FontWeight="Black"
                                Foreground="#FF0055"
                                Opacity="0.7"
                                Text="{Binding Title}"
                                TextWrapping="Wrap">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="2" Y="2" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock
                                FontSize="36"
                                FontWeight="Black"
                                Foreground="#00E5FF"
                                Opacity="0.7"
                                Text="{Binding Title}"
                                TextWrapping="Wrap">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="-2" Y="-2" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock
                                FontSize="36"
                                FontWeight="Black"
                                Foreground="White"
                                Text="{Binding Title}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <ItemsControl Margin="0,0,0,48" ItemsSource="{Binding SelectedLyrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,24">

                                        <TextBlock
                                            FontFamily="{StaticResource GeekFont}"
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Foreground="#FFFFFF"
                                            LineHeight="28"
                                            Text="{Binding Text}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontFamily="{StaticResource GeekFont}"
                                            FontSize="14"
                                            Foreground="#00E5FF"
                                            LineHeight="20"
                                            Opacity="0.7"
                                            Text="{Binding SecondaryText}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding SecondaryText, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Visible}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid Margin="20" VerticalAlignment="Bottom">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                BorderBrush="White"
                                BorderThickness="1">
                                <Image Source="{Binding CoverImage}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding Artist}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontFamily="{StaticResource GeekFont}"
                                    FontSize="10"
                                    Foreground="#888"
                                    Text="// NOW_PLAYING" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            FontFamily="{StaticResource GeekFont}"
                            FontSize="10"
                            Foreground="#FFFF00"
                            Text="WARNING: LOUD" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
