<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lyricsmodels="using:BetterLyrics.WinUI3.Models.Lyrics"
    xmlns:models="using:BetterLyrics.WinUI3.Models">

    <DataTemplate x:Key="LyricsCardInkWashStyle">
        <Grid
            Width="450"
            MinHeight="600"
            Background="#F5F4F0">
            <Image
                Opacity="0.1"
                Source="{Binding CoverImage}"
                Stretch="UniformToFill" />

            <Rectangle Fill="#F5F4F0" Opacity="0.6" />

            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Rectangle
                        Width="1"
                        HorizontalAlignment="Center"
                        Fill="#333333"
                        Opacity="0.15" />

                    <Border
                        Width="28"
                        Height="60"
                        Margin="0,40,0,0"
                        VerticalAlignment="Top"
                        Background="#A01C1C"
                        CornerRadius="2">
                        <TextBlock
                            Width="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="KaiTi, Microsoft YaHei"
                            FontSize="14"
                            Foreground="#F5F4F0"
                            Text="水墨"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <Grid Grid.Column="1" Padding="20,10,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,30">
                        <TextBlock
                            FontFamily="KaiTi, STKaiti, Microsoft YaHei"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="#1A1A1A"
                            Text="{Binding Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontFamily="KaiTi, STKaiti, Microsoft YaHei"
                            FontSize="16"
                            Foreground="#595959"
                            Text="{Binding Artist}" />
                        <Rectangle
                            Height="1"
                            Margin="0,16,0,0"
                            Fill="#1A1A1A"
                            Opacity="0.1" />
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedLyrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock
                                        FontFamily="KaiTi, STKaiti, Microsoft YaHei"
                                        FontSize="18"
                                        Foreground="#262626"
                                        LineHeight="28"
                                        Text="{Binding Text}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontFamily="KaiTi, STKaiti, Microsoft YaHei"
                                        FontSize="14"
                                        Foreground="#737373"
                                        LineHeight="22"
                                        Text="{Binding SecondaryText}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding SecondaryText, Converter={StaticResource StringToVisibilityConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel
                        Grid.Row="2"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Opacity="0.7"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="KaiTi, STKaiti, Microsoft YaHei"
                            FontSize="12"
                            Foreground="#333333"
                            Text="曲拨心弦 词落云笺" />
                        <Ellipse
                            Width="4"
                            Height="4"
                            Margin="6,0,0,0"
                            Fill="#A01C1C" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>