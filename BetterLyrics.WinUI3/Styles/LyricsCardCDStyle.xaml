<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lyricsmodels="using:BetterLyrics.WinUI3.Models.Lyrics"
    xmlns:models="using:BetterLyrics.WinUI3.Models">

    <DataTemplate x:Key="LyricsCardCDStyle">
        <Grid
            Width="450"
            MinHeight="600"
            Background="#F5F5F7">
            <Grid
                Margin="20"
                Background="White"
                BorderBrush="#D1D1D6"
                BorderThickness="1"
                CornerRadius="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="#E5E5E5">
                    <Image
                        Opacity="0.5"
                        Source="{Binding CoverImage}"
                        Stretch="UniformToFill" />

                    <Grid
                        Width="40"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Background="#CC0000"
                        CornerRadius="4,0,0,4">
                        <TextBlock
                            Margin="0,10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            FontSize="10"
                            Foreground="White"
                            Text="限定盤" />
                        <TextBlock
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            FontSize="10"
                            Foreground="White"
                            Text="STEREO">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>

                    <Rectangle
                        Width="2"
                        HorizontalAlignment="Right"
                        Fill="#000"
                        Opacity="0.1" />
                </Grid>

                <TextBlock
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding Artist}"
                    TextTrimming="CharacterEllipsis">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </TextBlock.RenderTransform>
                </TextBlock>

                <Grid Grid.Column="1" Padding="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="Black"
                            Text="{Binding Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="14"
                            Foreground="#888"
                            Text="{Binding Artist}" />
                        <Rectangle
                            Height="1"
                            Margin="0,12,0,0"
                            Fill="#EEE" />
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedLyrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">

                                    <TextBlock
                                        FontFamily="Segoe UI"
                                        FontSize="15"
                                        Foreground="#333"
                                        LineHeight="24"
                                        Text="{Binding Text}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontFamily="Segoe UI"
                                        FontSize="13.5"
                                        Foreground="#777"
                                        LineHeight="20"
                                        Text="{Binding SecondaryText}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding SecondaryText, Converter={StaticResource StringToVisibilityConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        Opacity="0.6"
                        Orientation="Horizontal">
                        <Ellipse
                            Width="6"
                            Height="6"
                            Margin="0,0,4,0"
                            Fill="Black" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="8"
                            Foreground="Black"
                            Text="BetterLyrics Disc Digital Audio" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
