<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BetterLyrics.WinUI3.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:const="using:BetterLyrics.WinUI3.Constants"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:BetterLyrics.WinUI3.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BetterLyrics.WinUI3.Models"
    xmlns:uc="using:BetterLyrics.WinUI3.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:BetterLyrics.WinUI3.ViewModels"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">

        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>

                <NavigationViewItem
                    x:Uid="SettingsPageApp"
                    Icon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                       Glyph=&#xECAA;}"
                    IsSelected="True"
                    Tag="App" />

                <NavigationViewItem
                    x:Uid="SettingsPageLyricsWindowMgr"
                    Icon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                       Glyph=&#xE61F;}"
                    Tag="LyricsWindowMgr" />

                <NavigationViewItem
                    x:Uid="SettingsPageMediaLib"
                    Icon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                       Glyph=&#xE8B7;}"
                    Tag="MediaLib" />

                <NavigationViewItem
                    x:Uid="SettingsPagePlaybackLib"
                    Icon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                       Glyph=&#xEA69;}"
                    Tag="PlaybackLib" />

                <NavigationViewItem
                    x:Uid="SettingsPageStats"
                    Icon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                       Glyph=&#xE9D2;}"
                    Tag="Stats" />

                <NavigationViewItem
                    x:Uid="SettingsPagePlugins"
                    Icon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                       Glyph=&#xE74C;}"
                    Tag="Plugins" />

                <NavigationViewItem
                    x:Uid="SettingsPageAbout"
                    Icon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons},
                                       Glyph=&#xE946;}"
                    Tag="About" />

            </NavigationView.MenuItems>

            <controls:SwitchPresenter Value="{x:Bind ViewModel.NavViewSelectedItemTag, Mode=OneWay}">
                <controls:SwitchPresenter.ContentTransitions>
                    <TransitionCollection>
                        <PopupThemeTransition />
                    </TransitionCollection>
                </controls:SwitchPresenter.ContentTransitions>

                <!--  App appearance and behavior  -->
                <controls:Case Value="App">
                    <uc:AppSettingsControl />
                </controls:Case>

                <!--  Lyrics window manager  -->
                <controls:Case Value="LyricsWindowMgr">
                    <uc:LyricsWindowSettingsControl />
                </controls:Case>

                <!--  Playback sources  -->
                <controls:Case Value="PlaybackLib">
                    <uc:PlaybackSettingsControl />
                </controls:Case>

                <!--  Media lib  -->
                <controls:Case Value="MediaLib">
                    <uc:MediaSettingsControl />
                </controls:Case>

                <!--  Stats  -->
                <controls:Case Value="Stats">
                    <uc:StatsDashboardControl />
                </controls:Case>

                <!--  Plugins  -->
                <controls:Case Value="Plugins">
                    <uc:PluginManagerControl />
                </controls:Case>

                <!--  About  -->
                <controls:Case Value="About">
                    <uc:AboutControl />
                </controls:Case>

            </controls:SwitchPresenter>
        </NavigationView>

    </Grid>
</Page>
