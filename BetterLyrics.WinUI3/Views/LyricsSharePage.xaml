                            <GradientStop Offset="1" Color="#FF0055" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>

                    <Grid>
                        <Grid
                            Height="40"
                            VerticalAlignment="Top"
                            Background="#111">
                            <TextBlock
                                Margin="10,0"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="#00FF9D"
                                Text="BETTERLYRICS" />
                            <StackPanel
                                Margin="10,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Rectangle
                                    Width="10"
                                    Height="10"
                                    Margin="2"
                                    Fill="#FF0055" />
                                <Rectangle
                                    Width="10"
                                    Height="10"
                                    Margin="2"
                                    Fill="#00E5FF" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="30" VerticalAlignment="Center">
                            <Grid Margin="0,0,0,30">
                                <TextBlock
                                    Margin="2,2,0,0"
                                    FontSize="36"
                                    FontWeight="Black"
                                    Foreground="#FF0055"
                                    Opacity="0.7"
                                    Text="{x:Bind Title}" />
                                <TextBlock
                                    Margin="-2,-2,0,0"
                                    FontSize="36"
                                    FontWeight="Black"
                                    Foreground="#00E5FF"
                                    Opacity="0.7"
                                    Text="{x:Bind Title}" />
                                <TextBlock
                                    FontSize="36"
                                    FontWeight="Black"
                                    Foreground="White"
                                    Text="{x:Bind Title}" />
                            </Grid>

                            <ItemsControl ItemsSource="{x:Bind SelectedLyrics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="0,0,0,16"
                                            FontFamily="Consolas"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="#E0E0E0"
                                            Text="{Binding}"
                                            TextWrapping="Wrap">
                                            <TextBlock.Shadow>
                                                <ThemeShadow />
                                            </TextBlock.Shadow>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid Margin="20" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="40"
                                    Height="40"
                                    BorderBrush="White"
                                    BorderThickness="1">
                                    <Image Source="{x:Bind CoverImage}" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{x:Bind Artist}" />
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="10"
                                        Foreground="#888"
                                        Text="// NOW_PLAYING" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontFamily="Consolas"
                                FontSize="10"
                                Foreground="#FFFF00"
                                Text="WARNING: LOUD" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StyleCinematic" x:DataType="models:LyricsShareCardData">
            <Grid
                Width="450"
                MinHeight="600"
                Background="#050505">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="1" Height="340">
                    <Image Source="{x:Bind CoverImage}" Stretch="UniformToFill" />

                    <Rectangle Fill="Black" Opacity="0.2" />

                    <Rectangle Height="180" VerticalAlignment="Bottom">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="Transparent" />
                                <GradientStop Offset="1" Color="#E6000000" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <ItemsControl
                        Margin="30,0,30,30"
                        VerticalAlignment="Bottom"
                        ItemsSource="{x:Bind SelectedLyrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <TextBlock
                                        Margin="2,2,0,0"
                                        FontFamily="Arial"
                                        FontSize="20"
                                        FontStyle="Italic"
                                        FontWeight="Bold"
                                        Foreground="Black"
                                        Opacity="0.8"
                                        Text="{Binding}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Margin="-1,-1,0,0"
                                        FontFamily="Arial"
                                        FontSize="20"
                                        FontStyle="Italic"
                                        FontWeight="Bold"
                                        Foreground="Black"
                                        Opacity="0.5"
                                        Text="{Binding}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        FontFamily="Arial"
                                        FontSize="20"
                                        FontStyle="Italic"
                                        FontWeight="Bold"
                                        Foreground="#FFCB4C"
                                        Text="{Binding}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.8"
                    Spacing="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        CharacterSpacing="100"
                        FontFamily="Courier New"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{x:Bind Title}" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <TextBlock
                            FontFamily="Courier New"
                            FontSize="10"
                            Foreground="#888"
                            Text="STARRING" />
                        <TextBlock
                            CharacterSpacing="50"
                            FontFamily="Courier New"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#CCC"
                            Text="{x:Bind Artist}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontFamily="Courier New"
                        FontSize="9"
                        Foreground="#555"
                        Text="A BETTERLYRICS PRODUCTION" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StylePod" x:DataType="models:LyricsShareCardData">
            <Grid
                Width="450"
                MinHeight="600"
                Background="#F2F2F2">
                <Border
                    Margin="10"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="280" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Margin="30,40,30,10"
                            Background="White"
                            BorderBrush="#333"
                            BorderThickness="2"
                            CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid
                                    Grid.Row="0"
                                    Background="#F0F0F0"
                                    BorderBrush="#CCC"
                                    BorderThickness="0,0,0,1">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="#333"
                                        Text="Now Playing" />
                                    <FontIcon
                                        Margin="0,0,5,0"
                                        HorizontalAlignment="Right"
                                        FontSize="10"
                                        Foreground="#333"
                                        Glyph="&#xE768;" />
                                    <FontIcon
                                        Margin="5,0,0,0"
                                        HorizontalAlignment="Left"
                                        FontSize="10"
                                        Foreground="#333"
                                        Glyph="&#xE76E;" />
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        Grid.Column="0"
                                        Margin="10"
                                        VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Image
                                            Grid.Row="0"
                                            Source="{x:Bind CoverImage}"
                                            Stretch="Uniform" />

                                        <Grid
                                            Grid.Row="1"
                                            Height="80"
                                            Margin="0,2,0,-80"
                                            VerticalAlignment="Top"
                                            Opacity="0.5">
                                            <Image
                                                RenderTransformOrigin="0.5,0.5"
                                                Source="{x:Bind CoverImage}"
                                                Stretch="Uniform">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleY="-1" />
                                                </Image.RenderTransform>
                                            </Image>

                                            <Rectangle>
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Offset="0" Color="#40FFFFFF" />
                                                        <GradientStop Offset="0.8" Color="White" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>
                                    </Grid>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="0,10,10,10"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Margin="0,0,0,8"
                                            FontSize="10"
                                            Foreground="#666"
                                            Text="{x:Bind Artist}"
                                            TextTrimming="CharacterEllipsis" />

                                        <ItemsControl ItemsSource="{x:Bind SelectedLyrics}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Margin="0,2"
                                                        FontSize="9"
                                                        Foreground="#333"
                                                        Text="{Binding}"
                                                        TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Ellipse
                                Width="220"
                                Height="220"
                                Fill="#F8F8F8"
                                Stroke="#D9D9D9"
                                StrokeThickness="1" />

                            <TextBlock
                                Margin="0,25,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#AAA"
                                Text="MENU" />

                            <FontIcon
                                Margin="0,0,0,25"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                FontSize="16"
                                Foreground="#AAA"
                                Glyph="&#xE768;" />
                            <FontIcon
                                Margin="25,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#AAA"
                                Glyph="&#xE892;" />
                            <FontIcon
                                Margin="0,0,25,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#AAA"
                                Glyph="&#xE893;" />
                            <Ellipse
                                Width="80"
                                Height="80"
                                Fill="#DDD"
                                Stroke="#CCC"
                                StrokeThickness="1" />
                        </Grid>

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,0,0,15"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            FontSize="8"
                            Foreground="#BBB"
                            Text="Designed by BetterLyrics on Earth" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StyleWindowsPhone" x:DataType="models:LyricsShareCardData">
            <Grid
                Width="450"
                MinHeight="800"
                Background="Black">
                <Image
                    Opacity="0.6"
                    Source="{x:Bind CoverImage}"
                    Stretch="UniformToFill" />

                <Rectangle Height="400" VerticalAlignment="Bottom">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="1" Color="#CC000000" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid
                    Height="32"
                    Padding="12,6"
                    VerticalAlignment="Top"
                    Background="#33000000">
                    <StackPanel
                        HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon
                            FontSize="14"
                            Foreground="White"
                            Glyph="&#xE870;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="5G" />
                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="12">
                        <FontIcon
                            FontSize="14"
                            Foreground="White"
                            Glyph="&#xE701;" />
                        <FontIcon
                            FontSize="14"
                            Foreground="White"
                            Glyph="&#xE83F;" />
                    </StackPanel>
                </Grid>

                <Grid
                    Height="100"
                    Margin="0,32,0,0"
                    VerticalAlignment="Top"
                    Background="#1F1F1F">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Grid.Column="0"
                        Width="100"
                        Height="100"
                        Source="{x:Bind CoverImage}"
                        Stretch="UniformToFill" />

                    <Grid Grid.Column="1" Padding="15,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" VerticalAlignment="Center">
                            <TextBlock
                                FontFamily="Segoe UI Semibold"
                                FontSize="15"
                                Foreground="White"
                                Text="{x:Bind Artist}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontFamily="Segoe UI"
                                FontSize="13"
                                Foreground="#999"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel
                            Grid.Row="1"
                            Margin="0,0,0,4"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Spacing="25">
                            <FontIcon
                                FontSize="18"
                                Foreground="#CCC"
                                Glyph="&#xE892;" />
                            <FontIcon
                                FontSize="22"
                                Foreground="White"
                                Glyph="&#xE768;" />
                            <FontIcon
                                FontSize="18"
                                Foreground="#CCC"
                                Glyph="&#xE893;" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid Margin="30,160,30,240" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{x:Bind SelectedLyrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,0,0,20"
                                    FontFamily="Segoe UI Light"
                                    FontSize="26"
                                    Foreground="White"
                                    LineHeight="34"
                                    Text="{Binding}"
                                    TextWrapping="Wrap">
                                    <TextBlock.Shadow>
                                        <ThemeShadow />
                                    </TextBlock.Shadow>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <StackPanel Margin="24,0,0,40" VerticalAlignment="Bottom">
                    <TextBlock
                        Margin="-4,0,0,-12"
                        FontFamily="Segoe UI Light"
                        FontSize="90"
                        Foreground="White"
                        Text="12:00" />

                    <TextBlock
                        Margin="2,0,0,4"
                        FontFamily="Segoe UI"
                        FontSize="22"
                        Foreground="White"
                        Text="Sunday, February 15" />

                    <TextBlock
                        Margin="2,0,0,24"
                        FontFamily="Segoe UI"
                        FontSize="16"
                        Foreground="#CCC"
                        Text="BetterLyrics" />

                    <StackPanel
                        Opacity="0.9"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Grid>
                            <FontIcon
                                FontSize="20"
                                Foreground="White"
                                Glyph="&#xE717;" />
                            <TextBlock
                                Margin="30,-2,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="1" />
                        </Grid>
                        <Grid>
                            <FontIcon
                                FontSize="20"
                                Foreground="White"
                                Glyph="&#xE715;" />
                            <TextBlock
                                Margin="30,-2,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="5" />
                        </Grid>
                        <Grid>
                            <FontIcon
                                FontSize="20"
                                Foreground="White"
                                Glyph="&#xE8BD;" />
                            <TextBlock
                                Margin="30,-2,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="2" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <FontIcon
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    FontSize="12"
                    Foreground="White"
                    Glyph="&#xE70E;"
                    Opacity="0.5" />
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColDef" Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightColDef" Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            Grid.Column="0"
            Padding="24"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Uid="LyricsSharePageSelectLyricsTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ListView
                x:Name="LyricsListView"
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.GSMTCService.CurrentLyricsData.LyricsLines, Mode=OneWay}"
                SelectionChanged="LyricsListView_SelectionChanged"
                SelectionMode="Multiple">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Padding="0,8"
                            Text="{Binding Text}"
                            TextWrapping="Wrap" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Viewbox
            x:Name="PreviewCardContainer"
            Grid.Column="1"
            Margin="24"
            Stretch="Uniform">
            <ContentControl
                x:Name="PreviewCard"
                Content="{x:Bind ViewModel.CardData, Mode=OneWay}"
                ContentTemplate="{StaticResource StyleMinimal}" />
        </Viewbox>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="24">
                <TextBlock x:Uid="LyricsSharePageStyleTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
            </Grid>
            <ScrollViewer Grid.Row="1">
                <StackPanel Padding="24,0" Spacing="24">

                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Uid="LyricsSharePageGroupClassic"
                            Opacity="0.7"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <dev:WrapPanel
                            HorizontalSpacing="12"
                            Orientation="Horizontal"
                            VerticalSpacing="12">
                            <Button
                                x:Uid="LyricsSharePageStyleMinimal"
                                Click="StyleButton_Click"
                                Tag="StyleMinimal" />
                            <Button
                                x:Uid="LyricsSharePageStyleSwiss"
                                Click="StyleButton_Click"
                                Tag="StyleSwiss" />
                            <Button
                                x:Uid="LyricsSharePageStyleMagazine"
                                Click="StyleButton_Click"
                                Tag="StyleMagazine" />
                        </dev:WrapPanel>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Uid="LyricsSharePageGroupPhysical"
                            Opacity="0.7"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <dev:WrapPanel
                            HorizontalSpacing="12"
                            Orientation="Horizontal"
                            VerticalSpacing="12">
                            <Button
                                x:Uid="LyricsSharePageStyleVinyl"
                                Click="StyleButton_Click"
                                Tag="StyleVinyl" />
                            <Button
                                x:Uid="LyricsSharePageStyleCD"
                                Click="StyleButton_Click"
                                Tag="StyleCD" />
                            <Button
                                x:Uid="LyricsSharePageStylePolaroid"
                                Click="StyleButton_Click"
                                Tag="StylePolaroid" />
                            <Button
                                x:Uid="LyricsSharePageStyleTicket"
                                Click="StyleButton_Click"
                                Tag="StyleTicket" />
                            <Button
                                x:Uid="LyricsSharePageStyleReceipt"
                                Click="StyleButton_Click"
                                Tag="StyleReceipt" />
                        </dev:WrapPanel>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Uid="LyricsSharePageGroupRetro"
                            Opacity="0.7"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <dev:WrapPanel
                            HorizontalSpacing="12"
                            Orientation="Horizontal"
                            VerticalSpacing="12">
                            <Button
                                Click="StyleButton_Click"
                                Content="iPod"
                                Tag="StylePod" />
                            <Button
                                Click="StyleButton_Click"
                                Content="Windows Phone"
                                Tag="StyleWindowsPhone" />
                            <Button
                                x:Uid="LyricsSharePageStyleRetroQQ"
                                Click="StyleButton_Click"
                                Tag="StyleRetroQQ" />
                            <Button
                                x:Uid="LyricsSharePageStyleRetroMSN"
                                Click="StyleButton_Click"
                                Tag="StyleRetroMSN" />
                        </dev:WrapPanel>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Uid="LyricsSharePageGroupAtmosphere"
                            Opacity="0.7"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <dev:WrapPanel
                            HorizontalSpacing="12"
                            Orientation="Horizontal"
                            VerticalSpacing="12">
                            <Button
                                x:Uid="LyricsSharePageStyleCinematic"
                                Click="StyleButton_Click"
                                Tag="StyleCinematic" />
                            <Button
                                x:Uid="LyricsSharePageStyleCyberpunk"
                                Click="StyleButton_Click"
                                Tag="StyleCyberpunk" />
                        </dev:WrapPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Padding="24">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Button
                        x:Uid="LyricsSharePageSaveImage"
                        Click="SaveImage_Click"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button x:Uid="LyricsSharePageCopyImage" Click="CopyImage_Click" />
                </StackPanel>
            </Grid>

        </Grid>

        <Grid
            x:Name="ProcessingOverlay"
            Grid.ColumnSpan="3"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Opacity="0"
            Visibility="Collapsed">
            <Grid.OpacityTransition>
                <ScalarTransition />
            </Grid.OpacityTransition>
            <ProgressRing />
        </Grid>

    </Grid>
</Page>
