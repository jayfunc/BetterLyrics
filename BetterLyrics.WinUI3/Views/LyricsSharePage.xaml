<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BetterLyrics.WinUI3.Views.LyricsSharePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:BetterLyrics.WinUI3.Views"
    xmlns:lyricsmodels="using:BetterLyrics.WinUI3.Models.Lyrics"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BetterLyrics.WinUI3.Models"
    xmlns:uc="using:BetterLyrics.WinUI3.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColDef" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightColDef" />
        </Grid.ColumnDefinitions>

        <Grid
            Grid.Column="0"
            Padding="24"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Uid="LyricsSharePageSelectLyricsTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <CheckBox
                    x:Name="LyricsHostCheckBox"
                    Click="LyricsHostCheckBox_Click"
                    IsThreeState="True" />
            </StackPanel>
            <ListView
                x:Name="LyricsListView"
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.GSMTCService.CurrentLyricsData.LyricsLines, Mode=OneWay}"
                SelectionChanged="LyricsListView_SelectionChanged"
                SelectionMode="Multiple">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="lyricsmodels:LyricsLine">
                        <StackPanel Padding="0,8" Spacing="2">
                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind SecondaryText}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind SecondaryText, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid
            Grid.Column="1"
            Margin="24"
            VerticalAlignment="Center"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Viewbox x:Name="PreviewCardContainer">
                <ContentControl
                    x:Name="PreviewCard"
                    Content="{x:Bind ViewModel.CardData, Mode=OneWay}"
                    ContentTemplate="{StaticResource LyricsCardMinimalStyle}" />
            </Viewbox>
            <TextBlock
                x:Name="StyleInfoTextBlock"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="24">
                <TextBlock x:Uid="LyricsSharePageStyleTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
            </Grid>
            <ScrollViewer Grid.Row="1">
                <StackPanel
                    x:Name="StyleContainer"
                    Padding="24,0"
                    Spacing="24">

                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Uid="LyricsSharePageGroupClassic"
                            Opacity="0.7"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <dev:WrapPanel
                            HorizontalSpacing="8"
                            Orientation="Horizontal"
                            VerticalSpacing="8">
                            <Button
                                x:Uid="LyricsSharePageStyleMinimal"
                                Click="StyleButton_Click"
                                Tag="LyricsCardMinimalStyle" />
                            <Button
                                x:Uid="LyricsSharePageStyleSwiss"
                                Click="StyleButton_Click"
                                Tag="LyricsCardSwissStyle" />
                            <Button
                                x:Uid="LyricsSharePageStyleMagazine"
                                Click="StyleButton_Click"
                                Tag="LyricsCardMagazineStyle" />
                        </dev:WrapPanel>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Uid="LyricsSharePageGroupPhysical"
                            Opacity="0.7"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <dev:WrapPanel
                            HorizontalSpacing="8"
                            Orientation="Horizontal"
                            VerticalSpacing="8">
                            <Button
                                x:Uid="LyricsSharePageStyleVinyl"
                                Click="StyleButton_Click"
                                Tag="LyricsCardVinylStyle" />
                            <Button
                                x:Uid="LyricsSharePageStyleCD"
                                Click="StyleButton_Click"
                                Tag="LyricsCardCDStyle" />
                            <Button
                                x:Uid="LyricsSharePageStylePolaroid"
                                Click="StyleButton_Click"
                                Tag="LyricsCardPolaroidStyle" />
                            <Button
                                x:Uid="LyricsSharePageStyleTicket"
                                Click="StyleButton_Click"
                                Tag="LyricsCardTicketStyle" />
                            <Button
                                x:Uid="LyricsSharePageStyleReceipt"
                                Click="StyleButton_Click"
                                Tag="LyricsCardReceiptStyle" />
                        </dev:WrapPanel>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Uid="LyricsSharePageGroupRetro"
                            Opacity="0.7"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <dev:WrapPanel
                            HorizontalSpacing="8"
                            Orientation="Horizontal"
                            VerticalSpacing="8">
                            <Button
                                Click="StyleButton_Click"
                                Content="iPod"
                                Tag="LyricsCardPodStyle" />
                            <Button
                                Click="StyleButton_Click"
                                Content="Windows Phone"
                                Tag="LyricsCardWindowsPhoneStyle" />
                            <Button
                                x:Uid="LyricsSharePageStyleRetroQQ"
                                Click="StyleButton_Click"
                                Tag="LyricsCardRetroQQStyle" />
                            <Button
                                x:Uid="LyricsSharePageStyleRetroMSN"
                                Click="StyleButton_Click"
                                Tag="LyricsCardRetroMSNStyle" />
                        </dev:WrapPanel>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Uid="LyricsSharePageGroupAtmosphere"
                            Opacity="0.7"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <dev:WrapPanel
                            HorizontalSpacing="8"
                            Orientation="Horizontal"
                            VerticalSpacing="12">
                            <Button
                                x:Uid="LyricsSharePageStyleCinematic"
                                Click="StyleButton_Click"
                                Tag="LyricsCardCinematicStyle" />
                            <Button
                                x:Uid="LyricsSharePageStyleCyberpunk"
                                Click="StyleButton_Click"
                                Tag="LyricsCardCyberpunkStyle" />
                        </dev:WrapPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <StackPanel Padding="24" Spacing="24">
                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Uid="LyricsSharePageImageQuality"
                            Opacity="0.7"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <uc:ExtendedSlider
                            x:Name="ImageQualitySlider"
                            HorizontalAlignment="Left"
                            Default="100"
                            Frequency="1"
                            Maximum="100"
                            Minimum="10"
                            Unit="%"
                            Value="100" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="LyricsSharePageSaveImage"
                            Click="SaveImage_Click"
                            Style="{ThemeResource AccentButtonStyle}" />
                        <Button x:Uid="LyricsSharePageCopyImage" Click="CopyImage_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

        </Grid>

        <Grid
            x:Name="ProcessingOverlay"
            Grid.ColumnSpan="3"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Opacity="0"
            Visibility="Collapsed">
            <Grid.OpacityTransition>
                <ScalarTransition />
            </Grid.OpacityTransition>
            <ProgressRing />
        </Grid>

    </Grid>
</Page>
