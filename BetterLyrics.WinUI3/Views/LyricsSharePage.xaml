<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BetterLyrics.WinUI3.Views.LyricsSharePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:BetterLyrics.WinUI3.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BetterLyrics.WinUI3.Models"
    mc:Ignorable="d">

    <Page.Resources>

        <DataTemplate x:Key="StyleMinimal" x:DataType="models:LyricsShareCardData">
            <Grid
                Width="450"
                MinHeight="600"
                Background="White">
                <Border
                    Margin="16"
                    BorderBrush="Black"
                    BorderThickness="4" />
                <Grid Padding="40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ItemsControl ItemsSource="{x:Bind SelectedLyrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,0,0,24"
                                    FontFamily="Segoe UI"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="Black"
                                    LineHeight="40"
                                    Text="{Binding}"
                                    TextAlignment="Left"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid
                        Grid.Row="1"
                        Margin="0,20,0,0"
                        Padding="0,20,0,0"
                        BorderBrush="Black"
                        BorderThickness="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Grid.Column="0"
                            Width="60"
                            Height="60"
                            Source="{x:Bind CoverImage}" />

                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="18"
                                FontWeight="Black"
                                Foreground="Black"
                                Text="{x:Bind Title}" />
                            <TextBlock
                                FontSize="14"
                                Foreground="#555555"
                                Text="{x:Bind Artist}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Opacity="0.6"
                            Orientation="Horizontal"
                            Spacing="4">
                            <TextBlock
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="Black"
                                Text="BetterLyrics" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StyleVinyl" x:DataType="models:LyricsShareCardData">
            <Grid Width="450" MinHeight="600">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Rectangle
                    Grid.RowSpan="2"
                    Fill="{x:Bind OverlayBrush}"
                    Opacity="0.3" />
                <Rectangle Grid.RowSpan="2" Fill="#CC121212" />

                <Grid
                    Grid.Row="0"
                    Width="320"
                    Height="220"
                    Margin="0,40,0,20"
                    HorizontalAlignment="Center">

                    <Grid
                        Width="200"
                        Height="200"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <Ellipse Fill="#050505" />
                        <Ellipse
                            Width="190"
                            Height="190"
                            Opacity="0.1"
                            Stroke="#33FFFFFF"
                            StrokeThickness="1" />
                        <Ellipse
                            Width="180"
                            Height="180"
                            Opacity="0.05"
                            Stroke="#33FFFFFF"
                            StrokeThickness="1" />
                        <Ellipse
                            Width="150"
                            Height="150"
                            Opacity="0.05"
                            Stroke="#33FFFFFF"
                            StrokeThickness="2" />
                        <Ellipse Width="70" Height="70">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{x:Bind CoverImage}" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse
                            Width="8"
                            Height="8"
                            Fill="#121212" />
                    </Grid>

                    <Grid
                        Width="210"
                        Height="210"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Translation="0,0,16">
                        <Grid.Shadow>
                            <ThemeShadow />
                        </Grid.Shadow>
                        <Image Source="{x:Bind CoverImage}" Stretch="UniformToFill" />
                        <Rectangle
                            Height="100"
                            VerticalAlignment="Top"
                            Opacity="0.05">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#40FFFFFF" />
                                    <GradientStop Offset="1" Color="Transparent" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" Padding="40,0,40,40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ItemsControl
                        Grid.Row="0"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind SelectedLyrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,0,0,16"
                                    FontFamily="Segoe UI"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="#F0F0F0"
                                    LineHeight="32"
                                    Opacity="0.95"
                                    Text="{Binding}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel
                        Grid.Row="1"
                        Margin="0,30,0,0"
                        Spacing="8">

                        <Grid
                            Height="2"
                            Background="#33FFFFFF"
                            CornerRadius="1">
                            <Rectangle
                                Width="120"
                                HorizontalAlignment="Left"
                                Fill="White" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="10">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="White"
                                    Glyph="&#xE768;"
                                    Opacity="0.8" />
                                <StackPanel>
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{x:Bind Title}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#AAAAAA"
                                        Text="{x:Bind Artist}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="White"
                                Opacity="0.3"
                                Text="BetterLyrics" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StylePolaroid" x:DataType="models:LyricsShareCardData">
            <Grid
                Width="450"
                MinHeight="600"
                Background="#F4F4F4">
                <Grid.Shadow>
                    <ThemeShadow />
                </Grid.Shadow>

                <Grid
                    Width="400"
                    MinHeight="550"
                    Margin="0,25"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="360" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Margin="20,20,20,0"
                        Background="#EEE">
                        <Image Source="{x:Bind CoverImage}" Stretch="UniformToFill" />
                    </Border>

                    <Grid Grid.Row="1" Padding="24,20,24,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ItemsControl
                            Grid.Row="0"
                            Margin="0,0,0,20"
                            ItemsSource="{x:Bind SelectedLyrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        CharacterSpacing="10"
                                        FontFamily="Ink Free"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="#2B2B2B"
                                        LineHeight="28"
                                        Text="{Binding}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Grid.Row="1" Margin="0,10,0,0">

                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Opacity="0.4"
                                Orientation="Horizontal">
                                <TextBlock
                                    FontFamily="Ink Free"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="#333"
                                    Text="#BetterLyrics">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="-2" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Opacity="0.6"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,5,0"
                                    FontFamily="Ink Free"
                                    FontSize="14"
                                    Foreground="#555"
                                    Text="{x:Bind Title}" />
                                <TextBlock
                                    Margin="0,0,5,0"
                                    FontFamily="Ink Free"
                                    FontSize="14"
                                    Foreground="#555"
                                    Text="-" />
                                <TextBlock
                                    FontFamily="Ink Free"
                                    FontSize="14"
                                    Foreground="#555"
                                    Text="{x:Bind Artist}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StyleTicket" x:DataType="models:LyricsShareCardData">
            <Grid
                Width="450"
                MinHeight="600"
                Background="Transparent">
                <Grid
                    Margin="20"
                    Background="#FFF8F0"
                    CornerRadius="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Shadow>
                        <ThemeShadow />
                    </Grid.Shadow>

                    <Grid Grid.Row="0" Margin="24,24,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="4">
                            <Image
                                Width="80"
                                Height="80"
                                Source="{x:Bind CoverImage}" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                CharacterSpacing="2"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#FF5555"
                                Text="ADMIT ONE" />
                            <TextBlock
                                FontSize="20"
                                FontWeight="Black"
                                Foreground="#333"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="14"
                                Foreground="#777"
                                Text="{x:Bind Artist}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl
                        Grid.Row="1"
                        Margin="24,30"
                        ItemsSource="{x:Bind SelectedLyrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontFamily="Courier New"
                                    FontSize="18"
                                    Foreground="#444"
                                    LineHeight="28"
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="2" Height="20">
                        <Line
                            Margin="10,0"
                            VerticalAlignment="Center"
                            Stroke="#CCC"
                            StrokeDashArray="4,2"
                            StrokeThickness="2"
                            X1="0"
                            X2="410"
                            Y1="10"
                            Y2="10" />
                        <Ellipse
                            Width="20"
                            Height="20"
                            Margin="-10,0,0,0"
                            HorizontalAlignment="Left"
                            Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
                        <Ellipse
                            Width="20"
                            Height="20"
                            Margin="0,0,-10,0"
                            HorizontalAlignment="Right"
                            Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
                    </Grid>

                    <Grid Grid.Row="3" Padding="24,10,24,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="10"
                                Foreground="#999"
                                Text="DATE" />
                            <TextBlock
                                FontFamily="Courier New"
                                FontSize="14"
                                Foreground="#333"
                                Text="2026.02.14" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="10"
                                Foreground="#999"
                                Text="LOCATION" />
                            <TextBlock
                                FontFamily="Courier New"
                                FontSize="14"
                                Foreground="#333"
                                Text="BetterLyrics" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Opacity="0.8">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#333"
                                Text="||| |||| | ||||" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StyleMagazine" x:DataType="models:LyricsShareCardData">
            <Grid
                Width="450"
                MinHeight="600"
                Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="300" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Image
                    VerticalAlignment="Center"
                    Source="{x:Bind CoverImage}"
                    Stretch="UniformToFill" />

                <TextBlock
                    Margin="-5,0,0,-20"
                    VerticalAlignment="Bottom"
                    FontSize="80"
                    FontWeight="Bold"
                    Foreground="White"
                    Opacity="0.2"
                    Text="LYRICS" />

                <Grid Grid.Row="1" Padding="30,40,30,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock
                            FontFamily="Georgia"
                            FontSize="32"
                            FontWeight="Black"
                            Foreground="Black"
                            LineHeight="36"
                            Text="{x:Bind Title}"
                            TextWrapping="Wrap" />

                        <Border
                            Width="40"
                            Height="4"
                            Margin="0,15,0,25"
                            HorizontalAlignment="Left"
                            Background="Black" />
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind SelectedLyrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontFamily="Georgia"
                                    FontSize="18"
                                    Foreground="#333"
                                    LineHeight="30"
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel
                        Grid.Row="2"
                        Margin="0,40,0,0"
                        Opacity="0.5"
                        Orientation="Horizontal">
                        <TextBlock
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Black"
                            Text="BetterLyrics" />
                        <TextBlock
                            FontSize="12"
                            Foreground="Black"
                            Text=" • ISSUE 01" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StyleSwiss" x:DataType="models:LyricsShareCardData">
            <Grid
                Width="450"
                MinHeight="600"
                Background="#F0F0F0">
                <Grid
                    Margin="20"
                    BorderBrush="Black"
                    BorderThickness="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Padding="20"
                        Background="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                FontSize="48"
                                FontWeight="Black"
                                Foreground="Black"
                                LineHeight="40"
                                Text="{x:Bind Title}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,10,0,0"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="Black"
                                Text="{x:Bind Artist}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,-20,-10,0"
                            VerticalAlignment="Top"
                            FontSize="80"
                            FontWeight="Bold"
                            Foreground="#EEE"
                            Text="01" />
                    </Grid>

                    <Rectangle
                        Grid.Row="1"
                        Height="4"
                        Fill="Black" />

                    <Grid Grid.Row="2" Background="{x:Bind OverlayBrush}">
                        <Rectangle Fill="White" Opacity="0.8" />

                        <ItemsControl Margin="20,30" ItemsSource="{x:Bind SelectedLyrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="0,0,0,16"
                                        FontFamily="Arial"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="Black"
                                        LineHeight="28"
                                        Text="{Binding}"
                                        TextAlignment="Left"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <Grid
                        Grid.Row="3"
                        Padding="20,15"
                        Background="Black"
                        BorderBrush="Black"
                        BorderThickness="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border
                                Width="40"
                                Height="40"
                                Background="White"
                                CornerRadius="20">
                                <Image Source="{x:Bind CoverImage}" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="NOW PLAYING" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Opacity="0.5"
                            Text="BetterLyrics" />
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StyleRetroQQ" x:DataType="models:LyricsShareCardData">
            <Grid
                x:Name="QQCardRoot"
                Width="450"
                MinHeight="600"
                Background="#D6E9F8">
                <Border BorderBrush="#08519C" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="36" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#00309C" />
                                    <GradientStop Offset="1" Color="#5CA7F6" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image
                                Width="16"
                                Height="16"
                                Margin="4,0"
                                Source="{x:Bind CoverImage}" />

                            <StackPanel
                                Grid.Column="1"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    FontFamily="SimSun"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{x:Bind Artist}" />
                                <TextBlock
                                    FontFamily="SimSun"
                                    FontSize="12"
                                    Foreground="White"
                                    Text=" - 发送消息" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Margin="0,2,2,0"
                                Orientation="Horizontal">
                                <Border
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,2,0"
                                    Background="#20FFFFFF"
                                    BorderBrush="White"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Marlett"
                                        FontSize="10"
                                        Foreground="White"
                                        Text="0" />
                                </Border>
                                <Border
                                    Width="16"
                                    Height="16"
                                    Background="#D54739"
                                    BorderBrush="White"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Marlett"
                                        FontSize="10"
                                        Foreground="White"
                                        Text="r" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="3,2,3,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,2,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="80" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Padding="4"
                                    Background="#F4F8FB"
                                    BorderBrush="#8CA0B4"
                                    BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="32"
                                            Height="32"
                                            Background="White"
                                            BorderBrush="#8CA0B4"
                                            BorderThickness="1">
                                            <Image Source="{x:Bind CoverImage}" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    FontFamily="SimSun"
                                                    FontSize="12"
                                                    Foreground="Black"
                                                    Text="QQ#: " />
                                                <TextBlock
                                                    FontFamily="SimSun"
                                                    FontSize="12"
                                                    Foreground="Black"
                                                    Text="88888888" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    FontFamily="SimSun"
                                                    FontSize="12"
                                                    Foreground="Black"
                                                    Text="昵称: " />
                                                <TextBlock
                                                    FontFamily="SimSun"
                                                    FontSize="12"
                                                    Foreground="Black"
                                                    Text="{x:Bind Title}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border
                                    Grid.Row="1"
                                    Background="White"
                                    BorderBrush="#8CA0B4"
                                    BorderThickness="0,0,0,1">
                                    <ItemsControl Padding="4" ItemsSource="{x:Bind SelectedLyrics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                                                        <TextBlock
                                                            FontFamily="SimSun"
                                                            FontSize="12"
                                                            Foreground="#0000FF"
                                                            Text="{Binding DataContext.Artist, ElementName=QQCardRoot}" />
                                                        <TextBlock
                                                            FontFamily="SimSun"
                                                            FontSize="12"
                                                            Foreground="#008000"
                                                            Text=" 15:30:44" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        FontFamily="SimSun"
